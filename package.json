{
	"name": "web-ng",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"fmt": "biome format . --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "astro check",
		"theme": "deno run --allow-read scripts/generate-theme.ts",
		"theme:check": "deno run --allow-read scripts/generate-theme.ts --check",
		"check": "biome check . && astro check && deno run --allow-read scripts/generate-theme.ts --check"
	},
	"dependencies": {
		"@astrojs/vue": "^7.0.3",
		"@iconify-json/lucide": "^1.2.138",
		"astro": "^7.3.5",
		"astro-icon": "^1.2.0",
		"browserslist": "^4.29.3",
		"lightningcss": "^1.33.0",
		"sharp": "^0.35.5",
		"typescript": "^6.0.3",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15"
	}
}
