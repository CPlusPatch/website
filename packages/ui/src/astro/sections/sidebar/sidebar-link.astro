---
import type { HTMLAttributes } from "astro/types";

/**
 * One entry in a <SidebarGroup>. The label goes in the default slot.
 * Give it a `section` and it lights up while that element is the one being
 * read (see the script in Sidebar).
 */
interface Props extends HTMLAttributes<"a"> {
    href: string;
    /** Marks the link as the current page. */
    current?: boolean;
    /** Id of the element on this page the link tracks while scrolling. */
    section?: string;
    /** Short trailing detail, such as a count. */
    meta?: string | number;
}

const {
    href,
    current = false,
    section,
    meta,
    class: className,
    ...rest
} = Astro.props;
---

<li class="sidebar-link">
    <a
        class:list={["sidebar-link__anchor", "text-ui", className]}
        href={href}
        aria-current={current ? "page" : undefined}
        data-section={section}
        {...rest}
    >
        <span class="sidebar-link__label"><slot /></span>
        {meta !== undefined && (
            <span class="sidebar-link__meta text-meta">{meta}</span>
        )}
    </a>
</li>
