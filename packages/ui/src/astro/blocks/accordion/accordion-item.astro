---
import type { HTMLAttributes } from "astro/types";
import Icon from "../../icon.astro";

/**
 * One collapsible section of an <Accordion>, as a native <details>, so it
 * opens without JS. Items sharing a `name` close each other, also natively.
 */
interface Props extends HTMLAttributes<"details"> {
    /** The always-visible heading that toggles the item. */
    summary: string;
}

const { summary, class: className, ...rest } = Astro.props;
---

<details class:list={["accordion-item", className]} {...rest}>
    <summary class="text-body-strong">
        {summary}
        <Icon name="lucide:chevron-down" aria-hidden="true" />
    </summary>
    <div class="accordion-item__body">
        <div class="accordion-item__content">
            <slot />
        </div>
    </div>
</details>
