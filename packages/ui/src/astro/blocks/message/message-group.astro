---
import type { HTMLAttributes } from "astro/types";

/**
 * Consecutive <Message>s from one sender, stacked close together. Give each
 * the same author and avatar: only the first shows the name, and only one
 * the avatar -- the last, level with its bubble, or for ghost messages the
 * first, beside the name. The rest keep its space so the content lines up.
 */
type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class:list={["message-group", className]} {...rest}>
    <slot />
</div>
