---
import type { HTMLAttributes } from "astro/types";

/**
 * Columns of items with uneven heights, like quotes or notes. Each item
 * keeps its own height, rather than being stretched to its row's tallest as
 * in a grid, and any number of them pack in. Items read down each column,
 * then across.
 */
interface Props extends HTMLAttributes<"div"> {
    /** Narrowest a column gets before there are fewer of them. */
    min?: string;
    /** Most columns there will ever be. */
    columns?: number;
}

const {
    min = "18rem",
    columns = 3,
    class: className,
    style,
    ...rest
} = Astro.props;

// Set inline, which is what define:vars did, so the stylesheet can be plain CSS.
const vars = { "--masonry-min": min, "--masonry-columns": columns };
const merged =
    typeof style === "string"
        ? `--masonry-min:${min};--masonry-columns:${columns};${style}`
        : { ...vars, ...style };
---

<div class:list={["masonry", className]} style={merged} {...rest}>
    <slot />
</div>
