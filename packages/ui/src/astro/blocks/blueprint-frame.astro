---
import type { HTMLAttributes } from "astro/types";

/**
 * Sets whatever is in the default slot on a dashed sheet, offset behind it.
 * The content brings its own surface; the frame only draws behind it.
 */
type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class:list={["blueprint-frame", className]} {...rest}>
    <slot />
</div>
