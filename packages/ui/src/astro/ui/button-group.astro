---
import type { HTMLAttributes } from "astro/types";

/**
 * Fuses adjacent <Button>s into one segmented control: shared borders, and
 * only the outer corners keep the radius.
 */
interface Props extends HTMLAttributes<"div"> {
    /** Names the group for screen readers. */
    label: string;
}

const { label, class: className, ...rest } = Astro.props;
---

{/* biome-ignore lint/a11y/useSemanticElements: <fieldset> brings default box styling that would need undoing */}
<div
    role="group"
    aria-label={label}
    {...rest}
    class:list={["button-group", className]}
>
    <slot />
</div>
