---
import type { HTMLAttributes } from "astro/types";
import {
    controlRowClasses,
    controlRowLabelClasses,
} from "../../components/control-row.ts";

/**
 * A setting in an inspector: the label at the start of a line and a readout
 * at its end, the control (the default slot) below. It adds no behaviour:
 * point `for` at the control's id, or use `labelId` for the control's
 * `aria-labelledby`.
 */
interface Props extends HTMLAttributes<"div"> {
    label: string;
    /** The control's current value, as text. */
    value?: string;
    /** Shown in place of `value`, in the muted colour. */
    note?: string;
    /** Id of the note, for the control's `aria-describedby`. */
    noteId?: string;
    /** The id of the control. The label is then a <label>, else a <span>. */
    for?: string;
    /** Id of the label <span>, for the control's `aria-labelledby`. */
    labelId?: string;
    /** Dims the control, not the header. Disable the control itself too. */
    disabled?: boolean;
    /** Sets the label in the mono face, for names from code like a prop. */
    mono?: boolean;
}

const {
    label,
    value,
    note,
    noteId,
    for: controlId,
    labelId,
    disabled = false,
    mono = false,
    class: className,
    ...rest
} = Astro.props;

const labelClass = controlRowLabelClasses(mono);
---

<div class:list={controlRowClasses({ disabled, class: className })} {...rest}>
    <div class="control-row__header">
        {controlId ? (
            <label class:list={labelClass} for={controlId}>
                {label}
            </label>
        ) : (
            <span class:list={labelClass} id={labelId}>
                {label}
            </span>
        )}
        {note ? (
            <span class="control-row__note" id={noteId}>
                {note}
            </span>
        ) : value ? (
            // The control says its own value.
            <span class="control-row__value" aria-hidden="true">
                {value}
            </span>
        ) : null}
    </div>
    <div class="control-row__control"><slot /></div>
</div>
