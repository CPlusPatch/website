---
import type { HTMLAttributes } from "astro/types";
import {
    type ButtonSize,
    type ButtonTone,
    type ButtonVariant,
    buttonClasses,
    isAnchor as linkRequested,
} from "../../components/button.ts";

export type { ButtonSize, ButtonTone, ButtonVariant };

/**
 * Renders an <a> when `as="a"` or an `href` is given, otherwise a <button>.
 * Choose the element by what the control does (navigate vs. act); `variant`
 * only changes how it looks, so a `link`-variant button is still a <button>.
 */
type Props = Omit<HTMLAttributes<"button">, "type"> &
    Omit<HTMLAttributes<"a">, "type"> & {
        /** Force the element. Defaults to "a" when `href` is set, else "button". */
        as?: "button" | "a";
        type?: "button" | "submit" | "reset";
        variant?: ButtonVariant;
        tone?: ButtonTone;
        size?: ButtonSize;
        /**
         * Shows a spinner in place of the content, at the same size. Sets
         * aria-busy and aria-disabled; the caller still ignores clicks while it is set.
         */
        busy?: boolean;
    };

const {
    as,
    type,
    variant = "solid",
    tone = "primary",
    size = "default",
    busy = false,
    class: className,
    ...rest
} = Astro.props;

const isAnchor = linkRequested(as, rest.href);

const classes = buttonClasses({ variant, tone, size, class: className });
const busyAttributes = busy
    ? ({ "aria-busy": "true", "aria-disabled": "true" } as const)
    : {};
---

{isAnchor ? (
    <a class:list={classes} {...rest} {...busyAttributes}>
        <slot />
    </a>
) : (
    <button
        type={type ?? "button"}
        class:list={classes}
        {...rest}
        {...busyAttributes}
    >
        <slot />
    </button>
)}
