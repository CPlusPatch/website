---
import type { HTMLAttributes } from "astro/types";
import {
    type AlertVariant,
    alertClasses,
    alertPrefix,
} from "../../components/alert.ts";
import Icon from "../icon.astro";

export type { AlertVariant };

interface Props extends HTMLAttributes<"div"> {
    icon?: string;
    variant?: AlertVariant;
    /**
     * Announce the alert to assistive tech when it appears. Use "assertive"
     * only for content that must interrupt (like an error on submit).
     */
    live?: "off" | "polite" | "assertive";
}

const {
    icon,
    variant = "default",
    live = "off",
    class: className,
    ...rest
} = Astro.props;

const prefix = alertPrefix(variant);
---

<div
    class:list={alertClasses({ variant, icon, class: className })}
    role={live === "off" ? undefined : "status"}
    aria-live={live === "off" ? undefined : live}
    data-snap
    {...rest}
>
    {icon && <Icon name={icon} class="icon" aria-hidden="true" />}
    <div class="content">
        {prefix && <span class="visually-hidden">{prefix}</span>}
        <slot />
    </div>
</div>
