---
import type { HTMLAttributes } from "astro/types";
import { cardClasses } from "../../components/card.ts";
import type { Tone } from "../../lib/tone.ts";

interface Props extends HTMLAttributes<"div"> {
    tone?: Tone;
    /** Draw the tone's accent as a rule along the top edge. */
    rule?: boolean;
}

const {
    tone = "primary",
    rule = false,
    class: className,
    ...rest
} = Astro.props;
---

<div
    class:list={cardClasses({ tone, rule, class: className })}
    data-snap
    {...rest}
>
    <slot />
</div>
