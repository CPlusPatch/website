---
import type { HTMLAttributes } from "astro/types";
import {
    type SegmentedOption,
    type SegmentedSize,
    type SegmentedVariant,
    segmentedClasses,
} from "../../components/segmented-control.ts";
import Icon from "../icon.astro";

export type { SegmentedOption };

/**
 * A row of mutually exclusive options, as plain radios in a fieldset, so it
 * submits with a form and can drive CSS through :has() without JS. Give
 * each control its own `name`.
 */
interface Props extends Omit<HTMLAttributes<"fieldset">, "name"> {
    name: string;
    /** Accessible name for the group. */
    label: string;
    options: SegmentedOption[];
    /** The initially checked option, if any. */
    value?: string;
    size?: SegmentedSize;
    /** `subtle` marks the checked option with a thin neutral bar, not the accent. */
    variant?: SegmentedVariant;
    /** Stretch to the container, the options sharing the width. */
    fill?: boolean;
}

const {
    name,
    label,
    options,
    value,
    size = "default",
    variant = "solid",
    fill = false,
    class: className,
    ...rest
} = Astro.props;
---

<fieldset
    class:list={segmentedClasses({ size, variant, fill, class: className })}
    {...rest}
>
    <legend class="visually-hidden">{label}</legend>
    <div class="segmented__options">
        {options.map((option) => (
            <label
                class="segmented__option"
                title={
                    option.icon && !option.showLabel ? option.label : undefined
                }
            >
                <input
                    class="visually-hidden"
                    type="radio"
                    name={name}
                    value={option.value}
                    checked={option.value === value}
                >
                {option.icon && <Icon name={option.icon} aria-hidden="true" />}
                {option.icon && !option.showLabel ? (
                    <span class="visually-hidden">{option.label}</span>
                ) : (
                    <span class="segmented__text">{option.label}</span>
                )}
            </label>
        ))}
    </div>
</fieldset>

<script>
import { initSegmentedControls } from "../../behaviours/segmented-control.ts";

initSegmentedControls();
</script>
