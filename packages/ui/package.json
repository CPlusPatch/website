{
    "name": "@cpluspatch/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./behaviours": "./src/behaviours/index.ts",
        "./behaviours/*": "./src/behaviours/*",
        "./styles.css": "./src/styles.css",
        "./styles/*": "./src/styles/*",
        "./lib/*": "./src/lib/*",
        "./components.css": "./src/components.css",
        "./components/*.css": "./src/components/*.css",
        "./components/*.ts": "./src/components/*.ts",
        "./astro/*": "./src/astro/*"
    },
    "peerDependencies": {
        "astro": ">=7",
        "astro-icon": "^1.2.0",
        "shiki": ">=4"
    },
    "peerDependenciesMeta": {
        "astro": {
            "optional": true
        },
        "astro-icon": {
            "optional": true
        },
        "shiki": {
            "optional": true
        }
    }
}
