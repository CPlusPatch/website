{
    "name": "@cpluspatch/ui",
    "version": "0.0.0",
    "license": "LGPL-3.0-only",
    "author": "Jesse Wierzbinski <contact@cpluspatch.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CPlusPatch/website.git",
        "directory": "packages/ui"
    },
    "homepage": "https://cpluspatch.com/gallery/",
    "bugs": {
        "url": "https://github.com/CPlusPatch/website/issues"
    },
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./behaviours": "./src/behaviours/index.ts",
        "./behaviours/*": "./src/behaviours/*",
        "./styles.css": "./src/styles.css",
        "./styles/*": "./src/styles/*",
        "./lib/*": "./src/lib/*",
        "./components.css": "./src/components.css",
        "./components/*.css": "./src/components/*.css",
        "./components/*.ts": "./src/components/*.ts",
        "./astro/*": "./src/astro/*"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "README.md",
        "COPYING",
        "COPYING.LESSER"
    ],
    "peerDependencies": {
        "astro": ">=7",
        "astro-icon": "^1.2.0",
        "shiki": ">=4"
    },
    "peerDependenciesMeta": {
        "astro": {
            "optional": true
        },
        "astro-icon": {
            "optional": true
        },
        "shiki": {
            "optional": true
        }
    }
}
