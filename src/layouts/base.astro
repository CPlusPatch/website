---
import "../styles/index.css";

import { Font } from "astro:assets";
import Crosshair from "../components/effects/crosshair.astro";
import Scanlines from "../components/effects/scanlines.astro";
import { site } from "../site.ts";

interface Props {
    title: string;
    description?: string;
    /** Keep the page out of search results (used by the component gallery). */
    noindex?: boolean;
    /**
     * Whether the page has a canonical URL of its own. Turn off for pages
     * served at many addresses, like the 404.
     */
    canonical?: boolean;
}

const {
    title,
    description,
    noindex = false,
    canonical: hasCanonical = true,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" href="/favicon.ico">
        <meta name="generator" content={Astro.generator}>

        <title>{pageTitle}</title>
        {description && <meta name="description" content={description} />}
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        {hasCanonical && <link rel="canonical" href={canonical.href} />}

        <meta property="og:type" content="website">
        <meta property="og:site_name" content={site.name}>
        <meta property="og:title" content={pageTitle}>
        {description && (
            <meta property="og:description" content={description} />
        )}
        {hasCanonical && <meta property="og:url" content={canonical.href} />}
        {/* No og:image yet, so the small card; use summary_large_image once one exists. */}
        <meta name="twitter:card" content="summary">

        {/*
         * Body text font, so fetch it with the HTML instead of after the CSS.
         * Latin only: the latin-ext file is larger and rarely needed.
         */}
        <Font cssVariable="--font-inter" preload={[{ subset: "latin" }]} />
        <Font cssVariable="--font-jetbrains-mono" />
        {/*
         * Ocean theme fonts. Only @font-face rules, with no preload: browsers
         * download a face the first time text uses it, so these cost nothing
         * until the theme is on.
         */}
        <Font cssVariable="--font-nunito" />
        <Font cssVariable="--font-fira-code" />
    </head>
    <body>
        <Scanlines />
        <Crosshair />
        <a class="skip-link" href="#main">Skip to content</a>
        <slot />
    </body>
</html>

<style>
body {
    container-type: inline-size;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-base);
    font-optical-sizing: auto;
    font-size: var(--font-size-base);
    line-height: var(--line-height);
    color: var(--color-text);
    background-color: var(--color-bg);
    background-image:
        linear-gradient(var(--color-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
    -webkit-font-smoothing: antialiased;
}

.skip-link {
    position: absolute;
    left: var(--space-md);
    top: var(--space-md);
    /* Above the fx overlays, so the scanlines never dim it */
    z-index: var(--z-skip-link);
    padding: var(--space-sm) var(--space-md);
    color: var(--color-on-accent);
    background-color: var(--color-primary);
    text-decoration: none;
    translate: 0 -200%;

    &:focus-visible {
        translate: 0 0;
    }
}
</style>
