---
import "../styles/index.css";

import Jesse from "../components/effects/jesse.astro";
import Scanlines from "../components/effects/scanlines.astro";
import Head, { type Props as HeadProps } from "../components/head.astro";

interface Props extends HeadProps {
    /** The skip link's target id, or false for a page with nothing to skip. */
    skipTo?: string | false;
}

const { skipTo = "main", ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <Head {...head} />
        <slot name="head" />
    </head>
    <body>
        <Scanlines />
        <Jesse />
        {skipTo && (
            <a class="skip-link" href={`#${skipTo}`}>
                Skip to content
            </a>
        )}
        <slot />
    </body>
</html>

<style>
body {
    container-type: inline-size;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font: var(--type-body);
    font-optical-sizing: auto;
    color: var(--color-text);

    /* Fx layers behind content (z-index: var(--z-backdrop)) stack in body. */
    position: relative;
    isolation: isolate;
    background-color: var(--color-bg);
    -webkit-font-smoothing: antialiased;

    .skip-link {
        position: absolute;
        left: var(--space-md);
        top: var(--space-md);
        /* Above the fx overlays, so the scanlines never dim it */
        z-index: var(--z-skip-link);
        padding: var(--space-sm) var(--space-md);
        color: var(--color-on-accent);
        background-color: var(--color-primary);
        text-decoration: none;
        translate: 0 -200%;

        &:focus-visible {
            translate: 0 0;
        }
    }
}
</style>
