---
import Sidebar from "@cpluspatch/ui/astro/sections/sidebar/sidebar.astro";
import SidebarLayout from "@cpluspatch/ui/astro/sections/sidebar/sidebar-layout.astro";
import Layout from "../layouts/base.astro";
import GalleryMenu from "./gallery-menu.astro";
import GalleryNav from "./gallery-nav.astro";
import SchemeSwitch from "./scheme-switch.astro";

/**
 * Every gallery page's frame: a sticky bar (the gallery's name, where you
 * are, and the light and dark switch), and a way to every component: a
 * sidebar that gives way to a menu in the bar on narrow screens, or just
 * the menu.
 * A `bare` page has neither: it fills the viewport and brings its own bar.
 */
interface Props {
    /** The page's own title, before " · Component gallery". */
    title?: string;
    description: string;
    /** Id of the component whose page this is, for the sidebar and menu. */
    current?: string;
    /** A sidebar of every component, beside the page. */
    sidebar?: boolean;
    /**
     * The bar's Components menu at every width, for a page without the
     * sidebar. With the sidebar, the menu shows only when it's hidden. Off
     * for the index, which is a list of the components itself.
     */
    menu?: boolean;
    /**
     * No bar, width cap or page padding: the page fills the viewport and
     * carries its own bar, with the Components menu (gallery-menu.astro) and
     * the light and dark switch (scheme-switch.astro). The skip link goes to
     * its `#stage`. Ignores `sidebar` and `menu`.
     */
    bare?: boolean;
}

const {
    title,
    description,
    current,
    sidebar = true,
    menu = false,
    bare = false,
} = Astro.props;

// A name for <main>: the bench's frame has one too, and landmarks must differ.
const main = title ?? "Component gallery";
---

<Layout
    title={title ? `${title} · Component gallery` : "Component gallery"}
    {description}
    noindex
    skipTo={bare ? "stage" : "main"}
    savedDisplay={false}
>
    {/* The page's own scheme, before first paint. */}
    <script slot="head" is:inline>
    try {
        const scheme = sessionStorage.getItem("gallery-scheme");
        if (scheme === "light" || scheme === "dark") {
            document.documentElement.dataset.scheme = scheme;
        }
    } catch {}
    </script>
    <div class:list={["gallery", { "gallery--bare": bare }]} id="top">
        {bare ? (
            <main id="main" class="gallery__main" aria-label={main}>
                <slot />
            </main>
        ) : (
            <>
                <header class="gallery__bar">
                    <p class="gallery__title text-title">
                        <a href="/gallery/">Component gallery</a>
                    </p>
                    <span class="gallery__spacer"></span>
                    {(sidebar || menu) && (
                        /* The sidebar's links, for when there is no room for it. */
                        <GalleryMenu
                            {current}
                            class={
                                sidebar
                                    ? "gallery__menu"
                                    : "gallery__menu gallery__menu--always"
                            }
                        />
                    )}
                    <SchemeSwitch />
                </header>

                {sidebar ? (
                    <SidebarLayout>
                        <Sidebar
                            slot="sidebar"
                            class="gallery__sidebar"
                            label="Components"
                        >
                            <GalleryNav {current} />
                        </Sidebar>
                        <main id="main" class="gallery__main" aria-label={main}>
                            <slot />
                        </main>
                    </SidebarLayout>
                ) : (
                    <main id="main" class="gallery__main" aria-label={main}>
                        <slot />
                    </main>
                )}
            </>
        )}
    </div>
</Layout>

<script>
// The page-wide easter eggs the dialogue stories run.
import "./dialogue-actions.ts";
</script>

<style>
:global(html):has(.gallery) {
    --gallery-sticky: var(--header-height);
}

.gallery {
    width: min(100% - 2 * var(--space-md), 90rem);
    margin-inline: auto;

    /* Focus and in-page jumps stop clear of what sticks to the top. */
    :global(html):has(&) {
        scroll-padding-top: calc(var(--gallery-sticky) + var(--space-md));
    }

    /* Sticky, so the settings stay in reach; the sidebar sticks just below it. */
    .gallery__bar {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        display: flex;
        align-items: center;
        gap: var(--space-sm) var(--space-md);
        /* A fixed height, which the offsets above and below rely on. */
        height: var(--header-height);
        margin-bottom: var(--space-md);
        /* Bleed to the viewport edges, so content never shows beside it. */
        padding-inline: var(--space-md);
        margin-inline: calc(var(--space-md) * -1);
        background-color: color-mix(in oklab, var(--color-bg) 85%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    .gallery__title {
        flex-shrink: 0;
        margin: 0;
        white-space: nowrap;

        a {
            color: inherit;
            text-decoration: none;

            /* Not the global link hover's highlighter fill. */
            &:hover {
                color: inherit;
                background-color: transparent;
            }
        }
    }

    .gallery__spacer {
        flex: 1;
    }

    .gallery__sidebar {
        --sidebar-top: calc(var(--header-height) + var(--space-md));
    }

    .gallery__main {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        min-width: 0;
        /*
         * The page's bottom padding lives here, inside the sidebar's column:
         * outside it, the column would end short of the page and push the
         * sticky sidebar up at the bottom.
         */
        padding-bottom: var(--space-xl);
    }

    &.gallery--bare {
        width: auto;
        margin-inline: 0;

        .gallery__main {
            gap: 0;
            padding-bottom: 0;
        }
    }

    /*
     * Narrow: the sidebar gives way to the Components menu in the bar, so
     * the links stay in reach while scrolling. The two queries meet at the
     * same width: the layout is the page less its 2 × space-md gutter.
     */
    .gallery__menu {
        display: none;
    }

    /* With no sidebar, the menu is the only way to the other components. */
    .gallery__menu--always {
        display: inline-block;
    }

    @container (width < 58rem) {
        .gallery__menu {
            display: inline-block;
        }
    }

    @container sidebar-layout (width < 56rem) {
        .gallery__sidebar {
            display: none;
        }
    }

    @container (width < 30rem) {
        .gallery__bar {
            gap: var(--space-sm);
        }
    }
}
</style>
