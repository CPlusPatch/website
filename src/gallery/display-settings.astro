---
import type { ComponentProps } from "astro/types";
import DisplayMenu, {
    type DisplayEffect,
} from "../components/sections/display/display-menu.astro";
import DisplayRow from "../components/sections/display/display-row.astro";
import SegmentedControl from "../components/ui/segmented-control.astro";
import { PREVIEW_WIDTH_NAME, previewWidthOptions } from "./widths.ts";

/**
 * The site's Display menu, with the gallery's own setting added: the default
 * preview width. Like the rest of the menu it needs no JS, but it isn't kept
 * across pages.
 */
type Props = Pick<ComponentProps<typeof DisplayMenu>, "collapseBelow">;

// Every effect, where the front page has only some.
const EFFECTS: DisplayEffect[] = [
    { name: "crosshair", label: "Crosshair", key: "c", fine: true },
    { name: "scanlines", label: "Scanlines", key: "s" },
    { name: "signal", label: "Signal" },
    { name: "lift-shadow", label: "Lift shadow" },
];
---

<DisplayMenu
    id="display-settings"
    effects={EFFECTS}
    collapseBelow={Astro.props.collapseBelow}
>
    <DisplayRow label="Preview width">
        <SegmentedControl
            name={PREVIEW_WIDTH_NAME}
            label="Default preview width"
            options={previewWidthOptions()}
            value="desktop"
            size="sm"
            variant="subtle"
        />
    </DisplayRow>
</DisplayMenu>

<script>
/*
 * Theme and overrides reflow the whole page, so what the reader was looking
 * at moves. Keep track of the element under the sticky bar as they scroll
 * (a change's reflow can't be measured after the fact, as reading layout
 * flushes it), and put it back after each change. Fonts a theme loads late
 * reflow again, so repeat once they land.
 */
const settings = document.getElementById("display-settings");
const bar = document.querySelector(".gallery__bar");
const main = document.querySelector(".gallery__main");

let anchor: Element | null = null;
let anchorTop = 0;
let pending = false;

const remember = () => {
    pending = false;
    if (!bar || !main) return;
    // elementsFromPoint, as the open dropdown's panel can be on top of the page.
    const y = bar.getBoundingClientRect().bottom + 8;
    const hit = document
        .elementsFromPoint(window.innerWidth / 2, y)
        .find((el) => main.contains(el));
    if (!hit) return;
    anchor = hit;
    anchorTop = hit.getBoundingClientRect().top;
};

const schedule = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(remember);
};

remember();
window.addEventListener("scroll", schedule, { passive: true });
window.addEventListener("resize", schedule);

settings?.addEventListener("change", () => {
    const target = anchor;
    const top = anchorTop;
    if (!target?.isConnected) return;

    const restore = () => {
        const drift = target.getBoundingClientRect().top - top;
        if (drift) window.scrollBy({ top: drift, behavior: "instant" });
    };

    restore();
    requestAnimationFrame(restore);
    document.fonts.addEventListener("loadingdone", restore, { once: true });
});
</script>
