---
import DisplayMenu, {
    type DisplayEffect,
} from "@cpluspatch/ui/astro/sections/display/display-menu.astro";
import DisplayRow from "@cpluspatch/ui/astro/sections/display/display-row.astro";
import SegmentedControl from "@cpluspatch/ui/astro/ui/segmented-control.astro";
import type { ComponentProps } from "astro/types";

/**
 * The site's Display menu, with every page effect, and on a component
 * page, a way to see its sections in other schemes and themes (compare.ts).
 * The gallery's other settings (preview width, stage) are in each
 * component page's toolbar.
 */
type Props = Pick<ComponentProps<typeof DisplayMenu>, "collapseBelow">;

// Every effect, where the front page has only some.
const EFFECTS: DisplayEffect[] = [
    { name: "scanlines", label: "Scanlines", key: "s" },
];
---

<DisplayMenu
    id="display-settings"
    effects={EFFECTS}
    collapseBelow={Astro.props.collapseBelow}
>
    {/* Not kept between pages, and hidden until compare.ts can size frames. */}
    <DisplayRow class="gallery-compare" label="Compare" hidden>
        <SegmentedControl
            name="gallery-compare"
            label="Compare"
            options={[
                { value: "page", label: "Off" },
                { value: "schemes", label: "Light + dark" },
                { value: "themes", label: "Themes" },
            ]}
            value="page"
            size="sm"
            variant="subtle"
        />
    </DisplayRow>
</DisplayMenu>

<script>
import { initCompare } from "./compare.ts";

const compare = document.querySelector<HTMLElement>(".gallery-compare");
if (compare) initCompare(compare);
</script>

<script>
/*
 * Theme, overrides and preview width reflow the whole page, so what the reader was looking
 * at moves. Keep track of the element under the sticky bar as they scroll
 * (a change's reflow can't be measured after the fact, as reading layout
 * flushes it), and put it back after each change. Fonts a theme loads late
 * reflow again, so repeat once they land.
 */
const settings = document.getElementById("display-settings");
const bar = document.querySelector(".gallery__bar");
const main = document.querySelector(".gallery__main");
// A component page's toolbar: its width reflows too, and it can stick under the bar.
const toolbar = document.querySelector(".gallery-toolbar");

let anchor: Element | null = null;
let anchorTop = 0;
let pending = false;

const remember = () => {
    pending = false;
    if (!bar || !main) return;
    // Below the toolbar while it is stuck there, as it never moves.
    const top = Math.max(
        bar.getBoundingClientRect().bottom,
        toolbar && getComputedStyle(toolbar).position === "sticky"
            ? toolbar.getBoundingClientRect().bottom
            : 0,
    );
    // elementsFromPoint, as the open dropdown's panel can be on top of the page.
    const hit = document
        .elementsFromPoint(window.innerWidth / 2, top + 8)
        .find((el) => main.contains(el) && !toolbar?.contains(el));
    if (!hit) return;
    anchor = hit;
    anchorTop = hit.getBoundingClientRect().top;
};

const schedule = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(remember);
};

remember();
window.addEventListener("scroll", schedule, { passive: true });
window.addEventListener("resize", schedule);

const keepPlace = () => {
    const target = anchor;
    const top = anchorTop;
    if (!target?.isConnected) return;

    const restore = () => {
        const drift = target.getBoundingClientRect().top - top;
        if (drift) window.scrollBy({ top: drift, behavior: "instant" });
    };

    restore();
    requestAnimationFrame(restore);
    document.fonts.addEventListener("loadingdone", restore, { once: true });
};

settings?.addEventListener("change", keepPlace);
toolbar?.addEventListener("change", keepPlace);
</script>

<style>
:global(.gallery-compare[hidden]) {
    display: none;
}
</style>
