---
import Dropdown from "../components/ui/dropdown.astro";
import SegmentedControl from "../components/ui/segmented-control.astro";
import Select from "../components/ui/select.astro";
import Toggle from "../components/ui/toggle.astro";
import { OVERRIDES, overrideOptions } from "./overrides.ts";
import { PREVIEW_WIDTH_NAME, previewWidthOptions } from "./widths.ts";

/**
 * The gallery's page-wide settings: theme, default preview width,
 * spacing, radius and font size overrides, and effects. None of it needs JS -- each control is read through :has()
 * wherever it lives, so it keeps working while the dropdown is closed.
 */

// Each value other than "default" needs a matching stylesheet in
// src/styles/themes/, which switches on while its option is selected.
const THEMES = [
    { value: "default", label: "Default" },
    { value: "ocean", label: "Ocean" },
    { value: "gruvbox", label: "Gruvbox" },
    { value: "nord", label: "Nord" },
    { value: "catppuccin", label: "Catppuccin" },
    { value: "solarized", label: "Solarized" },
    { value: "dracula", label: "Dracula" },
    { value: "rose-pine", label: "Rosé Pine" },
    { value: "tokyo-night", label: "Tokyo Night" },
    { value: "everforest", label: "Everforest" },
];

// Site-wide effects. Each is switched on by CSS that looks for its checked
// [data-*-toggle] anywhere on the page.
const EFFECTS = [
    { label: "Crosshair", attr: "data-crosshair-toggle" },
    { label: "Scanlines", attr: "data-scanlines-toggle" },
    { label: "Signal", attr: "data-signal-toggle" },
    { label: "Lift shadow", attr: "data-lift-shadow-toggle" },
    { label: "Invert theme", attr: "data-theme-toggle" },
];
---

<Dropdown
    class="display-settings"
    id="display-settings"
    label="Display"
    icon="lucide:sliders-horizontal"
    title="Display"
    align="end"
>
    <div class="display-settings__row text-ui">
        <label for="theme-select">Theme</label>
        {/* Themes key off the selected <option> via :has(). */}
        <Select
            id="theme-select"
            label="Theme"
            options={THEMES}
            data-theme-select
        />
    </div>

    <div class="display-settings__row text-ui">
        <span>Preview width</span>
        <SegmentedControl
            name={PREVIEW_WIDTH_NAME}
            label="Default preview width"
            options={previewWidthOptions()}
            value="desktop"
            size="sm"
            variant="subtle"
        />
    </div>

    {OVERRIDES.map((override) => (
        <div class="display-settings__row text-ui">
            <span>{override.label}</span>
            <SegmentedControl
                name={override.name}
                label={override.label}
                options={overrideOptions(override)}
                value="default"
                size="sm"
                variant="subtle"
            />
        </div>
    ))}

    <fieldset class="display-settings__effects">
        <legend class="text-ui">Effects</legend>
        {EFFECTS.map(({ label, attr }) => (
            <Toggle {label} {...{ [attr]: true }}>
                {label}
            </Toggle>
        ))}
    </fieldset>
</Dropdown>

<style>
.display-settings {
    .display-settings__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        color: var(--color-text-muted);
    }

    .display-settings__effects {
        display: grid;
        gap: var(--space-sm);
        margin: 0;
        padding: var(--space-md) 0 0;
        border: 0;
        border-top: var(--border-width) solid var(--border-color);
        min-width: 0;

        legend {
            float: left;
            margin-bottom: var(--space-xs);
            color: var(--color-text-muted);
        }
    }
}
</style>

<script>
/*
 * Theme and overrides reflow the whole page, so what the reader was looking
 * at moves. Keep track of the element under the sticky bar as they scroll
 * (a change's reflow can't be measured after the fact, as reading layout
 * flushes it), and put it back after each change. Fonts a theme loads late
 * reflow again, so repeat once they land.
 */
const settings = document.getElementById("display-settings");
const bar = document.querySelector(".gallery__bar");
const main = document.querySelector(".gallery__main");

let anchor: Element | null = null;
let anchorTop = 0;
let pending = false;

const remember = () => {
    pending = false;
    if (!bar || !main) return;
    // elementsFromPoint, as the open dropdown's panel can be on top of the page.
    const y = bar.getBoundingClientRect().bottom + 8;
    const hit = document
        .elementsFromPoint(window.innerWidth / 2, y)
        .find((el) => main.contains(el));
    if (!hit) return;
    anchor = hit;
    anchorTop = hit.getBoundingClientRect().top;
};

const schedule = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(remember);
};

remember();
window.addEventListener("scroll", schedule, { passive: true });
window.addEventListener("resize", schedule);

settings?.addEventListener("change", () => {
    const target = anchor;
    const top = anchorTop;
    if (!target?.isConnected) return;

    const restore = () => {
        const drift = target.getBoundingClientRect().top - top;
        if (drift) window.scrollBy({ top: drift, behavior: "instant" });
    };

    restore();
    requestAnimationFrame(restore);
    document.fonts.addEventListener("loadingdone", restore, { once: true });
});
</script>
