---
import SegmentedControl from "../components/ui/segmented-control.astro";
import type { StoryGroup } from "./story.ts";
import StoryNode from "./story-node.astro";
import { PREVIEW_WIDTH_NAME, previewWidthOptions } from "./widths.ts";

/**
 * One gallery group: a linkable heading with the component's source, a
 * per-group preview width override, and a grid of its stories.
 */
interface Props {
    group: StoryGroup;
}

const { group } = Astro.props;

const cell = (min: number | "full" = 16) =>
    min === "full" ? "100%" : `${min}rem`;
const count = group.stories.length;
---

<section
    class="story-group"
    id={group.id}
    aria-labelledby={`${group.id}-title`}
>
    <header class="story-group__header">
        <h3 class="story-group__title" id={`${group.id}-title`}>
            <a href={`#${group.id}`}>{group.title}</a>
        </h3>
        <SegmentedControl
            class="story-group__width"
            name={`${PREVIEW_WIDTH_NAME}-${group.id}`}
            label={`Preview width for ${group.title}`}
            options={previewWidthOptions(true)}
            value="auto"
            size="sm"
            variant="subtle"
        />
        <p class="story-group__meta">
            <code>src/components/{group.source}</code>
            <span>{`${count} ${count === 1 ? "story" : "stories"}`}</span>
        </p>
        {group.description && (
            <p class="story-group__description">{group.description}</p>
        )}
    </header>
    <div class="story-group__grid" style={`--cell: ${cell(group.min)}`}>
        {group.stories.map((story) => (
            <figure
                class="story-group__cell"
                data-story={`${group.id}/${story.name}`}
            >
                <figcaption>{story.name}</figcaption>
                <div class="story-group__preview">
                    <StoryNode {story} />
                </div>
            </figure>
        ))}
    </div>
</section>

<style>
.story-group {
    container-type: inline-size;
    /* Clear the sticky gallery bar when jumped to. */
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--border-color);
    border-radius: var(--radius);

    /*
     * Preview width. The page-wide picker sets a default; a group's own
     * picker, unless on Auto, overrides it. The page-wide half is in :where()
     * so it carries no weight against the override, and :global() so Astro
     * leaves html unscoped. Ids match widths.ts.
     */
    :global(
            :where(
                html:has(input[name="preview-width"][value="tablet"]:checked)
            )
        ) &,
    &:has(.story-group__width input[value="tablet"]:checked) {
        --preview-width: 48rem;
        --preview-frame: dotted;
    }

    :global(
            :where(html:has(input[name="preview-width"][value="phone"]:checked))
        )
        &,
    &:has(.story-group__width input[value="phone"]:checked) {
        --preview-width: 32rem;
        --preview-frame: dotted;
    }

    :global(:where(html:has(input[name="preview-width"][value="tiny"]:checked)))
        &,
    &:has(.story-group__width input[value="tiny"]:checked) {
        --preview-width: 24rem;
        --preview-frame: dotted;
    }

    /* Needed explicitly, to override a narrower page-wide default. */
    &:has(.story-group__width input[value="desktop"]:checked) {
        --preview-width: initial;
        --preview-frame: initial;
    }

    .story-group__header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: var(--space-md);
        row-gap: var(--space-xs);
        padding: var(--space-md);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    .story-group__title {
        margin: 0;
        font-size: var(--font-size-lg);

        a {
            color: inherit;
            text-decoration: none;

            /* Not the global link hover's highlighter fill. */
            &:hover {
                color: inherit;
                background-color: transparent;
            }

            /*
             * A # appears on hover, the usual hint that a heading is a link.
             * Empty alt text: decoration, not part of the link's name.
             */
            &::after {
                content: "#" / "";
                margin-left: var(--space-sm);
                color: var(--color-text-muted);
                opacity: 0;
                transition: opacity var(--transition);
            }

            &:hover::after,
            &:focus-visible::after {
                opacity: 1;
            }
        }
    }

    /* Quiet until wanted: shown on hover or focus, or while it overrides. */
    .story-group__width {
        grid-row: 1 / span 2;
        grid-column: 2;
        opacity: 0;
        transition: opacity var(--transition);

        &:has(input:not([value="auto"]):checked) {
            opacity: 1;
        }

        @media (hover: none) {
            opacity: 1;
        }
    }

    &:hover .story-group__width,
    &:focus-within .story-group__width {
        opacity: 1;
    }

    .story-group__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-xs) var(--space-md);
        margin: 0;
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);

        code {
            font-size: inherit;
            overflow-wrap: anywhere;
        }
    }

    .story-group__description {
        grid-column: 1 / -1;
        margin: var(--space-xs) 0 0;
        font-size: var(--font-size-sm);
        line-height: var(--leading-snug);
        color: var(--color-text-muted);
    }

    .story-group__grid {
        display: grid;
        grid-template-columns: repeat(
                auto-fill,
                minmax(min(var(--cell), 100%), 1fr)
            );
        gap: var(--space-md);
        align-items: start;
        /* The width is the stories' own, not counting this padding. */
        box-sizing: content-box;
        max-width: var(--preview-width, none);
        margin: var(--space-md) auto;
        padding-inline: var(--space-md);
        /* A dotted frame marks the edges of a constrained preview. */
        border-inline: var(--border-width) var(--preview-frame, none)
            var(--color-border-strong);
        transition: max-width var(--transition);

        @media (prefers-reduced-motion: reduce) {
            transition: none;
        }
    }

    .story-group__cell {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        margin: 0;

        figcaption {
            font-family: var(--font-mono);
            font-size: var(--font-size-xs);
            color: var(--color-text-muted);
        }
    }

    .story-group__preview {
        container-type: inline-size;
        display: flex;
        align-items: flex-start;
    }

    /* A group this narrow is already phone-sized: nothing to switch. */
    @container (width < 36rem) {
        .story-group__header {
            grid-template-columns: minmax(0, 1fr);
        }

        .story-group__width {
            display: none;
        }
    }
}
</style>
