---
import SegmentedControl from "@cpluspatch/ui/astro/ui/segmented-control.astro";
import type { StoryGroup } from "./story.ts";
import StoryCell from "./story-cell.astro";
import StoryNode from "./story-node.astro";
import { PREVIEW_WIDTH_NAME, previewWidthOptions } from "./widths.ts";

/**
 * One group of stories, as a section of its component's page: a grid of
 * stories on their stages, or for a matrix() group, a table of them with
 * the two axes as its headings.
 *
 * A component of several groups gives each a heading, its source, and a
 * preview width of its own. A component of one is just the stories: the
 * page's header and toolbar already say the rest.
 */
interface Props {
    group: StoryGroup;
    /** Whether the group shares its page with others. */
    titled: boolean;
    /** Whether to name the group's file: only when the page has several. */
    source?: boolean;
}

const { group, titled, source = false } = Astro.props;
const { matrix } = group;

const cell = (min: number | "full" = 16) =>
    min === "full" ? "100%" : `${min}rem`;
const count = group.stories.length;
const id = (name: string) => `${group.id}/${name}`;
const at = (row: string, column: string) =>
    group.stories.find(
        (s) =>
            s.name ===
            `${matrix?.rows.name}=${row},${matrix?.columns.name}=${column}`,
    );
---

<section
    class="story-group"
    id={group.id}
    aria-labelledby={titled ? `${group.id}-title` : undefined}
    aria-label={titled ? undefined : group.title}
>
    {titled && (
        <header class="story-group__header">
            <h2
                class="story-group__title text-subheading"
                id={`${group.id}-title`}
            >
                <a href={`#${group.id}`}>{group.title}</a>
            </h2>
            <SegmentedControl
                class="story-group__width"
                name={`${PREVIEW_WIDTH_NAME}-${group.id}`}
                label={`Preview width for ${group.title}`}
                options={previewWidthOptions(true)}
                value="auto"
                size="sm"
                variant="subtle"
            />
            <p class="story-group__meta text-meta">
                {source && <code>{group.source.split("/").at(-1)}</code>}
                <span>
                    {matrix
                        ? `${matrix.rows.name} (${matrix.rows.values.length}) × ${matrix.columns.name} (${matrix.columns.values.length})`
                        : `${count} ${count === 1 ? "story" : "stories"}`}
                </span>
            </p>
            {group.description && (
                <p class="story-group__description text-body-sm">
                    {group.description}
                </p>
            )}
        </header>
    )}
    <div class="story-group__body">
        {matrix ? (
            <div class="story-group__matrix story__stage">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">
                                <span class="visually-hidden">
                                    {matrix.rows.name}
                                </span>
                            </th>
                            {matrix.columns.values.map((column) => (
                                <th scope="col">{column}</th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {matrix.rows.values.map((row) => (
                            <tr>
                                <th scope="row">{row}</th>
                                {matrix.columns.values.map((column) => {
                                    const story = at(row, column);
                                    return (
                                        story && (
                                            <td
                                                data-story={id(story.name)}
                                                title={story.name}
                                            >
                                                <div class="story__preview">
                                                    <StoryNode {story} />
                                                </div>
                                            </td>
                                        )
                                    );
                                })}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        ) : (
            <div class="story-group__grid" style={`--cell: ${cell(group.min)}`}>
                {group.stories.map((story) => (
                    <StoryCell id={id(story.name)} {story} />
                ))}
            </div>
        )}
    </div>
</section>

<style>
.story-group {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    /* --preview-width and --preview-frame come from PREVIEW_CSS (widths.ts). */

    .story-group__header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: var(--space-md);
        row-gap: var(--space-xs);
        padding-bottom: var(--space-sm);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    .story-group__title {
        margin: 0;

        /* A box around the text and its #, so the focus ring clears both. */
        a {
            display: inline-flex;
            align-items: baseline;
            gap: var(--space-sm);
            color: inherit;
            text-decoration: none;

            /* Not the global link hover's highlighter fill. */
            &:hover {
                color: inherit;
                background-color: transparent;
            }

            /*
             * A # appears on hover, the usual hint that a heading is a link.
             * Empty alt text: decoration, not part of the link's name.
             */
            &::after {
                content: "#" / "";
                color: var(--color-text-muted);
                opacity: 0;
                transition: opacity var(--transition);
            }

            &:hover::after,
            &:focus-visible::after {
                opacity: 1;
            }
        }
    }

    /* Quiet until wanted: shown on hover or focus, or while it overrides. */
    .story-group__width {
        grid-row: 1 / span 2;
        grid-column: 2;
        opacity: 0;
        transition: opacity var(--transition);

        &:has(input:not([value="auto"]):checked) {
            opacity: 1;
        }

        @media (hover: none) {
            opacity: 1;
        }
    }

    &:hover .story-group__width,
    &:focus-within .story-group__width {
        opacity: 1;
    }

    .story-group__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-xs) var(--space-md);
        margin: 0;

        code {
            overflow-wrap: anywhere;
        }
    }

    .story-group__description {
        grid-column: 1 / -1;
        margin: var(--space-xs) 0 0;
        color: var(--color-text-muted);
    }

    /* The width is the stories' own; a dotted frame marks a capped one. */
    .story-group__body {
        box-sizing: content-box;
        width: calc(100% - 2 * var(--preview-gutter, 0px));
        max-width: var(--preview-width, none);
        margin-inline: auto;
        padding-inline: var(--preview-gutter, 0);
        border-inline: var(--border-width) var(--preview-frame, none)
            var(--color-border-strong);
        transition: max-width var(--transition);

        @media (prefers-reduced-motion: reduce) {
            transition: none;
        }
    }

    .story-group__grid {
        display: grid;
        grid-template-columns: repeat(
                auto-fill,
                minmax(min(var(--cell), 100%), 1fr)
            );
        gap: var(--space-md);
        align-items: start;
    }

    /* One stage for the whole table; it scrolls sideways if it must. */
    .story-group__matrix {
        overflow-x: auto;
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);

        table {
            margin-inline: auto;
            border-collapse: collapse;
        }

        th {
            padding: var(--space-xs) var(--space-sm);
            font-family: var(--font-mono);
            font-size: var(--font-size-xs);
            font-weight: 500;
            color: var(--color-text-muted);
            text-align: center;
            white-space: nowrap;
        }

        th[scope="row"] {
            text-align: end;
        }

        td {
            padding: var(--space-sm);
            vertical-align: middle;
        }

        .story__preview {
            justify-content: center;
        }
    }
}
</style>
