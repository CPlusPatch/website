---
import { sourceOf, tagsOf } from "./components.ts";
import { combinations, type StoryGroup } from "./story.ts";
import StoryCell from "./story-cell.astro";
import StoryTags from "./story-tags.astro";

/**
 * One group of stories, as a section of its component's page: a grid of
 * stories on their stages, each followed by its combinations (controls).
 *
 * A component of several groups gives each a heading and its source. A
 * component of one is just the stories: the page's bar already says the rest.
 */
interface Props {
    group: StoryGroup;
    /** Whether the group shares its page with others. */
    titled: boolean;
    /** Whether to name the group's file: only when the page has several. */
    source?: boolean;
}

const { group, titled, source = false } = Astro.props;

const cell = (min: number | "full" = 16) =>
    min === "full" ? "100%" : `${min}rem`;
const count = group.stories.length;
---

<section
    class="story-group"
    id={group.id}
    aria-labelledby={titled ? `${group.id}-title` : undefined}
    aria-label={titled ? undefined : group.title}
>
    {titled && (
        <header class="story-group__header">
            <h2
                class="story-group__title text-subheading"
                id={`${group.id}-title`}
            >
                <a href={`#${group.id}`}>{group.title}</a>
            </h2>
            <p class="story-group__meta text-meta">
                {source && <code>{sourceOf(group).split("/").at(-1)}</code>}
                <span>
                    {count} {count === 1 ? "story" : "stories"}
                </span>
                <StoryTags tags={tagsOf(group)} />
            </p>
            {group.description && (
                <p class="story-group__description text-body-sm">
                    {group.description}
                </p>
            )}
        </header>
    )}
    <div class="story-group__body">
        <div class="story-group__grid" style={`--cell: ${cell(group.min)}`}>
            {group.stories.flatMap((story) => [
                <StoryCell group={group.id} {story} />,
                ...combinations(story).map((combination) => (
                    <StoryCell
                        group={group.id}
                        story={combination.story}
                        combo={combination.combo}
                    />
                )),
            ])}
        </div>
    </div>
</section>

<style>
/* The page, unless the Backdrop setting says otherwise (story-page.astro). */
:global(.story__stage) {
    background-color: var(--color-bg);
}

.story-group {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    .story-group__header {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        row-gap: var(--space-xs);
        padding-bottom: var(--space-sm);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    .story-group__title {
        margin: 0;

        /* A box around the text and its #, so the focus ring clears both. */
        a {
            display: inline-flex;
            align-items: baseline;
            gap: var(--space-sm);
            color: inherit;
            text-decoration: none;

            /* Not the global link hover's highlighter fill. */
            &:hover {
                color: inherit;
                background-color: transparent;
            }

            /*
             * A # appears on hover, the usual hint that a heading is a link.
             * Empty alt text: decoration, not part of the link's name.
             */
            &::after {
                content: "#" / "";
                color: var(--color-text-muted);
                opacity: 0;
                transition: opacity var(--transition);
            }

            &:hover::after,
            &:focus-visible::after {
                opacity: 1;
            }
        }
    }

    .story-group__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-xs) var(--space-md);
        margin: 0;

        code {
            overflow-wrap: anywhere;
        }
    }

    .story-group__description {
        grid-column: 1 / -1;
        margin: var(--space-xs) 0 0;
        color: var(--color-text-muted);
    }

    /* compare.ts's frames of the section's own page, one per scheme or theme. */
    :global(.story-group__compare) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
        gap: var(--space-md);
        align-items: start;

        :global(figure) {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            min-width: 0;
            margin: 0;
        }

        :global(figcaption) {
            font-family: var(--font-mono);
        }

        :global(iframe) {
            display: block;
            width: 100%;
            height: 12rem;
            border: var(--border-width) solid var(--border-color);
            border-radius: var(--radius);
        }
    }

    .story-group__grid {
        display: grid;
        grid-template-columns: repeat(
                auto-fill,
                minmax(min(var(--cell), 100%), 1fr)
            );
        gap: var(--space-md);
        align-items: start;
    }
}
</style>
