---
import { Icon } from "astro-icon/components";
import { storySource } from "./source.ts";
import { type Story, storyPath } from "./story.ts";
import StoryPreview from "./story-preview.astro";
import StoryTags from "./story-tags.astro";

/**
 * One story on its stage: a caption bar with its name, a Props panel (a
 * <details>, so no JS) and a link to the story's own page, above the story
 * on a backdrop the page toolbar picks (toolbar.astro).
 */
interface Props {
    group: string;
    story: Story;
}

const { group, story } = Astro.props;
const id = `${group}/${story.name}`;
---

<figure class="story" id={id} data-story={id}>
    <figcaption class="story__caption">
        <span class="story__title">
            {/* A link to itself: where to point someone at this story. */}
            <a class="story__name" href={`#${id}`}><code>{story.name}</code></a>
            <StoryTags tags={story.tags ?? []} />
        </span>
        <span class="story__actions">
            <details class="story__props">
                <summary class="story__action" title="Props">
                    <Icon name="lucide:code-xml" aria-hidden="true" />
                    <span class="visually-hidden">Props of {story.name}</span>
                </summary>
                <pre
                    class="story__source"
                ><code>{storySource(story)}</code></pre>
            </details>
            <a
                class="story__action"
                href={storyPath(group, story.name)}
                title="Open alone"
            >
                <Icon
                    name="lucide:square-arrow-out-up-right"
                    aria-hidden="true"
                />
                <span class="visually-hidden">Open {id} on its own</span>
            </a>
        </span>
    </figcaption>
    <div class="story__stage">
        <StoryPreview {story} />
    </div>
</figure>

<style>
.story {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    border: var(--border-width) solid var(--border-color);
    border-radius: var(--radius);
    /* The Props panel lays over the stage, above anything the story raises. */
    isolation: isolate;

    /* The story a link jumped to. */
    &:target {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 1px var(--color-primary);
    }
}

.story__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 2rem;
    padding-inline: var(--space-sm) var(--space-xs);
    background-color: var(--color-surface);
    border-bottom: var(--border-width) solid var(--border-color);
}

/* Only the story's own tags: its group's are in the page or section header. */
.story__title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
}

.story__name {
    min-width: 0;
    overflow: hidden;
    /* The code's font, which the ellipsis is drawn in too. */
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;

    &:hover {
        color: var(--color-primary);
        background-color: transparent;
    }

    code {
        font-size: inherit;
    }
}

.story__actions {
    display: flex;
    flex-shrink: 0;
}

.story__action {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-text-muted);

    &:hover {
        color: var(--color-text);
        background-color: transparent;
    }
}

.story__props {
    summary {
        display: grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        color: var(--color-text-muted);
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }

        &:hover {
            color: var(--color-text);
        }
    }

    &[open] summary {
        color: var(--color-primary);
    }
}

.story__source {
    position: absolute;
    inset: 2rem 0 auto;
    z-index: 1;
    max-height: 20rem;
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    overflow: auto;
    font-size: var(--font-size-xs);
    line-height: 1.5;
    color: var(--color-text);
    background-color: var(--color-surface);
    border-bottom: var(--border-width) solid var(--border-color);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

/* The backdrop is set by the toolbar; dots until it says otherwise. */
.story__stage {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-md);
}
</style>
