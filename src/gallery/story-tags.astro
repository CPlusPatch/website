---
import Badge from "@cpluspatch/ui/astro/ui/badge.astro";
import { TAG_HINTS } from "./bench.ts";
import type { Tag } from "./story.ts";

/** A story's or group's tags (TAGS in story.ts), as small badges. */
interface Props {
    tags: Tag[];
}

const { tags } = Astro.props;
---

{tags.map((tag) => (
    <Badge variant="outline" tone="secondary" size="sm" title={TAG_HINTS[tag]}>
        {tag}
    </Badge>
))}
