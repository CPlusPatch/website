---
import { OVERRIDES } from "@cpluspatch/ui/styles/overrides.ts";
import { STYLES } from "@cpluspatch/ui/styles/styles/index.ts";
import { THEMES } from "@cpluspatch/ui/styles/themes/index.ts";
import Layout from "../layouts/base.astro";
import { PREVIEW_WIDTHS } from "./widths.ts";

/**
 * A gallery page with nothing on it but stories: one story, or one group
 * of them. For opening from the gallery, and for tests and diffs to load
 * by URL.
 *
 * Query parameters pick the look: ?theme, ?style, ?scheme=light|dark,
 * ?spacing, ?radius and ?font-size (an override's option, as in
 * styles/overrides.ts), and ?width=<phone, tablet, tiny, or rem>. Without
 * them the page has the default look, as saved Display choices don't apply.
 */
interface Props {
    title: string;
    description: string;
    /** The one story's id, for a page of one. */
    story?: string;
    /** Centre the story in the window, for one that doesn't fill its width. */
    centre?: boolean;
}

const { title, description, story, centre = false } = Astro.props;

const overrideValues = (name: string) =>
    OVERRIDES.find((override) => override.name === name)?.options.map(
        (option) => option.value,
    ) ?? [];

const options = {
    themes: THEMES.map((theme) => theme.value),
    styles: STYLES.map((style) => style.value),
    spacing: overrideValues("override-spacing"),
    radius: overrideValues("override-radius"),
    fontSize: overrideValues("override-font-size"),
    widths: Object.fromEntries(PREVIEW_WIDTHS.map((w) => [w.id, w.width])),
};
---

{/* Framed in the bench, where a skip link would only be in the way. */}
<Layout
    {title}
    {description}
    noindex
    analytics={false}
    skipTo={false}
    savedDisplay={false}
>
    {/* Before the story paints; ignores anything it doesn't know. */}
    <script is:inline define:vars={{ options }}>
    const params = new URLSearchParams(location.search);
    const root = document.documentElement;
    const theme = params.get("theme");
    if (options.themes.includes(theme)) root.dataset.theme = theme;
    const style = params.get("style");
    if (options.styles.includes(style)) root.dataset.style = style;
    const scheme = params.get("scheme");
    if (scheme === "light" || scheme === "dark") root.dataset.scheme = scheme;
    const spacing = params.get("spacing");
    if (options.spacing.includes(spacing))
        root.dataset.overrideSpacing = spacing;
    const radius = params.get("radius");
    if (options.radius.includes(radius)) root.dataset.overrideRadius = radius;
    const fontSize = params.get("font-size");
    if (options.fontSize.includes(fontSize)) {
        root.dataset.overrideFontSize = fontSize;
    }
    const width = params.get("width") ?? "";
    const rem =
        options.widths[width] ?? (/^\d+(\.\d+)?rem$/.test(width) && width);
    if (rem) root.style.setProperty("--story-width", rem);
    // The bench's stage settings, kept for the tab (bench.svelte).
    try {
        const stage = sessionStorage.getItem("gallery-stage");
        if (stage === "dots" || stage === "surface") {
            root.dataset.galleryStage = stage;
        }
        if (sessionStorage.getItem("gallery-outline") === "true") {
            root.dataset.galleryOutline = "";
        }
    } catch {
        // Storage can be blocked (private mode).
    }
    </script>

    <main
        id="main"
        class:list={["story-page", { "story-page--centre": centre }]}
        data-story={story}
    >
        <slot />
    </main>
</Layout>

<script>
// The page-wide easter eggs the dialogue stories run.
import "./dialogue-actions.ts";
</script>

<style is:global>
/* The stage setting's backdrops: the page, and a group page's stages. */
html[data-gallery-stage="dots"] body,
html[data-gallery-stage="dots"] .story__stage {
    background-color: var(--color-bg);
    background-image: radial-gradient(
        color-mix(in oklab, var(--color-text) 16%, transparent) 1px,
        transparent 1px
    );
    background-size: 12px 12px;
}

html[data-gallery-stage="surface"] body,
html[data-gallery-stage="surface"] .story__stage {
    background-color: var(--color-surface);
}

/* Every box a story draws, outlined: for checking alignment and spacing. */
html[data-gallery-outline] :is(.story-preview, .story-preview *) {
    outline: 1px dashed
        color-mix(in oklab, var(--color-primary) 55%, transparent);
    outline-offset: -1px;
}
</style>

<style>
/* The gallery's padding, and its width when the page asks for one. */
.story-page {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--story-width, none);
    margin-inline: auto;
    padding: var(--space-md);
}

/* A small story otherwise sits at the top of a tall stage, over empty space. */
.story-page--centre {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100dvh;
}
</style>
