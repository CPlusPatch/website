---
import SidebarGroup from "@cpluspatch/ui/astro/sections/sidebar/sidebar-group.astro";
import SidebarLink from "@cpluspatch/ui/astro/sections/sidebar/sidebar-link.astro";
import { categories, storyCount } from "./components.ts";

/**
 * A link to each component's page, by category, with its story count. Used
 * in both the wide sidebar and the narrow bar menu.
 */
interface Props {
    /** The component whose page this is. */
    current?: string;
}

const { current } = Astro.props;
---

{categories.map((category) => (
    <SidebarGroup title={category.title} icon={category.icon}>
        {category.components.map((component) => (
            <SidebarLink
                href={`/gallery/${component.id}/`}
                current={component.id === current}
                meta={storyCount(component)}
            >
                {component.title}
            </SidebarLink>
        ))}
    </SidebarGroup>
))}
