---
import { Icon } from "astro-icon/components";
import Button from "../components/button.astro";
import ButtonGroup from "../components/button-group.astro";
import StoryNode from "../components/story-node.astro";
import Layout from "../layouts/layout.astro";
import { groups } from "../stories";

// A development-only gallery. In a production build this becomes a redirect
// stub rather than shipping the whole component matrix to visitors.
if (import.meta.env.PROD) {
    return Astro.redirect("/", 302);
}

// A negative `min` means one full-width cell per row.
const cell = (min = 16) => (min < 0 ? "100%" : `${min}rem`);
---

<Layout title="Component gallery" noindex>
    <main id="main" class="container">
        {groups.map((group) => (
            <section class="gallery">
                <div class="gallery__header">
                    <h2>{group.title}</h2>
                    <ButtonGroup
                        class="gallery__controls"
                        label="Preview width"
                    >
                        <Button
                            size="icon"
                            variant="outline"
                            tone="neutral"
                            lift={false}
                            data-size="desktop"
                            aria-pressed="true"
                            aria-label="Show desktop layout"
                        >
                            <Icon name="lucide:monitor" aria-hidden="true" />
                        </Button>
                        <Button
                            size="icon"
                            variant="outline"
                            tone="neutral"
                            lift={false}
                            data-size="tablet"
                            aria-pressed="false"
                            aria-label="Show tablet layout"
                        >
                            <Icon name="lucide:tablet" aria-hidden="true" />
                        </Button>
                        <Button
                            size="icon"
                            variant="outline"
                            tone="neutral"
                            lift={false}
                            data-size="phone"
                            aria-pressed="false"
                            aria-label="Show phone layout"
                        >
                            <Icon name="lucide:smartphone" aria-hidden="true" />
                        </Button>
                        <Button
                            size="icon"
                            variant="outline"
                            tone="neutral"
                            lift={false}
                            data-size="tiny"
                            aria-pressed="false"
                            aria-label="Show tiny layout"
                        >
                            <Icon name="lucide:watch" aria-hidden="true" />
                        </Button>
                    </ButtonGroup>
                </div>
                {group.description && <p>{group.description}</p>}
                <div class="grid" style={`--cell: ${cell(group.min)}`}>
                    {group.stories.map((story) => {
                        return (
                            <figure
                                class="cell"
                                data-story={`${group.id}/${story.name}`}
                            >
                                <figcaption>{story.name}</figcaption>
                                <div class="preview">
                                    <StoryNode {story} />
                                </div>
                            </figure>
                        );
                    })}
                </div>
            </section>
        ))}
    </main>
</Layout>

<style>
main {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
}

.gallery {
    padding: var(--space-md);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--border-color);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    .gallery__header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        h2 {
            font-size: var(--font-size-lg);
        }
    }

    & > p {
        color: var(--color-text-muted);
    }

    .gallery__controls :global(.button[aria-pressed="true"]) {
        color: var(--color-text);
        border-color: var(--color-text);
        background-color: var(--color-bg-alt);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(
                auto-fill,
                minmax(min(var(--cell), 100%), 1fr)
            );
        gap: var(--space-md);
        align-items: start;
        width: 100%;
        margin: 0 auto;

        &.tablet {
            max-width: 48rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        &.phone {
            max-width: 32rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        &.tiny {
            max-width: 24rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        .cell {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            margin: 0;
        }
    }
}

figcaption {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
}

.preview {
    container-type: inline-size;
    display: flex;
    align-items: flex-start;
}
</style>

<script>
// When the sizing buttons are clicked, toggle class on the grid to change its max-width.

const controls = document.querySelectorAll(".gallery__controls .button");

for (const control of controls) {
    control.addEventListener("click", () => {
        const grid = control.closest(".gallery")?.querySelector(".grid");
        const size = control.getAttribute("data-size");

        if (!grid || !size) return;

        grid.classList.remove("desktop", "tablet", "phone", "tiny");
        grid.classList.add(size);

        for (const other of control.parentElement?.children ?? []) {
            other.setAttribute("aria-pressed", String(other === control));
        }
    });
}
</script>
