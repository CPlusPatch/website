---
import { Icon } from "astro-icon/components";
import StoryNode from "../components/story-node.astro";
import Button from "../components/ui/button.astro";
import ButtonGroup from "../components/ui/button-group.astro";
import Select from "../components/ui/select.astro";
import Toggle from "../components/ui/toggle.astro";
import Layout from "../layouts/layout.astro";
import { groups } from "../stories";

// Each value other than "default" needs a matching stylesheet in
// src/styles/themes/, which switches on while its option is selected.
const THEMES = [
    { value: "default", label: "Default" },
    { value: "ocean", label: "Ocean" },
];

// Site-wide effects. Each is switched on by CSS that looks for its checked
// [data-*-toggle] anywhere on the page, so these need no JS either.
const EFFECTS = [
    { label: "Crosshair", attr: "data-crosshair-toggle" },
    { label: "Scanlines", attr: "data-scanlines-toggle" },
    { label: "Lift shadow", attr: "data-lift-shadow-toggle" },
    { label: "Invert theme", attr: "data-theme-toggle" },
];

const cell = (min: number | "full" = 16) =>
    min === "full" ? "100%" : `${min}rem`;

// "desktop" has no class rule: it is the unconstrained width.
const SIZES = [
    { size: "desktop", icon: "lucide:monitor" },
    { size: "tablet", icon: "lucide:tablet" },
    { size: "phone", icon: "lucide:smartphone" },
    { size: "tiny", icon: "lucide:watch" },
];
---

<Layout
    title="Component gallery"
    description="Every component in the web-ng UI toolkit, in each of its states and themes."
    noindex
>
    <main id="main" class="container">
        <header class="toolbar">
            <div class="toolbar__layout">
                <h1>Component gallery</h1>
                <div class="toolbar__controls">
                    <fieldset class="toolbar__effects">
                        <legend class="visually-hidden">Effects</legend>
                        {EFFECTS.map(({ label, attr }) => (
                            <Toggle {label} {...{ [attr]: true }}>
                                {label}
                            </Toggle>
                        ))}
                    </fieldset>
                    {/* Works without JS: themes key off the selected <option> via :has(). */}
                    <div class="toolbar__theme">
                        <label for="theme-select">Theme</label>
                        <Select
                            id="theme-select"
                            label="Theme"
                            options={THEMES}
                            data-theme-select
                        />
                    </div>
                </div>
            </div>
        </header>
        {groups.map((group) => (
            <section class="gallery">
                <div class="gallery__header">
                    <h2>{group.title}</h2>
                    <ButtonGroup
                        class="gallery__controls"
                        label="Preview width"
                    >
                        {SIZES.map(({ size, icon }, i) => (
                            <Button
                                size="icon"
                                variant="outline"
                                tone="neutral"
                                lift={false}
                                data-size={size}
                                aria-pressed={i === 0 ? "true" : "false"}
                                aria-label={`Show ${size} layout`}
                            >
                                <Icon name={icon} aria-hidden="true" />
                            </Button>
                        ))}
                    </ButtonGroup>
                </div>
                {group.description && <p>{group.description}</p>}
                <div class="grid" style={`--cell: ${cell(group.min)}`}>
                    {group.stories.map((story) => (
                        <figure
                            class="cell"
                            data-story={`${group.id}/${story.name}`}
                        >
                            <figcaption>{story.name}</figcaption>
                            <div class="preview">
                                <StoryNode {story} />
                            </div>
                        </figure>
                    ))}
                </div>
            </section>
        ))}
    </main>
</Layout>

<style>
main {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
}

/*
 * One row when there is room for it (it needs about 58rem). Below that, the
 * controls move into a panel under the title instead of wrapping piecemeal:
 * effects in a grid of 4, 2 or 1 columns so rows always fill evenly, and
 * theme on its own row.
 */
.toolbar {
    container-type: inline-size;

    h1 {
        font-size: var(--font-size-2xl);
    }

    .toolbar__layout {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-md);
    }

    .toolbar__controls,
    .toolbar__effects {
        display: flex;
        align-items: center;
    }

    .toolbar__controls {
        gap: var(--space-lg);
    }

    .toolbar__effects {
        gap: var(--space-md);
        margin: 0;
        padding: 0;
        border: 0;
        min-width: 0;
    }

    .toolbar__theme {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
    }

    @container (width < 59rem) {
        .toolbar__layout {
            flex-direction: column;
            align-items: stretch;
        }

        .toolbar__controls {
            flex-direction: column;
            align-items: stretch;
            gap: var(--space-md);
            padding: var(--space-md);
            background-color: var(--color-surface);
            border: var(--border-width) solid var(--border-color);
            border-radius: var(--radius);
        }

        .toolbar__effects {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--space-sm) var(--space-md);
        }

        .toolbar__theme {
            justify-content: space-between;
            padding-top: var(--space-md);
            border-top: var(--border-width) solid var(--border-color);
        }
    }

    @container (width < 40rem) {
        .toolbar__effects {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @container (width < 21rem) {
        .toolbar__effects {
            grid-template-columns: 1fr;
        }
    }
}

.gallery {
    padding: var(--space-md);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--border-color);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    .gallery__header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        h2 {
            font-size: var(--font-size-lg);
        }
    }

    & > p {
        color: var(--color-text-muted);
    }

    .gallery__controls :global(.button[aria-pressed="true"]) {
        color: var(--color-text);
        border-color: var(--color-text);
        background-color: var(--color-bg-alt);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(
                auto-fill,
                minmax(min(var(--cell), 100%), 1fr)
            );
        gap: var(--space-md);
        align-items: start;
        width: 100%;
        margin: 0 auto;

        &.tablet {
            max-width: 48rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        &.phone {
            max-width: 32rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        &.tiny {
            max-width: 24rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        .cell {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            margin: 0;
        }
    }
}

figcaption {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
}

.preview {
    container-type: inline-size;
    display: flex;
    align-items: flex-start;
}
</style>

<script>
const controls = document.querySelectorAll(".gallery__controls .button");

for (const control of controls) {
    control.addEventListener("click", () => {
        const grid = control.closest(".gallery")?.querySelector(".grid");
        const size = control.getAttribute("data-size");

        if (!grid || !size) return;

        grid.classList.remove("desktop", "tablet", "phone", "tiny");
        grid.classList.add(size);

        for (const other of control.parentElement?.children ?? []) {
            other.setAttribute("aria-pressed", String(other === control));
        }
    });
}
</script>
