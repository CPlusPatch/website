---
import { Icon } from "astro-icon/components";
import Button from "../components/button.astro";
import ButtonGroup from "../components/button-group.astro";
import Select from "../components/select.astro";
import StoryNode from "../components/story-node.astro";
import Layout from "../layouts/layout.astro";
import { groups } from "../stories";

// A development-only gallery. In a production build this becomes a redirect
// stub rather than shipping the whole component matrix to visitors.
if (import.meta.env.PROD) {
    return Astro.redirect("/", 302);
}

// Each value other than "default" needs a matching stylesheet in
// src/styles/themes/, which switches on while its option is selected.
const THEMES = [
    { value: "default", label: "Default" },
    { value: "ocean", label: "Ocean" },
];

const cell = (min: number | "full" = 16) =>
    min === "full" ? "100%" : `${min}rem`;

// "desktop" has no class rule: it is the unconstrained width.
const SIZES = [
    { size: "desktop", icon: "lucide:monitor" },
    { size: "tablet", icon: "lucide:tablet" },
    { size: "phone", icon: "lucide:smartphone" },
    { size: "tiny", icon: "lucide:watch" },
];
---

<Layout title="Component gallery" noindex>
    <main id="main" class="container">
        <div class="toolbar">
            <h1>Component gallery</h1>
            {/* Works without JS: themes key off the selected <option> via :has(). */}
            <div class="toolbar__theme">
                <label for="theme-select">Theme</label>
                <Select
                    id="theme-select"
                    label="Theme"
                    options={THEMES}
                    data-theme-select
                />
            </div>
        </div>
        {groups.map((group) => (
            <section class="gallery">
                <div class="gallery__header">
                    <h2>{group.title}</h2>
                    <ButtonGroup
                        class="gallery__controls"
                        label="Preview width"
                    >
                        {SIZES.map(({ size, icon }, i) => (
                            <Button
                                size="icon"
                                variant="outline"
                                tone="neutral"
                                lift={false}
                                data-size={size}
                                aria-pressed={i === 0 ? "true" : "false"}
                                aria-label={`Show ${size} layout`}
                            >
                                <Icon name={icon} aria-hidden="true" />
                            </Button>
                        ))}
                    </ButtonGroup>
                </div>
                {group.description && <p>{group.description}</p>}
                <div class="grid" style={`--cell: ${cell(group.min)}`}>
                    {group.stories.map((story) => (
                        <figure
                            class="cell"
                            data-story={`${group.id}/${story.name}`}
                        >
                            <figcaption>{story.name}</figcaption>
                            <div class="preview">
                                <StoryNode {story} />
                            </div>
                        </figure>
                    ))}
                </div>
            </section>
        ))}
    </main>
</Layout>

<style>
main {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
}

.toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);

    h1 {
        font-size: var(--font-size-2xl);
    }

    .toolbar__theme {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
    }
}

.gallery {
    padding: var(--space-md);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--border-color);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    .gallery__header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        h2 {
            font-size: var(--font-size-lg);
        }
    }

    & > p {
        color: var(--color-text-muted);
    }

    .gallery__controls :global(.button[aria-pressed="true"]) {
        color: var(--color-text);
        border-color: var(--color-text);
        background-color: var(--color-bg-alt);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(
                auto-fill,
                minmax(min(var(--cell), 100%), 1fr)
            );
        gap: var(--space-md);
        align-items: start;
        width: 100%;
        margin: 0 auto;

        &.tablet {
            max-width: 48rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        &.phone {
            max-width: 32rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        &.tiny {
            max-width: 24rem;
            border-inline: var(--border-width) dotted var(--border-color);
        }

        .cell {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            margin: 0;
        }
    }
}

figcaption {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
}

.preview {
    container-type: inline-size;
    display: flex;
    align-items: flex-start;
}
</style>

<script>
const controls = document.querySelectorAll(".gallery__controls .button");

for (const control of controls) {
    control.addEventListener("click", () => {
        const grid = control.closest(".gallery")?.querySelector(".grid");
        const size = control.getAttribute("data-size");

        if (!grid || !size) return;

        grid.classList.remove("desktop", "tablet", "phone", "tiny");
        grid.classList.add(size);

        for (const other of control.parentElement?.children ?? []) {
            other.setAttribute("aria-pressed", String(other === control));
        }
    });
}
</script>
