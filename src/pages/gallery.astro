---
import { Icon } from "astro-icon/components";
import Sidebar from "../components/sections/sidebar/sidebar.astro";
import SidebarGroup from "../components/sections/sidebar/sidebar-group.astro";
import SidebarLayout from "../components/sections/sidebar/sidebar-layout.astro";
import SidebarLink from "../components/sections/sidebar/sidebar-link.astro";
import DisplaySettings from "../gallery/display-settings.astro";
import { categories, groups } from "../gallery/stories/index.ts";
import StoryGroup from "../gallery/story-group.astro";
import Layout from "../layouts/base.astro";

const storyCount = groups.reduce((n, group) => n + group.stories.length, 0);
---

<Layout
    title="Component gallery"
    description="Every component in the web-ng UI toolkit, in each of its states and themes."
    noindex
>
    <div class="gallery">
        <header class="gallery__bar">
            <h1 class="gallery__title">Component gallery</h1>
            <p class="gallery__count">
                {`${groups.length} components · ${storyCount} stories`}
            </p>
            <DisplaySettings />
        </header>

        <SidebarLayout>
            <Sidebar slot="sidebar" class="gallery__sidebar" label="Components">
                {categories.map((category) => (
                    <SidebarGroup title={category.title} icon={category.icon}>
                        {category.groups.map((group) => (
                            <SidebarLink
                                href={`#${group.id}`}
                                section={group.id}
                            >
                                {group.title}
                            </SidebarLink>
                        ))}
                    </SidebarGroup>
                ))}
            </Sidebar>

            <main id="main" class="gallery__main">
                {categories.map((category) => (
                    <section
                        class="gallery__category"
                        aria-labelledby={category.id}
                    >
                        <header class="gallery__category-header">
                            <h2
                                class="gallery__category-title"
                                id={category.id}
                            >
                                <Icon name={category.icon} aria-hidden="true" />
                                {category.title}
                            </h2>
                            <p class="gallery__category-count">
                                {`${category.groups.length} components`}
                            </p>
                        </header>
                        {category.groups.map((group) => (
                            <StoryGroup {group} />
                        ))}
                    </section>
                ))}
            </main>
        </SidebarLayout>
    </div>
</Layout>

<style>
.gallery {
    width: min(100% - 2 * var(--space-md), 90rem);
    margin-inline: auto;

    /* Sticky, so the settings stay in reach; the sidebar sticks just below it. */
    .gallery__bar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: var(--space-sm) var(--space-md);
        min-height: var(--header-height);
        margin-bottom: var(--space-md);
        /* Bleed to the viewport edges, so content never shows beside it. */
        padding-inline: var(--space-md);
        margin-inline: calc(var(--space-md) * -1);
        background-color: color-mix(in oklab, var(--color-bg) 85%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    .gallery__title {
        margin: 0;
        font-size: var(--font-size-lg);
    }

    .gallery__count {
        flex: 1;
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
    }

    .gallery__sidebar {
        --sidebar-top: calc(var(--header-height) + var(--space-md));
    }

    /*
     * The page's bottom padding lives here, inside the sidebar's column:
     * outside it, the column would end short of the page and push the
     * sticky sidebar up at the bottom.
     */
    .gallery__main {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
        padding-bottom: var(--space-xl);
    }

    .gallery__category {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    /*
     * The break between categories: a full-strength heading on a solid
     * rule, so it reads clearly over the backdrop grid.
     */
    .gallery__category-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-md);
        padding-bottom: var(--space-sm);
        border-bottom: 2px solid var(--color-border-strong);
    }

    .gallery__category-title {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        margin: 0;
        font-size: var(--font-size-xl);
        scroll-margin-top: calc(var(--header-height) + var(--space-md));

        svg {
            color: var(--color-primary);
        }
    }

    .gallery__category-count {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
    }

    @container (width < 30rem) {
        .gallery__count {
            display: none;
        }

        .gallery__title {
            flex: 1;
        }
    }
}
</style>
