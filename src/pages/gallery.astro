---
import { Icon } from "astro-icon/components";
import Sidebar from "../components/sections/sidebar/sidebar.astro";
import SidebarLayout from "../components/sections/sidebar/sidebar-layout.astro";
import SidebarNav from "../components/sections/sidebar/sidebar-nav.astro";
import Dropdown from "../components/ui/dropdown.astro";
import DisplaySettings from "../gallery/display-settings.astro";
import GalleryNav from "../gallery/gallery-nav.astro";
import { OVERRIDES_CSS } from "../gallery/overrides.ts";
import { categories, groups } from "../gallery/stories/index.ts";
import type { StoryGroup as Group } from "../gallery/story.ts";
import StoryGroup from "../gallery/story-group.astro";
import { PREVIEW_CSS } from "../gallery/widths.ts";
import Layout from "../layouts/base.astro";

// Some components have several groups (buttons, badges): count them once.
const components = (list: Group[]) =>
    new Set(list.map((group) => group.source)).size;
const count = (n: number, one: string, many = `${one}s`) =>
    `${n} ${n === 1 ? one : many}`;

const storyCount = groups.reduce((n, group) => n + group.stories.length, 0);
const summary = `${count(components(groups), "component")} · ${count(storyCount, "story", "stories")}`;
---

<Layout
    title="Component gallery"
    description="Every component in the web-ng UI toolkit, in each of its states and themes."
    noindex
>
    <style is:inline set:html={PREVIEW_CSS} />
    <style is:inline set:html={OVERRIDES_CSS} />

    <div class="gallery" id="top">
        <header class="gallery__bar">
            <h1 class="gallery__title text-title">
                <a href="#top">Component gallery</a>
            </h1>
            <p class="gallery__count text-meta">{summary}</p>
            {/* The sidebar's links, for when there is no room for the sidebar. */}
            <Dropdown
                class="gallery__menu"
                id="gallery-menu"
                label="Components"
                icon="lucide:menu"
            >
                <SidebarNav label="Components">
                    <GalleryNav />
                </SidebarNav>
            </Dropdown>
            <DisplaySettings />
        </header>

        <SidebarLayout>
            <Sidebar slot="sidebar" class="gallery__sidebar" label="Components">
                <GalleryNav />
            </Sidebar>

            <main id="main" class="gallery__main">
                {categories.map((category) => (
                    <section
                        class="gallery__category"
                        aria-labelledby={category.id}
                    >
                        <header class="gallery__category-header">
                            <h2
                                class="gallery__category-title text-heading"
                                id={category.id}
                            >
                                <Icon name={category.icon} aria-hidden="true" />
                                {category.title}
                            </h2>
                            <p class="text-meta">
                                {count(
                                    components(category.groups),
                                    "component",
                                )}
                            </p>
                        </header>
                        {category.groups.map((group) => (
                            <StoryGroup {group} />
                        ))}
                    </section>
                ))}

                <footer class="gallery__end text-meta">
                    <span>{summary}</span>
                    <a href="#top">Back to top</a>
                </footer>
            </main>
        </SidebarLayout>
    </div>
</Layout>

<style>
.gallery {
    width: min(100% - 2 * var(--space-md), 90rem);
    margin-inline: auto;

    /* Focus and in-page jumps stop clear of the sticky bar. */
    :global(html):has(&) {
        scroll-padding-top: calc(var(--header-height) + var(--space-md));
    }

    /* Sticky, so the settings stay in reach; the sidebar sticks just below it. */
    .gallery__bar {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        display: flex;
        align-items: center;
        gap: var(--space-sm) var(--space-md);
        /* A fixed height, which the offsets above and below rely on. */
        height: var(--header-height);
        margin-bottom: var(--space-md);
        /* Bleed to the viewport edges, so content never shows beside it. */
        padding-inline: var(--space-md);
        margin-inline: calc(var(--space-md) * -1);
        background-color: color-mix(in oklab, var(--color-bg) 85%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    .gallery__title {
        min-width: 0;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;

        a {
            color: inherit;
            text-decoration: none;

            /* Not the global link hover's highlighter fill. */
            &:hover {
                color: inherit;
                background-color: transparent;
            }
        }
    }

    .gallery__count {
        flex: 1;
        margin: 0;
        white-space: nowrap;
    }

    .gallery__sidebar {
        --sidebar-top: calc(var(--header-height) + var(--space-md));
    }

    .gallery__main {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
        /*
         * The page's bottom padding lives here, inside the sidebar's column:
         * outside it, the column would end short of the page and push the
         * sticky sidebar up at the bottom.
         */
        padding-bottom: var(--space-xl);
    }

    .gallery__category {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    /*
     * The break between categories: a full-strength heading on a solid
     * rule, so it reads clearly over the backdrop grid.
     */
    .gallery__category-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-md);
        padding-bottom: var(--space-sm);
        border-bottom: 2px solid var(--color-border-strong);

        p {
            margin: 0;
        }
    }

    .gallery__category-title {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        margin: 0;

        svg {
            color: var(--color-primary);
        }
    }

    .gallery__end {
        display: flex;
        justify-content: space-between;
        gap: var(--space-md);
        padding-top: var(--space-md);
        border-top: var(--border-width) solid var(--border-color);

        a {
            color: inherit;
        }
    }

    /*
     * Narrow: the sidebar gives way to the Components menu in the bar, so
     * the links stay in reach while scrolling. The two queries meet at the
     * same width: the layout is the page less its 2 × space-md gutter.
     */
    .gallery__menu {
        display: none;
    }

    @container (width < 58rem) {
        .gallery__menu {
            display: inline-block;
        }
    }

    @container sidebar-layout (width < 56rem) {
        .gallery__sidebar {
            display: none;
        }
    }

    /* Tiny: drop the counts, and the buttons' words and chevrons. */
    @container (width < 30rem) {
        .gallery__count {
            display: none;
        }

        .gallery__title {
            flex: 1;
        }

        .gallery__bar {
            gap: var(--space-sm);
        }

        .gallery__bar :global(.dropdown__chevron) {
            display: none;
        }

        /* Icon-only now, so as compact as an icon button. */
        .gallery__bar :global(.dropdown__trigger) {
            padding-inline: var(--space-sm);
        }

        .gallery__bar :global(.dropdown__label) {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }
    }
}
</style>
