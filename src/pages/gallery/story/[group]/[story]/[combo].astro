---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { allStories } from "../../../../../gallery/components.ts";
import StoryPage from "../../../../../gallery/story-page.astro";
import StoryPreview from "../../../../../gallery/story-preview.astro";

/** One combination of a story's controls on a page of its own. */
export const getStaticPaths = (() =>
    allStories().flatMap(({ group, story, combo }) =>
        combo
            ? [
                  {
                      params: { group: group.id, story: story.name, combo },
                      props: { group, story, combo },
                  },
              ]
            : [],
    )) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { group, story, combo } = Astro.props;
---

<StoryPage
    title={`${group.title}: ${story.name}/${combo} · Component gallery`}
    description={`The "${combo}" combination of the "${story.name}" story of ${group.title}, on its own.`}
    story={`${group.id}/${story.name}/${combo}`}
    centre={group.min !== "full"}
>
    <StoryPreview {story} />
</StoryPage>
