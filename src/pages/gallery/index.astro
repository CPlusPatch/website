---
import Badge from "@cpluspatch/ui/astro/ui/badge.astro";
import Input from "@cpluspatch/ui/astro/ui/input.astro";
import { Icon } from "astro-icon/components";
import {
    categories,
    components,
    type GalleryComponent,
    origin,
    sourceOf,
    storyCount,
    tagsOf,
} from "../../gallery/components.ts";
import GalleryLayout from "../../gallery/gallery-layout.astro";
import { groups } from "../../gallery/stories/index.ts";
import StoryNode from "../../gallery/story-node.astro";

/**
 * The gallery's front page: every component, by category, each a card with
 * a small live preview of its first story that links to its page.
 */
const plural = (n: number, one: string, many = `${one}s`) =>
    `${n} ${n === 1 ? one : many}`;
const stories = groups.reduce((n, group) => n + group.stories.length, 0);

// The gallery used to be one page, with each group at /gallery/#<group-id>.
const moved = Object.fromEntries(
    components.flatMap((component) =>
        component.groups.map((group) => [
            group.id,
            `/gallery/${component.id}/#${group.id}`,
        ]),
    ),
);

/**
 * What the filter matches a card on, lowercased: its names, its groups' and
 * stories' names (so "autoplay" finds the carousel), its files, its tags
 * and its category.
 */
const searchText = (component: GalleryComponent, category: string) =>
    [
        component.id,
        component.title,
        category,
        origin(component) === "site" ? "site only" : "",
        ...component.groups.flatMap((group) => [
            group.id,
            group.title,
            sourceOf(group).split("/").at(-1),
            ...tagsOf(group),
            ...group.stories.flatMap((story) => [
                story.name,
                ...(story.tags ?? []),
            ]),
        ]),
    ]
        .join(" ")
        .toLowerCase();
---

<GalleryLayout
    description="The UI components this site is built from, with their variants and states."
    sidebar={false}
>
    {/* Sends an old link to a group on to the page it is on now. */}
    <script is:inline define:vars={{ moved }}>
    const to = moved[decodeURIComponent(location.hash.slice(1))];
    if (to) location.replace(to);
    </script>

    <header class="gallery-index__hero">
        <h1 class="text-headline">Components</h1>
        <p class="gallery-index__intro">
            The building blocks of this site, most of them from{" "}
            <code>packages/ui</code>. Pick one to see all its stories, or change
            the theme from Display.
        </p>
        <p class="text-meta">
            {`${plural(components.length, "component")} · ${plural(stories, "story", "stories")}`}
        </p>
        {/* A script's control: hidden until it runs. */}
        <search class="gallery-filter" hidden>
            <Input
                class="gallery-filter__input"
                type="search"
                label="Filter components"
                placeholder="Filter by name, story, file or tag (/)"
                aria-keyshortcuts="/"
                aria-describedby="gallery-filter-status"
            />
            <p
                class="gallery-filter__status text-meta"
                id="gallery-filter-status"
                role="status"
            ></p>
        </search>
    </header>

    {categories.map((category) => (
        <section class="gallery-index__category" aria-labelledby={category.id}>
            <header class="gallery-index__category-header">
                <h2 class="text-heading" id={category.id}>
                    <Icon name={category.icon} aria-hidden="true" />
                    {category.title}
                </h2>
                <p class="text-meta" data-count={category.components.length}>
                    {plural(category.components.length, "component")}
                </p>
            </header>
            <ul class="gallery-index__grid">
                {category.components.map((component) => {
                    const first = component.groups[0].stories[0];
                    return (
                        <li
                            class="gallery-card"
                            data-search={searchText(component, category.title)}
                        >
                            {/* Where /gallery/#<group-id> lands without JS. */}
                            {component.groups.map((group) => (
                                <span
                                    class="gallery-card__anchor"
                                    id={group.id}
                                />
                            ))}
                            <div class="gallery-card__thumb" inert>
                                <div class="gallery-card__preview">
                                    <StoryNode story={first} />
                                </div>
                            </div>
                            <div class="gallery-card__body">
                                <h3 class="gallery-card__title text-subheading">
                                    <a href={`/gallery/${component.id}/`}>
                                        {component.title}
                                    </a>
                                </h3>
                                {component.description && (
                                    <p class="gallery-card__description text-body-sm">
                                        {component.description}
                                    </p>
                                )}
                                <p class="gallery-card__meta text-meta">
                                    <span>
                                        {plural(
                                            storyCount(component),
                                            "story",
                                            "stories",
                                        )}
                                    </span>
                                    {origin(component) === "site" && (
                                        <Badge
                                            variant="outline"
                                            tone="secondary"
                                            size="sm"
                                        >
                                            site only
                                        </Badge>
                                    )}
                                </p>
                            </div>
                        </li>
                    );
                })}
            </ul>
        </section>
    ))}
    <p class="gallery-index__empty" hidden>
        No component matches that. Try fewer words, or clear the filter with
        Escape.
    </p>
</GalleryLayout>

<script>
// The filter: hides the cards that don't have every word typed, and the
// categories left empty, and says how many are left.
const filter = document.querySelector<HTMLElement>(".gallery-filter");
const input = filter?.querySelector("input");
const status = filter?.querySelector(".gallery-filter__status");
const empty = document.querySelector<HTMLElement>(".gallery-index__empty");
const cards = [...document.querySelectorAll<HTMLElement>("[data-search]")];
const categories = [
    ...document.querySelectorAll<HTMLElement>(".gallery-index__category"),
];

if (filter && input && status && empty) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const apply = () => {
        const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const card of cards) {
            const text = card.dataset.search ?? "";
            card.hidden = !words.every((word) => text.includes(word));
            if (!card.hidden) shown++;
        }
        for (const category of categories) {
            category.hidden = !category.querySelector(
                "[data-search]:not([hidden])",
            );
        }
        empty.hidden = shown > 0;
        // Said once typing stops, not at every key.
        clearTimeout(timer);
        timer = setTimeout(() => {
            status.textContent = words.length
                ? `${shown} of ${cards.length} components`
                : "";
        }, 400);
    };
    input.addEventListener("input", apply);
    input.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && input.value) {
            input.value = "";
            apply();
        }
    });
    // "/" from anywhere but a field jumps to the filter.
    document.addEventListener("keydown", (e) => {
        if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
        const target = e.target as HTMLElement;
        if (target.closest("input, textarea, select, [contenteditable]"))
            return;
        e.preventDefault();
        input.focus();
    });
    filter.hidden = false;
    // A value the browser kept from before going back
    if (input.value) apply();
}
</script>

<style>
.gallery-index__hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-block: var(--space-md) 0;

    h1,
    p {
        margin: 0;
    }
}

.gallery-index__intro {
    max-width: 60ch;
    color: var(--color-text-muted);
}

/* The filter's line under the intro, once its script has shown it. */
.gallery-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    margin-top: var(--space-sm);

    &[hidden] {
        display: none;
    }
}

.gallery-filter__input {
    flex: 1 1 16rem;
    max-width: 28rem;
}

.gallery-index__empty {
    margin: 0;
    color: var(--color-text-muted);
}

.gallery-index__category {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    &[hidden] {
        display: none;
    }
}

/* A full-strength heading on a solid rule, clear over the backdrop grid. */
.gallery-index__category-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border-strong);

    h2 {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        margin: 0;

        svg {
            color: var(--color-primary);
        }
    }

    p {
        margin: 0;
    }
}

.gallery-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
}

/* The whole card is the link: the title's ::after stretches over it. */
.gallery-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--border-color);
    border-radius: var(--radius);
    transition: border-color var(--transition);

    &:hover,
    &:focus-within {
        border-color: var(--color-primary);
    }

    &[hidden] {
        display: none;
    }
}

.gallery-card__anchor {
    position: absolute;
    top: 0;
}

/* A scaled-down preview, centred and cut to the card: a glimpse, not a working copy. */
.gallery-card__thumb {
    --thumb-scale: 0.7;

    position: relative;
    height: 8.5rem;
    background-color: var(--color-bg);
    background-image: radial-gradient(
        color-mix(in oklab, var(--color-text) 16%, transparent) 1px,
        transparent 1px
    );
    background-size: 12px 12px;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--border-color);
    contain: paint;
}

/* Full size, then scaled to fit, so it centres in the whole thumbnail. */
.gallery-card__preview {
    container-type: inline-size;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(100% / var(--thumb-scale));
    height: calc(100% / var(--thumb-scale));
    padding: var(--space-md);
    box-sizing: border-box;
    transform: scale(var(--thumb-scale));
    transform-origin: top left;
}

.gallery-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md) var(--space-md);

    p {
        margin: 0;
    }
}

.gallery-card__title {
    margin: 0;

    a {
        color: inherit;
        text-decoration: none;

        &:hover {
            color: var(--color-primary);
            background-color: transparent;
        }

        &::after {
            content: "";
            position: absolute;
            inset: 0;
        }
    }
}

.gallery-card__description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
}

.gallery-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: auto;
}
</style>
