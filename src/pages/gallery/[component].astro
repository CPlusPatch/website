---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Bench from "../../gallery/bench.svelte";
import type { BenchGroup } from "../../gallery/bench.ts";
import {
    categories,
    components,
    type GalleryComponent,
    origin,
    sourceOf,
    tagsOf,
} from "../../gallery/components.ts";
import DisplaySettings from "../../gallery/display-settings.astro";
import GalleryLayout from "../../gallery/gallery-layout.astro";
import GalleryMenu from "../../gallery/gallery-menu.astro";
import { storySource } from "../../gallery/source.ts";

/**
 * One component's page: its stories as a bench (bench.svelte), which has the
 * page's bar, with the links to the components either side of it.
 */
export const getStaticPaths = (() =>
    components.map((component, i) => ({
        params: { component: component.id },
        props: {
            component,
            previous: components[i - 1] as GalleryComponent | undefined,
            next: components[i + 1] as GalleryComponent | undefined,
        },
    }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { component, previous, next } = Astro.props;
const category = categories.find((c) => c.id === component.category);
const siblings = category?.components ?? [];
const sources = [...new Set(component.groups.map(sourceOf))];
// A component of several groups shows each group's tags with the group.
const [firstGroup] = component.groups;
const tags =
    component.groups.length > 1 || !firstGroup ? [] : tagsOf(firstGroup);
const stepTo = (c: GalleryComponent | undefined) =>
    c && { href: `/gallery/${c.id}/`, title: c.title };
// Plain data, since the bench is a Svelte island.
const groups: BenchGroup[] = component.groups.map((group) => ({
    id: group.id,
    title: group.title,
    tags: tagsOf(group),
    stories: group.stories.map((story) => ({
        name: story.name,
        tags: tagsOf(group, story),
        source: storySource(story),
    })),
}));
---

<GalleryLayout
    title={component.title}
    description={component.description ??
        `Stories for the ${component.title} component.`}
    current={component.id}
    bare
>
    <Bench
        client:load
        title={component.title}
        position={`${category?.title} · ${siblings.indexOf(component) + 1} of ${siblings.length}`}
        previous={stepTo(previous)}
        next={stepTo(next)}
        description={component.description}
        {sources}
        site={origin(component) === "site"}
        {tags}
        {groups}
    >
        <Fragment slot="actions">
            <GalleryMenu current={component.id} />
            <DisplaySettings collapseBelow="30rem" />
        </Fragment>
    </Bench>
</GalleryLayout>
