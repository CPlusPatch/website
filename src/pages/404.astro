---
import { Icon } from "astro-icon/components";
import Terminal from "../components/blocks/terminal/terminal.astro";
import { help } from "../components/blocks/terminal/terminal.ts";
import Footer from "../components/page/footer.astro";
import Button from "../components/ui/button.astro";
import Layout from "../layouts/base.astro";
---

<Layout title="Page not found" noindex canonical={false}>
    <main id="main" class="section not-found">
        <div class="container not-found__inner">
            <div class="not-found__intro">
                <h1>
                    Page <span class="accent">not found</span>.
                    <span class="not-found__headline">Nothing lives here.</span>
                </h1>
                <p class="lead">
                    This address doesn't lead anywhere. The site is a UI toolkit
                    showcase for now, so the gallery is the place to look.
                </p>
                <div class="not-found__actions">
                    <Button href="/gallery/" size="lg">
                        <Icon name="lucide:layout-grid" aria-hidden="true" />
                        Go to the gallery
                    </Button>
                    <Button href="/test/" size="lg" variant="outline">
                        <Icon name="lucide:house" aria-hidden="true" />
                        Front page
                    </Button>
                </div>
            </div>

            <Terminal
                interactive
                entries={[
                    {
                        command: "cd this-page",
                        output: "bash: cd: this-page: No such file or directory",
                    },
                    { command: "help", output: help() },
                ]}
            />
        </div>
    </main>
    <Footer />
</Layout>

<style>
/* Centred in the room above the footer. */
.not-found {
    display: flex;
    flex: 1;
    align-items: center;

    .not-found__inner {
        display: grid;
        gap: var(--space-xl);
        align-items: center;

        @container (min-width: 60rem) {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
            gap: var(--space-lg);
        }
    }

    .not-found__intro {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    /* Its own line, so the break falls between the sentences. */
    .not-found__headline {
        display: block;
    }

    .not-found__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
    }
}
</style>
