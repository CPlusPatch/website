---
/**
 * JesseOS: the site as a desktop, an experiment beside the front page.
 *
 * For now, every app is a plain section of one long page, which is also how
 * the page reads without JS. The window manager will turn the same sections
 * into windows (see `<Window>` in @cpluspatch/ui).
 */

import InteractiveMessage from "@cpluspatch/ui/astro/blocks/message/interactive-message.astro";
import Stat from "@cpluspatch/ui/astro/blocks/stat.astro";
import DisplayMenu from "@cpluspatch/ui/astro/sections/display/display-menu.astro";
import Button from "@cpluspatch/ui/astro/ui/button.astro";
import Window from "@cpluspatch/ui/astro/ui/window.astro";
import { Icon } from "astro-icon/components";
import Destructor from "../components/blocks/destructor.astro";
import Radio from "../components/blocks/radio/radio.astro";
import StatusBoard from "../components/blocks/status-board/status-board.astro";
import Terminal from "../components/blocks/terminal/terminal.astro";
import { neofetch, whoami } from "../components/blocks/terminal/terminal.ts";
import Letters from "../components/desktop/letters.astro";
import Projects from "../components/desktop/projects.astro";
import Readme from "../components/desktop/readme.astro";
import { chat, effects, figures } from "../data/home.ts";
import { radioTracks } from "../data/radio.ts";
import { status } from "../data/status.ts";
import verity from "../images/avatars/verity.png";
import Layout from "../layouts/desktop.astro";
---

<Layout
    title="Desktop"
    description="CPlusPatch's site as a desktop: projects, a terminal, the homelab's status and more, in windows."
    noindex
>
    <Fragment slot="head">
        {/* Lays the desktop out before the module runs, so the page doesn't jump. */}
        {/* Same width as DESKTOP in the module script below. */}
        <script is:inline>
        if (matchMedia("(min-width: 760px)").matches) {
            document.documentElement.classList.add("wm");
        }
        </script>
    </Fragment>

    <header class="desk-bar">
        <h1 class="desk-bar__brand">JesseOS</h1>
        <a class="desk-bar__home" href="/">Back to the site</a>
        <DisplayMenu id="display" {effects} size="sm" />
    </header>

    <main id="main" class="desk window-manager">
        <Readme />

        <Window
            id="w-terminal"
            title="Terminal"
            path="guest@cpluspatch.com"
            icon="lucide:terminal"
            open
        >
            <Terminal
                interactive
                entries={[
                    { command: "whoami", output: whoami() },
                    { command: "neofetch", output: neofetch() },
                ]}
            />
        </Window>

        <Projects />

        <Window
            id="w-monitor"
            title="Monitor"
            path="homelab"
            icon="lucide:activity"
        >
            <p class="lead">
                What I self-host, and whether it's up right now. Lately, it has
                been{" "}
                <Stat
                    inline
                    {...figures.uptime}
                    tone="success"
                    class="desk__uptime"
                />
                {" "}of the time.
            </p>
            <StatusBoard {...status}>Live from Prometheus</StatusBoard>
            <Button href="/status/" variant="outline" class="desk__more">
                <Icon name="lucide:activity" aria-hidden="true" />
                Full status page
            </Button>
        </Window>

        <Letters />

        <Window id="w-radio" title="Radio" path="~/music" icon="lucide:music">
            <Radio
                tracks={radioTracks}
                name="CPlusPatch FM"
                style="max-block-size: 36rem"
            />
        </Window>

        <Window
            id="w-chat"
            title="Chat"
            path="Verity"
            icon="lucide:message-circle"
        >
            <InteractiveMessage tree={chat} author="Verity" avatar={verity} />
        </Window>

        <Window id="w-toys" title="Toys" path="~/toys" icon="lucide:joystick">
            <div class="desk__toy">
                <p>Pick up the gravity gun, then click anything on the page.</p>
                <Destructor />
            </div>
        </Window>
    </main>
</Layout>

<script>
// The page-wide easter eggs Verity's chat runs.
import "../components/page/dialogue-actions.ts";

import { initWindowManager } from "@cpluspatch/ui/behaviours/window-manager.ts";

// Wide enough for windows. Also in the inline script in the <head>.
const DESKTOP = "(min-width: 760px)";

const desk = document.querySelector<HTMLElement>(".desk");
const wide = matchMedia(DESKTOP);
let stop: (() => void) | undefined;

// Also crossing the width after load, like rotating a tablet.
const sync = () => {
    if (!desk) return;

    if (wide.matches) {
        document.documentElement.classList.add("wm");
        stop = initWindowManager(desk);
    } else {
        stop?.();
        stop = undefined;
        document.documentElement.classList.remove("wm");
    }
};

sync();
wide.addEventListener("change", sync);
</script>

<style>
.desk-bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: min(100% - 2 * var(--space-md), 46rem);
    margin-inline: auto;
    padding-block: var(--space-md);
    border-bottom: var(--border-width) solid var(--color-border);

    .desk-bar__brand {
        margin: 0 auto 0 0;
        font: var(--type-wordmark);
        letter-spacing: normal;
    }

    .desk-bar__home {
        font: var(--type-ui);
    }

    /* A 44px hit area around the 28px button. */
    :global(.dropdown__trigger) {
        position: relative;

        &::before {
            content: "";
            position: absolute;
            inset-block: -0.5rem;
            inset-inline: 0;
        }
    }
}

/* One column of apps, like a long README, until the window manager runs. */
.desk {
    flex: 1;
    width: min(100% - 2 * var(--space-md), 46rem);
    margin-inline: auto;
    padding-bottom: var(--space-xl);

    .desk__toy {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: var(--space-md);
    }

    :global(.desk__uptime) {
        font-weight: 600;
    }

    .desk__more {
        margin-top: var(--space-md);
    }
}

/* With room for windows: the desk fills the screen under the bar. */
:global(html.wm body) {
    height: 100dvh;
    overflow: hidden;
}

:global(html.wm) .desk-bar {
    flex: none;
    width: 100%;
    margin-inline: 0;
    padding-inline: var(--space-md);
}

:global(html.wm) .desk {
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    background-color: var(--color-bg);
    /* The same gap to the desk's edges as the bar's text, so windows line up with the header. */
    --window-margin: var(--space-md);

    /*
     * Until the window manager runs, so a failed script still leaves every
     * window reachable. It sets overflow: clip, which this must not beat.
     */
    &:not(.window-manager--on) {
        overflow: auto;
    }

    /* Only once windows are on it: until then the page keeps its padding. */
    &.window-manager--on {
        padding-bottom: 0;
    }
}
</style>
