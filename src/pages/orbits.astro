---
/** The Orrery: a 3D model of the solar system, the Moon and the ISS. */

import Icon from "@cpluspatch/ui/astro/icon.astro";
import DisplayMenu from "@cpluspatch/ui/astro/sections/display/display-menu.astro";
import Button from "@cpluspatch/ui/astro/ui/button.astro";
import Dropdown from "@cpluspatch/ui/astro/ui/dropdown.astro";
import "@cpluspatch/orrery/styles.css";
import { effects } from "../data/home.ts";
import Layout from "../layouts/desktop.astro";

const actions = [
    { action: "reset", label: "Reset", icon: "lucide:rotate-ccw" },
    { action: "import", label: "Import JSON", icon: "lucide:upload" },
    { action: "export", label: "Export JSON", icon: "lucide:download" },
    { action: "copy-link", label: "Copy share link", icon: "lucide:link" },
];
---

<Layout
    title="Orbits"
    description="An interactive model of the solar system, the Moon and the International Space Station."
    noindex
>
    <main id="main">
        <h1 class="visually-hidden">Orbits</h1>
        <div class="orrery">
            <div class="orrery__canvas"></div>
            <noscript>
                <p class="orrery__notice">
                    Turn on JavaScript to see the Orrery.
                </p>
            </noscript>
            <div class="orrery__panel orrery__panel--top" hidden>
                <Dropdown
                    id="scenario"
                    label="Scenario"
                    icon="lucide:orbit"
                    title="Scenario"
                    size="sm"
                >
                    <div class="orrery__menu">
                        {actions.map(({ action, label, icon }) => (
                            <Button
                                class="orrery__menu-item"
                                variant="ghost"
                                tone="neutral"
                                data-orrery-action={action}
                            >
                                <Icon name={icon} aria-hidden="true" />
                                {label}
                            </Button>
                        ))}
                    </div>
                    <input
                        type="file"
                        accept=".json,application/json"
                        data-orrery-file
                        hidden
                    >
                </Dropdown>
                <DisplayMenu id="display" {effects} size="sm" />
            </div>
            <div class="orrery__panel orrery__panel--left" hidden></div>
            <div class="orrery__panel orrery__panel--right" hidden></div>
            <div class="orrery__panel orrery__panel--bottom" hidden></div>
        </div>
    </main>
</Layout>

<script>
import { loadOrrery } from "../lib/orrery.ts";

const root = document.querySelector<HTMLElement>(".orrery");
if (root) await loadOrrery(root);
</script>
