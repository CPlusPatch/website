---
/** The Orrery: a 3D model of the solar system, the Moon and the ISS. */

import { Font } from "astro:assets";
import { Orrery } from "@cpluspatch/orrery";
import "@cpluspatch/orrery/styles.css";
import Layout from "../layouts/desktop.astro";
---

<Layout
    title="Orbits"
    description="An interactive model of the solar system, the Moon and the International Space Station."
    noindex
    image={{
        path: "/og-orbits.png",
        alt: "Saturn and its rings, with the labelled orbits of Mimas, Enceladus, Tethys and Dione around it, over a starry sky.",
    }}
>
    <Fragment slot="head">
        <Font
            cssVariable="--font-plex-sans-condensed"
            preload={[{ subset: "latin" }]}
        />
        <Font cssVariable="--font-plex-mono" />
        <noscript>
            <style is:inline>
            /* One element more than the library's rule, which comes later. */
            main .orrery .orrery__loading {
                display: none;
            }
            </style>
        </noscript>
    </Fragment>
    <main id="main">
        <h1 class="visually-hidden">Orbits</h1>
        <div class="orrery">
            <div class="orrery__loading" role="status">
                <p class="orrery__loading-text">
                    <span class="orrery__loading-stage">Loading orbits</span>
                    <!-- Hidden, so a screen reader hears each stage once, not each file. -->
                    <span
                        class="orrery__loading-count"
                        aria-hidden="true"
                    ></span>
                </p>
                <progress
                    class="orrery__loading-bar"
                    max="1"
                    aria-label="Loading"
                ></progress>
            </div>
            <noscript>
                <p class="orrery__notice">
                    Turn on JavaScript to see the orbits.
                </p>
            </noscript>
            <Orrery client:only="svelte" />
        </div>
    </main>
</Layout>

<script>
const root = document.querySelector<HTMLElement>(".orrery");

// Orrery shows this itself when its startup throws, so this covers a chunk that won't load.
root?.addEventListener("astro:hydration-error", () => {
    const text = root.querySelector(".orrery__loading-text");
    if (text) {
        text.textContent =
            "Orbits couldn't load. Reload the page to try again.";
    }
    root.querySelector(".orrery__loading-bar")?.remove();
});
</script>
