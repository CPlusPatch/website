---
import ContactMethods from "../components/page/contact-methods.astro";
import Footer from "../components/page/footer.astro";
import Header from "../components/page/header.astro";
import Inbox from "../components/page/inbox/inbox.astro";
import Section from "../components/sections/section.astro";
import Layout from "../layouts/base.astro";
---

<Layout
    title="Contact"
    description="Send me an anonymous message, or reach me through Matrix, Email or Signal."
>
    <Header current="/contact" />
    <main id="main" class="contact">
        <ContactMethods />
        <Section id="inbox" title="Inbox" alt>
            <p class="contact__blurb">
                You can send a message here and it will show up on my phone,
                plus in the live feed so you can talk to other people on the
                site.
            </p>
            <Inbox />
        </Section>
    </main>
    <Footer />
</Layout>

<style>
.contact {
    flex: 1;
}

.contact__blurb {
    margin-block: var(--space-sm) var(--space-lg);
    /* On the alternate background, where several themes' muted text falls
       under 4.5:1. */
    color: var(--color-text);
}
</style>
