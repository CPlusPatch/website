---
import Footer from "@cpluspatch/ui/astro/sections/footer.astro";
import { friends } from "../../data/friends.ts";
import { socials } from "../../data/home.ts";
import jessew from "../../images/88x31s/jessew.png";
import FooterBranding from "./footer-branding.astro";
import FooterFriend from "./footer-friend.astro";
---

<Footer
    copyright={{ license: "AGPL-3.0", holder: "CPlusPatch" }}
    tagline={"This was a triumph\nI'm making a note here\nHuge success"}
    {socials}
>
    <FooterBranding
        slot="branding"
        image={jessew}
        alt="A badge linking to this website"
    />
    {friends.map((friend) => (
        <FooterFriend
            slot="friends"
            image={friend.image}
            href={friend.href}
            alt={`A small icon representing ${friend.name}'s website`}
        />
    ))}
</Footer>

<style>
/* Room below the copyright for the music and smiley buttons in the corners. */
:global(.footer) {
    padding-bottom: calc(var(--control-height-lg) + var(--space-lg));
}
</style>
