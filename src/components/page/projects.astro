---
import CardGrid from "@cpluspatch/ui/astro/blocks/card-grid.astro";
import MediaCard from "@cpluspatch/ui/astro/blocks/media-card.astro";
import Section from "@cpluspatch/ui/astro/sections/section.astro";
import { projects } from "../../data/home.ts";
---

<Section id="projects" title="Projects" alt>
    <CardGrid>
        {projects.map(({ body, ...project }) => (
            <MediaCard {...project}>
                <p>{body}</p>
            </MediaCard>
        ))}
    </CardGrid>
</Section>
