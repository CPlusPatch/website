---
import Icon from "@cpluspatch/ui/astro/icon.astro";
import Section from "@cpluspatch/ui/astro/sections/section.astro";
import Button from "@cpluspatch/ui/astro/ui/button.astro";
import {
    otherProjects,
    ownLinks,
    versia,
    versiaParts,
} from "../../data/home.ts";
import Shot from "../blocks/shot.astro";
import FlaviArt from "./flavi-art.astro";

// Drawn rather than captured: Flavi is gone
const art: Record<string, typeof FlaviArt> = { Flavi: FlaviArt };
---

<Section id="projects" title="Things I've made" alt>
    <div class="projects">
        {/*
            Versia is most of the work, so it leads as one piece with its
            parts under it, and the rest follow as a list, not equal cards
        */}
        <article class="versia" aria-labelledby="versia-title">
            <Shot
                src={versia.shots.dark}
                light={versia.shots.light}
                alt={versia.shots.alt}
                widths={[640, 1280]}
                sizes="(min-width: 64rem) 36rem, 100vw"
            />
            <div class="versia__intro">
                <h3 id="versia-title" class="versia__title">{versia.title}</h3>
                <p class="lead">{versia.body}</p>
                <ul class="links">
                    {versia.links.map((link) => (
                        <li>
                            <Button
                                href={link.href}
                                size="sm"
                                variant="outline"
                            >
                                <Icon name={link.icon} aria-hidden="true" />
                                {link.label}
                            </Button>
                        </li>
                    ))}
                </ul>
            </div>
            <ul class="versia__parts">
                {versiaParts.map(({ title, body, links }) => (
                    <li class="part">
                        <h4 class="part__title">{title}</h4>
                        <p class="part__body">{body}</p>
                        <ul class="links links--quiet">
                            {ownLinks(links).map((link) => (
                                <li>
                                    <Button
                                        href={link.href}
                                        size="sm"
                                        variant="ghost"
                                        tone="neutral"
                                    >
                                        <Icon
                                            name={link.icon}
                                            aria-hidden="true"
                                        />
                                        {link.label}
                                        <span class="visually-hidden">
                                            , {title}
                                        </span>
                                    </Button>
                                </li>
                            ))}
                        </ul>
                    </li>
                ))}
            </ul>
        </article>

        <ul class="others">
            {otherProjects.map(({ title, body, header, links = [] }) => (
                <li class="other">
                    {art[title] ? (
                        <Shot>
                            <FlaviArt />
                        </Shot>
                    ) : (
                        header && (
                            <Shot
                                src={header.src}
                                light={header.light}
                                widths={[320, 640]}
                                sizes="12rem"
                            />
                        )
                    )}
                    <div class="other__text">
                        <h3 class="other__title">{title}</h3>
                        <p class="other__body">{body}</p>
                    </div>
                    <ul class="links links--quiet other__links">
                        {links.map((link) => (
                            <li>
                                <Button
                                    href={link.href}
                                    size="sm"
                                    variant="ghost"
                                    tone="neutral"
                                >
                                    <Icon name={link.icon} aria-hidden="true" />
                                    {link.label}
                                    <span class="visually-hidden">
                                        , {title}
                                    </span>
                                </Button>
                            </li>
                        ))}
                    </ul>
                </li>
            ))}
        </ul>
    </div>
</Section>

<style>
.projects {
    container-type: inline-size;

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin: 0;
        padding: 0;
        list-style: none;

        /* Ghost buttons have no edge: line the first label up with the text */
        &.links--quiet {
            margin-top: auto;

            li:first-child {
                margin-inline-start: calc(-1 * (var(--space-sm) + 1px));
            }
        }
    }

    /* Screenshot and intro side by side once there's room, the parts under */
    .versia {
        display: grid;
        gap: var(--space-lg);
        align-items: start;

        @container (min-width: 56rem) {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        }

        .versia__intro {
            display: flex;
            align-self: center;
            flex-direction: column;
            gap: var(--space-md);

            /* A step under the section title, in its face */
            .versia__title {
                margin: 0;
                font:
                    var(--weight-display)
                    calc(var(--font-size-4xl) * var(--display-scale)) /
                    var(--leading-poster) var(--font-display);
            }

            .lead {
                margin: 0;
            }
        }

        .versia__parts {
            display: grid;
            grid-column: 1 / -1;
            gap: var(--space-md) var(--space-lg);
            margin: 0;
            padding: 0;
            list-style: none;

            @container (min-width: 36rem) {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            @container (min-width: 60rem) {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        /* Ruled like the stack and the reviews: a line above, no box */
        .part {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            padding-top: var(--space-md);
            border-top: var(--border-width) solid var(--border-color);

            .part__title {
                margin: 0;
                font: var(--type-body-strong);
            }

            .part__body {
                margin: 0;
                color: var(--color-text-muted);
            }

            /* Apart from the text, even under the longest */
            .links {
                padding-top: var(--space-sm);
            }
        }
    }

    .others {
        display: grid;
        margin: var(--space-xl) 0 0;
        padding: 0;
        list-style: none;
        border-bottom: var(--border-width) solid var(--border-color);

        /* Thumbnail, text and links in a row; links under the text when narrow */
        .other {
            display: grid;
            grid-template-columns: 6rem minmax(0, 1fr);
            gap: var(--space-xs) var(--space-md);
            align-items: start;
            padding-block: var(--space-md);
            border-top: var(--border-width) solid var(--border-color);

            @container (min-width: 48rem) {
                grid-template-columns: 10rem minmax(0, 1fr) 14rem;
                align-items: center;
            }

            .other__text {
                display: flex;
                flex-direction: column;
                gap: var(--space-xs);

                .other__title {
                    margin: 0;
                    font: var(--type-body-strong);
                }

                .other__body {
                    margin: 0;
                    color: var(--color-text-muted);
                }
            }

            .other__links {
                grid-column: 2;
                margin-top: 0;

                @container (min-width: 48rem) {
                    grid-column: auto;
                }
            }
        }
    }
}
</style>
