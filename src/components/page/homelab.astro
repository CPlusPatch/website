---
import { Icon } from "astro-icon/components";
import { status } from "../../data/status.ts";
import StatusBoard from "../blocks/status-board/status-board.astro";
import Section from "../sections/section.astro";
import Button from "../ui/button.astro";
---

<Section
    id="homelab"
    class="wash"
    title="My homelab"
    align="center"
    style="--wash-at: 50% 60%"
>
    <p class="lead">What I self-host, and whether it's up right now.</p>
    <StatusBoard {...status} style="max-width: 48rem">
        Live from Prometheus
    </StatusBoard>
    <Button href="/status/" variant="outline" class="homelab__more">
        <Icon name="lucide:activity" aria-hidden="true" />
        Full status page
    </Button>
</Section>

<style>
.homelab__more {
    margin-top: var(--space-md);
}
</style>
