---
import { contact, effects, navLinks } from "../../data/home.ts";
import DisplayMenu from "../sections/display/display-menu.astro";
import Navbar from "../sections/navbar.astro";
---

<Navbar
    sticky
    title="Jesse"
    links={navLinks}
    finalLink={{ href: contact, label: "Contact" }}
>
    <DisplayMenu
        slot="actions"
        id="display"
        {effects}
        size="sm"
        collapseBelow="48rem"
    />
</Navbar>
