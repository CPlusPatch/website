---
import Masonry from "@cpluspatch/ui/astro/blocks/masonry.astro";
import Quote from "@cpluspatch/ui/astro/blocks/quote.astro";
import Section from "@cpluspatch/ui/astro/sections/section.astro";
import { reviews } from "../../data/home.ts";

// The first review is featured across the full width. A long one there
// keeps it from stretching one column of the wall far past the others.
const [featured, ...rest] = reviews;
---

<Section id="reviews" title="Nice things people said" alt>
    <div class="reviews">
        {featured && (
            <Quote author={featured.author} featured>
                <p>{featured.body}</p>
            </Quote>
        )}
        <Masonry>
            {rest.map((review) => (
                <Quote author={review.author}>
                    <p>{review.body}</p>
                </Quote>
            ))}
        </Masonry>
    </div>
</Section>

<style>
/* A gap, not a margin, which Quote's own margin reset would outrank. */
.reviews {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);

    /*
     * Quotes on the page rather than in boxes: a rule above each one, like
     * the stack's groups, instead of a panel around it.
     */
    :global(.quote) {
        padding: var(--space-md) 0 0;
        background: none;
        border: 0;
        border-top: var(--border-width) solid var(--border-color);
        border-radius: 0;
    }

    :global(.quote__author) {
        padding-top: 0;
        border-top: 0;
    }

    /* The one pulled out, a size up and set off by a heavier rule */
    :global(.quote--featured) {
        padding-block: var(--space-lg);
        border-top-width: 2px;
        border-top-color: var(--color-primary);
    }

    :global(.quote--featured .quote__body) {
        max-inline-size: 62ch;
    }
}
</style>
