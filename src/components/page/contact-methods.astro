---
import Section from "@cpluspatch/ui/astro/sections/section.astro";
import { contactNote, socials } from "../../data/home.ts";
import ContactMethod from "../blocks/contact-method.astro";
---

<Section id="methods" aria-label="Ways to contact me">
    <h1 class="text-poster">Contact</h1>
    <p class="methods__blurb">{contactNote}</p>
    <div class="methods__grid">
        {socials.map((social) => <ContactMethod {...social} />)}
    </div>
</Section>

<style>
.methods__blurb {
    margin-block: var(--space-md) var(--space-lg);
    color: var(--color-text-muted);
}

/* One column, then two by two, then all four across. */
.methods__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);

    @container (min-width: 36rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @container (min-width: 52rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}
</style>
