---
import Heatmap from "@cpluspatch/ui/astro/blocks/heatmap/heatmap.astro";
import Stat from "@cpluspatch/ui/astro/blocks/stat.astro";
import Section from "@cpluspatch/ui/astro/sections/section.astro";
import { commits, figures } from "../../data/home.ts";
---

{/* The figures are the title: a sentence, read in order, not cards compared */}
<Section id="stats" aria-labelledby="stats-title" alt>
    <h2 id="stats-title" class="page-section__title stats__title">
        {/* Spaced explicitly: the build drops whitespace beside components */}
        <Stat inline {...figures.years} />{" "}years writing software, over{" "}
        <Stat inline {...figures.lines} />{" "}lines of code, pushed in{" "}
        <Stat inline {...figures.commits} />{" "}commits.
    </h2>

    <div class="commits panel">
        <h3 class="commits__title">{commits.title}</h3>
        <Heatmap {...commits.heatmap}>
            <span>Conway's Game of Life, seeded from the graph.</span>
        </Heatmap>
    </div>
</Section>

<style>
.stats__title {
    max-width: 22ch;

    .stat {
        font-variant-numeric: tabular-nums;
        color: var(--tone);
    }
}

.commits {
    width: 100%;
    margin-top: var(--space-md);
    padding: var(--space-lg) var(--space-md) var(--space-md);

    .commits__title {
        margin-bottom: var(--space-md);
    }
}
</style>
