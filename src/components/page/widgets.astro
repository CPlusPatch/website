---
import { chat, radioTracks } from "../../data/home.ts";
import verity from "../../images/avatars/verity.png";
import InteractiveMessage from "../blocks/message/interactive-message.astro";
import Radio from "../blocks/radio/radio.astro";
import CornerWindow from "../ui/corner-window.astro";
---

{/* Opposite corners, so the two buttons never overlap. */}
<CornerWindow
    id="music"
    label="Music"
    title="Now playing"
    icon="lucide:music"
    corner="start"
    variant="outline"
    tone="neutral"
>
    <Radio tracks={radioTracks} name="Jesse FM" framed={false} />
</CornerWindow>

<CornerWindow
    id="chat"
    label="Chat with Verity"
    icon="lucide:face-slightly-smiling"
>
    <InteractiveMessage tree={chat} author="Verity" avatar={verity} />
</CornerWindow>

<script>
// The page-wide easter eggs Verity's chat runs.
import "./dialogue-actions.ts";
</script>
