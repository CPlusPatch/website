---
import InteractiveMessage from "@cpluspatch/ui/astro/blocks/message/interactive-message.astro";
import CornerWindow from "@cpluspatch/ui/astro/ui/corner-window.astro";
import { chat } from "../../data/home.ts";
import { radioTracks } from "../../data/radio.ts";
import verity from "../../images/avatars/verity.png";
import Radio from "../blocks/radio/radio.astro";
---

{/* Opposite corners, so the two buttons never overlap. */}
<CornerWindow
    id="music"
    label="Music"
    title="Now playing"
    icon="lucide:music"
    corner="start"
    variant="outline"
    tone="neutral"
>
    <Radio tracks={radioTracks} name="CPlusPatch FM" framed={false} />
</CornerWindow>

<CornerWindow
    id="chat"
    label="Chat with Verity"
    icon="lucide:face-slightly-smiling"
>
    <InteractiveMessage tree={chat} author="Verity" avatar={verity} />
</CornerWindow>

<script>
// The page-wide easter eggs Verity's chat runs.
import "./dialogue-actions.ts";
</script>
