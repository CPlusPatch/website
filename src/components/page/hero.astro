---
import BlueprintFrame from "@cpluspatch/ui/astro/blocks/blueprint-frame.astro";
import IconList from "@cpluspatch/ui/astro/ui/icon-list.astro";
import { details, intro } from "../../data/home.ts";
import Terminal from "../blocks/terminal/terminal.astro";
import { neofetch, whoami } from "../blocks/terminal/terminal.ts";
---

<section class="section hero wash" aria-labelledby="hero-title">
    <div class="container hero__inner">
        <div class="hero__intro">
            <h1 id="hero-title" class="text-poster">
                Hi,{" "}
                <span class="hero__line">
                    I'm <span class="accent">CPlusPatch</span>.
                </span>{" "}
                <span class="hero__line">{intro.headline}</span>
            </h1>
            <p class="lead">
                {intro.lead}{" "}
                The terminal takes commands: try <code>help</code>.
            </p>
            <IconList items={details} />
        </div>

        <BlueprintFrame>
            <Terminal
                interactive
                entries={[
                    { command: "whoami", output: whoami() },
                    { command: "neofetch", output: neofetch() },
                ]}
            />
        </BlueprintFrame>
    </div>
</section>

<style>
/*
 * As tall as its content plus some air, not the whole screen, so the next
 * section's heading is already in view on a tall display.
 */
/* The wash of the accent sits behind the terminal. */
.hero {
    --wash-at: 72% 50%;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    min-block-size: min(
        36rem,
        100svh -
        var(--header-height) -
        var(--control-height-lg)
    );

    .hero__inner {
        display: grid;
        flex: 1;
        gap: var(--space-xl);
        align-items: center;

        @container (min-width: 60rem) {
            /* Even, so each line fits */
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: var(--space-lg);
        }
    }

    .hero__intro {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        container: hero-intro / inline-size;

        /*
         * On the smallest phones, a little smaller, so each line
         * still fits.
         */
        @container hero-intro (max-width: 20rem) {
            .text-poster {
                font-size: min(
                    calc(var(--font-size-6xl) * var(--display-scale)),
                    14cqi
                );
            }
        }
    }

    /* A line each, so the breaks fall between the greeting and sentences. */
    .hero__line {
        display: block;
    }
}
</style>
