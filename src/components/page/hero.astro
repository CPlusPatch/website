---
import BlueprintFrame from "@cpluspatch/ui/astro/blocks/blueprint-frame.astro";
import IconList from "@cpluspatch/ui/astro/ui/icon-list.astro";
import { details } from "../../data/home.ts";
import Terminal from "../blocks/terminal/terminal.astro";
import { neofetch, whoami } from "../blocks/terminal/terminal.ts";
---

<section class="section hero wash" aria-labelledby="hero-title">
    <div class="container hero__inner">
        <div class="hero__intro">
            <h1 id="hero-title">
                Hi, I'm <span class="accent">CPlusPatch</span>.
                <span class="hero__headline">I like computers.</span>
            </h1>
            <p class="lead">
                I study engineering, run too many servers, and care a lot about
                making good software. Poke at the terminal or scroll down.
            </p>
            <IconList items={details} />
        </div>

        <BlueprintFrame>
            <Terminal
                interactive
                entries={[
                    { command: "whoami", output: whoami() },
                    { command: "neofetch", output: neofetch() },
                ]}
            />
        </BlueprintFrame>
    </div>
</section>

<style>
/*
 * As tall as its content plus some air, not the whole screen, so the next
 * section's heading is already in view on a tall display.
 */
/* The wash of the accent sits behind the terminal. */
.hero {
    --wash-at: 72% 50%;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    min-block-size: min(
        36rem,
        100svh -
        var(--header-height) -
        var(--control-height-lg)
    );

    .hero__inner {
        display: grid;
        flex: 1;
        gap: var(--space-xl);
        align-items: center;

        @container (min-width: 60rem) {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
            gap: var(--space-lg);
        }
    }

    .hero__intro {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    /* Its own line, so the break falls between the sentences. */
    .hero__headline {
        display: block;
    }
}
</style>
