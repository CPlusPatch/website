---
import type { Tone } from "@cpluspatch/ui/lib/tone.ts";
import type { HTMLAttributes } from "astro/types";

export type BadgeVariant = "solid" | "outline" | "ghost";

export type BadgeSize = "sm" | "default" | "lg";

interface Props extends HTMLAttributes<"span"> {
    variant?: BadgeVariant;
    tone?: Tone;
    size?: BadgeSize;
}

const {
    variant = "solid",
    tone = "primary",
    size = "default",
    class: className,
    ...rest
} = Astro.props;
---

<span
    class:list={[
        "badge",
        `badge--${variant}`,
        `tone-${tone}`,
        `badge--size-${size}`,
        className,
    ]}
    data-snap
    {...rest}
>
    <slot />
</span>
