---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

export type AvatarSize = "sm" | "default" | "lg";

/**
 * A square profile picture. The initials of `alt` sit underneath the image,
 * so they show while it loads and stand in for it when `src` is omitted.
 */
interface Props extends HTMLAttributes<"div"> {
    src?: ImageMetadata;
    /** The person's name. Also the source of the fallback initials. */
    alt: string;
    size?: AvatarSize;
}

const { src, alt, size = "default", class: className, ...rest } = Astro.props;

// First and last word only, so long names don't overflow the box.
const words = alt.split(/\s+/).filter(Boolean);
const initials = [words[0], words.length > 1 ? words.at(-1) : undefined]
    .map((word) => word?.[0] ?? "")
    .join("")
    .toUpperCase();
---

{/* The box carries the name, so it reads the same with or without an image. */}
<div
    class:list={["avatar", `avatar--size-${size}`, className]}
    role="img"
    aria-label={alt}
    {...rest}
>
    <span class="avatar__initials" aria-hidden="true">{initials}</span>
    {src && (
        <Image
            class="avatar__image"
            src={src}
            alt=""
            width={128}
            height={128}
            loading="lazy"
        />
    )}
</div>

<style>
.avatar {
    --avatar-size: 2.5rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--avatar-size);
    height: var(--avatar-size);
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    /* Initials scale with the avatar, not with the type scale. */
    font-size: calc(var(--avatar-size) * 0.4);
    font-weight: 600;
    line-height: 1;
    user-select: none;

    &.avatar--size-sm {
        --avatar-size: 1.75rem;
    }

    &.avatar--size-lg {
        --avatar-size: 4rem;
    }

    .avatar__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}
</style>
