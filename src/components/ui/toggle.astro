---
import type { HTMLAttributes } from "astro/types";

/**
 * A switch built on a native checkbox, so it works and submits without JS.
 * Visible text, if any, goes in the default slot and sits after the switch.
 */
interface Props extends HTMLAttributes<"label"> {
    /**
     * Accessible name. Without slot text it is the only name the switch has;
     * with slot text, keep the two the same.
     */
    label: string;
    checked?: boolean;
    disabled?: boolean;
    name?: string;
    value?: string;
}
const {
    label,
    checked = false,
    disabled = false,
    name,
    value,
    class: className,
    ...rest
} = Astro.props;

const hasText = Astro.slots.has("default");
---

<label class:list={["toggle", hasText && "toggle--text", className]} {...rest}>
    {/* A range, because Biome reports this on the `role` line, not the element. */}
    {/* biome-ignore-start lint/a11y/useAriaPropsForRole: A native checkbox exposes its own checked state, so the switch role needs no aria-checked */}
    <input
        type="checkbox"
        role="switch"
        aria-label={label}
        class="toggle__input"
        checked={checked}
        disabled={disabled}
        name={name}
        value={value}
    >
    {/* biome-ignore-end lint/a11y/useAriaPropsForRole: see above */}
    <span class="toggle__slider" aria-hidden="true"></span>
    {/* Hidden from assistive tech: the input's aria-label already says it. */}
    {hasText && (
        <span class="toggle__text text-ui" aria-hidden="true">
            <slot />
        </span>
    )}
</label>

<style>
.toggle {
    --toggle-width: 2.75rem;
    --toggle-height: 1.5rem;
    --toggle-knob: calc(var(--toggle-height) - 0.375rem);
    position: relative;
    display: inline-block;
    user-select: none;
    cursor: pointer;

    /* The input covers the whole label, so the text is clickable too. */
    &.toggle--text {
        display: inline-flex;
        align-items: center;
        gap: var(--space-sm);
    }

    .toggle__input {
        position: absolute;
        inset: 0;
        margin: 0;
        opacity: 0;
        cursor: pointer;
    }

    .toggle__slider {
        position: relative;
        display: block;
        width: var(--toggle-width);
        height: var(--toggle-height);
        border: var(--border-width) solid var(--color-border-strong);
        border-radius: var(--radius);
        background: var(--color-bg-alt);
        transition:
            background-color var(--transition),
            border-color var(--transition),
            box-shadow var(--transition);

        &::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0.1875rem;
            width: var(--toggle-knob);
            height: var(--toggle-knob);
            border-radius: var(--radius);
            background: var(--color-primary);
            box-shadow:
                0 0 0 1px rgb(0 0 0 / 0.04),
                0 1px 0 rgb(0 0 0 / 0.06);
            transform: translateY(-50%);
            transition:
                transform var(--transition),
                background-color var(--transition);
        }
    }

    /* Coarse pointers: grow the hit area without growing the switch. */
    @media (pointer: coarse) {
        &::after {
            content: "";
            position: absolute;
            inset: -0.5rem;
        }
    }

    .toggle__input:hover + .toggle__slider {
        border-color: var(--color-primary);
    }

    .toggle__input:active:where(:not(:disabled)) + .toggle__slider {
        translate: 0 1px;
    }

    .toggle__input:focus-visible + .toggle__slider {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
    }

    .toggle__input:checked + .toggle__slider {
        background: var(--color-primary);
        border-color: var(--color-primary);

        &::before {
            background: var(--color-on-accent);
            transform: translate(
                calc(var(--toggle-width) - var(--toggle-height)),
                -50%
            );
        }
    }

    .toggle__input:disabled + .toggle__slider,
    .toggle__input[aria-disabled="true"] + .toggle__slider {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .toggle__input:checked:hover + .toggle__slider {
        background: var(--color-primary-hover);
        border-color: var(--color-primary-hover);
    }

    /*
     * Forced colours drop background colours, which would erase the knob, so
     * spell the states out with system colours.
     */
    @media (forced-colors: active) {
        .toggle__slider {
            background: Canvas;
            border-color: ButtonText;

            &::before {
                background: ButtonText;
            }
        }

        .toggle__input:hover + .toggle__slider {
            border-color: Highlight;
        }

        .toggle__input:checked + .toggle__slider,
        .toggle__input:checked:hover + .toggle__slider {
            background: Highlight;
            border-color: Highlight;

            &::before {
                background: HighlightText;
            }
        }
    }
}
</style>
