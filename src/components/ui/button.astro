---
import type { HTMLAttributes } from "astro/types";
import type { Tone } from "../../lib/tone.ts";

export type ButtonVariant = "solid" | "outline" | "ghost" | "link";

/** `neutral` is for chrome that should not compete with content. */
export type ButtonTone = Tone | "neutral";

/**
 * `icon-sm` is a compact square, for actions inside a row or under content;
 * `icon-lg` a larger one, for a control that stands alone.
 */
export type ButtonSize =
    | "sm"
    | "default"
    | "lg"
    | "icon"
    | "icon-sm"
    | "icon-lg";

/**
 * Renders an <a> when `as="a"` or an `href` is given, otherwise a <button>.
 * Choose the element by what the control does (navigate vs. act); `variant`
 * only changes how it looks, so a `link`-variant button is still a <button>.
 */
type Props = Omit<HTMLAttributes<"button">, "type"> &
    Omit<HTMLAttributes<"a">, "type"> & {
        /** Force the element. Defaults to "a" when `href` is set, else "button". */
        as?: "button" | "a";
        type?: "button" | "submit" | "reset";
        variant?: ButtonVariant;
        tone?: ButtonTone;
        size?: ButtonSize;
        /**
         * Opt in to the hover lift (see `.lift` in utilities.css). Ignored
         * for the `link` variant. Turn off for buttons inside a ButtonGroup.
         */
        lift?: boolean;
    };

const {
    as,
    type,
    variant = "solid",
    tone = "primary",
    size = "default",
    lift = true,
    class: className,
    ...rest
} = Astro.props;

const isAnchor = as === "a" || (as === undefined && Boolean(rest.href));

const classes = [
    "button",
    lift && variant !== "link" && "lift",
    `button--${variant}`,
    `tone-${tone}`,
    `button--size-${size}`,
    className,
];
---

{isAnchor ? (
    <a class:list={classes} {...rest}>
        <slot />
    </a>
) : (
    <button type={type ?? "button"} class:list={classes} {...rest}>
        <slot />
    </button>
)}

<style>
.button {
    --button-color: var(--tone);
    --button-color-hover: var(--tone-hover);
    --shadow-color: var(--button-color);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--control-height-md);
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font: var(--type-label);
    text-decoration: none;
    color: var(--color-on-accent);
    background-color: var(--button-color);
    border: 1px solid var(--button-color);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
        background-color var(--transition),
        border-color var(--transition),
        color var(--transition),
        box-shadow var(--transition),
        translate var(--transition);

    svg {
        width: 1.2em;
        height: 1.2em;
        margin-bottom: 0.1em;
        flex: none;
    }

    &.button--outline,
    &.button--ghost,
    &.button--link {
        color: var(--button-color);
        background-color: transparent;
    }

    &.button--ghost,
    &.button--link {
        border-color: transparent;
    }

    /* Sizes change only the label's size (see typography.css). */
    &.button--size-sm {
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-xs);
        height: var(--control-height-sm);
    }

    &.button--size-lg {
        padding: var(--space-sm) var(--space-md-lg);
        font-size: var(--font-size-base);
        height: var(--control-height-lg);
    }

    &.button--size-icon,
    &.button--size-icon-sm,
    &.button--size-icon-lg {
        width: var(--control-height-md);
        height: var(--control-height-md);
        padding: 0;

        svg {
            margin-bottom: 0;
        }
    }

    &.button--size-icon-sm {
        width: var(--control-height-sm);
        height: var(--control-height-sm);
    }

    &.button--size-icon-lg {
        width: var(--control-height-lg);
        height: var(--control-height-lg);
        font-size: var(--font-size-base);
    }

    &:hover {
        background-color: var(--button-color-hover);
        border-color: var(--button-color-hover);
        color: var(--color-on-accent);

        &.button--outline,
        &.button--ghost,
        &.button--link {
            color: var(--color-on-accent);
            border-color: var(--button-color-hover);
        }

        &.button--link {
            color: var(--button-color-hover);
            background-color: transparent;
            border-color: transparent;
            text-decoration: underline;
        }
    }

    /*
     * A toggle holding two icons shows the first while not pressed and the
     * second while pressed, like play and pause. Global, as the icons come
     * from the caller's slot and carry its scope rather than this one.
     */
    &[aria-pressed] > :global(:nth-child(2)),
    &[aria-pressed="true"] > :global(:first-child:not(:only-child)) {
        display: none;
    }

    &[aria-pressed="true"] > :global(:nth-child(2)) {
        display: block;
    }

    &:active:where(:not(:disabled, [aria-disabled="true"])) {
        translate: 0 1px;
    }

    &:disabled,
    &[aria-disabled="true"] {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }
}
</style>
