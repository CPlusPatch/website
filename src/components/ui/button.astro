---
import {
    type ButtonSize,
    type ButtonTone,
    type ButtonVariant,
    buttonClasses,
    isAnchor as linkRequested,
} from "@cpluspatch/ui/components/button.ts";
import type { HTMLAttributes } from "astro/types";

export type { ButtonSize, ButtonTone, ButtonVariant };

/**
 * Renders an <a> when `as="a"` or an `href` is given, otherwise a <button>.
 * Choose the element by what the control does (navigate vs. act); `variant`
 * only changes how it looks, so a `link`-variant button is still a <button>.
 */
type Props = Omit<HTMLAttributes<"button">, "type"> &
    Omit<HTMLAttributes<"a">, "type"> & {
        /** Force the element. Defaults to "a" when `href` is set, else "button". */
        as?: "button" | "a";
        type?: "button" | "submit" | "reset";
        variant?: ButtonVariant;
        tone?: ButtonTone;
        size?: ButtonSize;
        /**
         * Opt in to the hover lift (see `.lift` in utilities.css). Ignored
         * for the `link` variant. Turn off for buttons inside a ButtonGroup.
         */
        lift?: boolean;
    };

const {
    as,
    type,
    variant = "solid",
    tone = "primary",
    size = "default",
    lift = true,
    class: className,
    ...rest
} = Astro.props;

const isAnchor = linkRequested(as, rest.href);

const classes = buttonClasses({ variant, tone, size, lift, class: className });
---

{isAnchor ? (
    <a class:list={classes} {...rest}>
        <slot />
    </a>
) : (
    <button type={type ?? "button"} class:list={classes} {...rest}>
        <slot />
    </button>
)}
