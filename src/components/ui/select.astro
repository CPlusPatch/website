---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"select"> {
    /** Accessible name. Selects have no visible label of their own. */
    label: string;
    options: {
        value: string;
        label: string;
    }[];
    value?: string;
}

const { label, options, value, class: className, ...rest } = Astro.props;
---

<select class:list={["select", className]} aria-label={label} {...rest}>
    {options.map((option) => (
        <option
            class="select__option"
            value={option.value}
            selected={option.value === value}
        >
            {option.label}
        </option>
    ))}
</select>

<style>
.select {
    --select-chevron: var(--color-text-muted);
    appearance: none;
    height: var(--control-height-md);
    padding: var(--space-xs) calc(var(--space-md) + 1.25rem) var(--space-xs)
        var(--space-sm);
    font: var(--type-ui);
    color: var(--color-text);
    background-color: var(--color-surface);
    /* Chevron drawn from two gradients so it follows the theme colours */
    background-image:
        linear-gradient(45deg, transparent 50%, var(--select-chevron) 50%),
        linear-gradient(135deg, var(--select-chevron) 50%, transparent 50%);
    background-position:
        calc(100% - 1.125rem) 50%,
        calc(100% - 0.75rem) 50%;
    background-size: 0.375rem 0.375rem;
    background-repeat: no-repeat;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
        border-color var(--transition),
        box-shadow var(--transition);

    &:hover {
        border-color: var(--color-primary);
        --select-chevron: var(--color-primary);
    }

    &:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
    }

    &:active:not(:disabled) {
        background-color: var(--color-bg-alt);
    }

    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @media (forced-colors: active) {
        /* Otherwise the gradient chevron is dropped. */
        forced-color-adjust: none;
        --select-chevron: ButtonText;
        color: ButtonText;
        background-color: Canvas;
        border-color: ButtonText;

        &:hover {
            --select-chevron: Highlight;
            border-color: Highlight;
        }
    }

    .select__option {
        color: var(--color-text);
        background-color: var(--color-surface);
    }
}
</style>
