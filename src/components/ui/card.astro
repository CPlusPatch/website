---
import type { HTMLAttributes } from "astro/types";
import type { Tone } from "../../lib/tone.ts";

interface Props extends HTMLAttributes<"div"> {
    tone?: Tone;
    /**
     * Opt in to the hover lift (see `.lift` in utilities.css). The effect
     * itself only shows while it is enabled site-wide.
     */
    lift?: boolean;
}

const {
    tone = "primary",
    lift = true,
    class: className,
    ...rest
} = Astro.props;
---

<div
    class:list={["card", "panel", lift && "lift", `tone-${tone}`, className]}
    data-snap
    {...rest}
>
    <slot />
</div>

<style>
/*
 * Surface, border, top rule and hover lift all come from .panel / .lift in
 * utilities.css. Tone colours come from .tone-* there too. This file only owns content layout.
 */
.card {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: var(--space-md);
    width: 100%;

    & p {
        color: var(--color-text-muted);
    }

    & a {
        align-self: flex-start;
        font-size: var(--font-size-sm);
    }
}
</style>
