---
import type { Tone } from "@cpluspatch/ui/lib/tone.ts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    tone?: Tone;
    /**
     * Opt in to the hover lift (see `.lift` in utilities.css). The effect
     * itself only shows while it is enabled site-wide.
     */
    lift?: boolean;
}

const {
    tone = "primary",
    lift = true,
    class: className,
    ...rest
} = Astro.props;
---

<div
    class:list={["card", "panel", lift && "lift", `tone-${tone}`, className]}
    data-snap
    {...rest}
>
    <slot />
</div>
