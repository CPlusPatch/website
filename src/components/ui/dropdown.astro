---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Button, { type ButtonTone, type ButtonVariant } from "./button.astro";

/**
 * A button that opens a panel of anything in the default slot. Built on the
 * native popover attribute, so it opens, closes on Esc or an outside click,
 * and returns focus without JS.
 *
 * Anchored under its button where CSS anchor positioning is supported, and
 * centred on screen elsewhere. A tall panel scrolls within the space it has.
 * Following an in-page link inside it closes it (a line of script), so a
 * menu of anchors doesn't sit over the section it jumped to.
 */
interface Props extends HTMLAttributes<"div"> {
    /** Unique on the page: ties the button to its panel (which gets this id). */
    id: string;
    /** The button's text. */
    label: string;
    /** Shown before the label. */
    icon?: string;
    /** Heading inside the panel, with a close button beside it. */
    title?: string;
    /** Which edge of the button the panel lines up with. */
    align?: "start" | "end";
    variant?: ButtonVariant;
    tone?: ButtonTone;
}

const {
    id,
    label,
    icon,
    title,
    align = "start",
    variant = "outline",
    tone = "neutral",
    class: className,
    ...rest
} = Astro.props;
---

<div class:list={["dropdown", className]} {...rest}>
    <Button
        class="dropdown__trigger"
        {variant}
        {tone}
        lift={false}
        popovertarget={id}
    >
        {icon && <Icon name={icon} aria-hidden="true" />}
        <span class="dropdown__label">{label}</span>
        <Icon
            name="lucide:chevron-down"
            class="dropdown__chevron"
            aria-hidden="true"
        />
    </Button>

    <div
        class:list={["dropdown__panel", `dropdown__panel--align-${align}`]}
        {id}
        popover
    >
        {title && (
            <div class="dropdown__header">
                <p class="dropdown__title text-label">{title}</p>
                <Button
                    size="icon"
                    variant="ghost"
                    tone="neutral"
                    lift={false}
                    popovertarget={id}
                    popovertargetaction="hide"
                    aria-label={`Close ${title}`}
                >
                    <Icon name="lucide:x" aria-hidden="true" />
                </Button>
            </div>
        )}
        <slot />
    </div>
</div>

<style>
.dropdown {
    display: inline-block;

    /*
     * Button lifts its icons by 0.05em (margin-bottom: 0.1em), which leaves
     * the chevron visibly high beside the label; centre them here instead.
     */
    .dropdown__trigger svg {
        margin-bottom: 0;
    }

    /* Follows the button's own text colour, so it suits every variant. */
    .dropdown__chevron {
        opacity: 0.75;
        transition: rotate var(--transition);
    }

    &:has(.dropdown__panel:popover-open) .dropdown__chevron {
        rotate: 180deg;
    }

    .dropdown__panel {
        width: min(20rem, 100vw - 2 * var(--space-md));
        margin: 0;
        padding: var(--space-md);
        color: var(--color-text);
        background-color: var(--color-surface-raised);
        border: var(--border-width) solid var(--color-border-strong);
        border-radius: var(--radius);
        box-shadow: 0 var(--space-sm) var(--space-lg) rgb(0 0 0 / 0.2);
        /* Within the space around the button (or the viewport, centred). */
        max-height: calc(100% - var(--space-md));
        overflow-y: auto;
        overscroll-behavior: contain;

        &:popover-open {
            display: flex;
            flex-direction: column;
            gap: var(--space-md);
        }

        /* Under the button where anchor positioning exists; centred otherwise. */
        @supports (position-area: bottom) {
            margin-top: var(--space-xs);
            position-try-fallbacks: flip-block;

            &.dropdown__panel--align-start {
                position-area: bottom span-right;
            }

            &.dropdown__panel--align-end {
                position-area: bottom span-left;
            }
        }

        @supports not (position-area: bottom) {
            margin: auto;
        }
    }

    .dropdown__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-block: calc(var(--space-xs) * -1);
    }

    .dropdown__title {
        margin: 0;
    }
}
</style>

<script>
// Close the panel once an in-page link inside it has been followed.
document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest?.('a[href^="#"]');
    const panel = link?.closest<HTMLElement>(".dropdown__panel:popover-open");
    panel?.hidePopover();
});
</script>
