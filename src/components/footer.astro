---
import { Icon } from "astro-icon/components";
import Badge88x31 from "./badge-88x31.astro";
import Button from "./button.astro";

interface Props {
    copyright: {
        license: string;
        holder: string;
    };
    /** Line breaks (`\n`) are kept as written. */
    tagline?: string;
    socials?: {
        name: string;
        href: string;
        icon: string;
    }[];
    /**
     * This site's own badge. It links to its own image as a download, so
     * visitors can grab it to link back.
     */
    badge88x31: {
        image: ImageMetadata;
        alt?: string;
    };
    friends?: {
        image: ImageMetadata;
        href: string;
        alt?: string;
    }[];
}

const { copyright, tagline, socials, badge88x31, friends } = Astro.props;
---

<footer class="footer">
    <div class="footer__content">
        {tagline && <p class="footer__tagline">{tagline}</p>}
        {socials && socials.length > 0 && (
            <ul class="footer__socials">
                {socials.map((social) => (
                    <li>
                        <a
                            href={social.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${social.name} (opens in new tab)`}
                        >
                            <Icon name={social.icon} aria-hidden="true" />
                        </a>
                    </li>
                ))}
            </ul>
        )}
        <div class="footer__branding">
            <Badge88x31
                image={badge88x31.image}
                href={badge88x31.image.src}
                alt={badge88x31.alt}
                download
                class="footer__badge"
            />
            <Button
                size="icon"
                variant="link"
                download
                href="/alt.txt"
                aria-label="Download the alt text"
            >
                <Icon name="lucide:captions" aria-hidden="true" />
            </Button>
        </div>
    </div>
    <hr>
    <div class="footer__copyright">
        &copy; {copyright.holder} {new Date().getFullYear()}. Licensed under
        {copyright.license}.
    </div>
    <div class="footer__friends">
        {friends && friends.length > 0 && (
            <ul class="footer__friends-list">
                {friends.map((friend) => (
                    <li>
                        <Badge88x31
                            image={friend.image}
                            href={friend.href}
                            alt={friend.alt}
                            class="footer__friend"
                        />
                    </li>
                ))}
            </ul>
        )}
    </div>
</footer>

<style>
.footer {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-surface);
    border-top: var(--border-width) solid var(--border-color);

    & > :global(*) {
        max-width: 80rem;
        width: 100%;
    }

    .footer__content {
        display: flex;
        flex-direction: row;
        align-items: center;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-lg);
        margin-bottom: var(--space-md);

        .footer__tagline {
            font-size: var(--font-size-sm);
            color: var(--color-text-muted);
            /* Keeps the tagline's \n line breaks */
            white-space: pre;
        }

        .footer__branding {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: var(--space-sm);

            .footer__badge {
                width: 88px;
                height: 31px;
            }
        }

        .footer__socials {
            display: flex;
            gap: var(--space-sm);
            list-style: none;
            padding: 0;

            li {
                filter: grayscale(100%);
                transition: filter 0.3s ease;

                &:hover,
                &:focus-within {
                    filter: grayscale(0%);
                }

                a {
                    color: var(--color-text);
                    font-size: var(--font-size-2xl);

                    &:hover,
                    &:focus-visible {
                        color: var(--color-primary);
                    }
                }
            }
        }
    }

    .footer__copyright {
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
    }

    .footer__friends {
        .footer__friends-list {
            display: grid;
            width: 100%;
            grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
            gap: var(--space-xs);
        }
    }
}
</style>
