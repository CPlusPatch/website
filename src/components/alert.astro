---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"div"> {
	icon?: string;
	variant?: "default" | "warning" | "destructive";
}

const { icon, variant, ...rest } = Astro.props;
---

<div class:list={["alert", icon && "alert--icon", variant && `alert--${variant}`, rest.class]} {...rest}>
	{icon && <Icon name={icon} class="icon" />}
	<div class="content">
		<slot />
	</div>
</div>

<style>
.alert {
	display: grid;
	grid-template-columns: 1fr;
	width: 100%;
	gap: var(--space-md);
	padding: var(--space-md);
	background-color: var(--color-surface);
	border: var(--border);
	border-top: 2px solid var(--color-primary);
	border-radius: var(--radius);
	transition:
		border-color var(--transition),
		box-shadow var(--transition),
		translate var(--transition);

	&.alert--icon {
		grid-template-columns: auto 1fr;
		align-items: center;

		.icon {
			width: 1.25rem;
			height: 1.25rem;
			color: var(--color-primary);
		}
	}

	&:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow);
		translate: calc(var(--shadow-offset) * -1)
			calc(var(--shadow-offset) * -1);
	}

	&.alert--warning {
		border-top-color: var(--color-warning);
		
		&:hover {
			border-color: var(--color-warning);
			box-shadow: var(--shadow-offset) var(--shadow-offset) 0
				var(--color-warning);
		}

		.icon {
			color: var(--color-warning);
		}
	}

	&.alert--destructive {
		border-top-color: var(--color-destructive);
		
		&:hover {
			border-color: var(--color-destructive);
			box-shadow: var(--shadow-offset) var(--shadow-offset) 0
				var(--color-destructive);
		}

		.icon {
			color: var(--color-destructive);
		}
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 0;
		
		h3 {
			margin-bottom: 0;
			font-weight: 600;
		}

		p {
			color: var(--color-text-muted);
		}
	}
}
</style>
