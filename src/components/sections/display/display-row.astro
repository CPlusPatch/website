---
import type { HTMLAttributes } from "astro/types";
import Kbd from "../../ui/kbd.astro";

/**
 * One setting in the Display menu: an optional label, the control in the
 * default slot, and, with a `key`, its Alt+Shift shortcut (see
 * lib/shortcuts.ts) and a hint for it. The label is for sight only: give the
 * control its own accessible name.
 */
interface Props extends HTMLAttributes<"div"> {
    label?: string;
    /** A letter, pressed with Alt+Shift to click the control. */
    key?: string;
    /** Only on a fine pointer, for a control whose effect can't show on touch. */
    fine?: boolean;
}

const { label, key, fine, class: className, ...rest } = Astro.props;
---

<div
    class:list={["display-row", className]}
    data-shortcut={key?.toUpperCase()}
    data-fine={fine || undefined}
    {...rest}
>
    {label && (
        <span class="display-row__label text-ui" aria-hidden="true">
            {label}
        </span>
    )}
    <slot />
    {key && <Kbd class="display-key">{key.toUpperCase()}</Kbd>}
</div>
