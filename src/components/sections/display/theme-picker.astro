---
import type { HTMLAttributes } from "astro/types";
import { THEMES } from "../../../styles/themes/index.ts";

/**
 * Every theme as a swatch: a radio named "theme", checked to switch to it.
 * Each theme's stylesheet keys off the checked radio in [data-theme-select]
 * via :has(), so it works without JS. Group it in a fieldset with a legend.
 */
type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class:list={["theme-picker", className]} data-theme-select {...rest}>
    {THEMES.map(({ value, label }) => (
        <label class="theme-picker__swatch text-ui">
            <input
                class="visually-hidden"
                type="radio"
                name="theme"
                {value}
                checked={value === "default"}
            >
            <span
                class="theme-picker__preview"
                data-theme-preview={value}
                aria-hidden="true"
            >
                <span></span>
                <span></span>
                <span></span>
            </span>
            {label}
        </label>
    ))}
</div>

<style>
.theme-picker {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs);

    .theme-picker__swatch {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        min-width: 0;
        padding: var(--space-xs) var(--space-sm) var(--space-xs) var(--space-xs);
        color: var(--color-text-muted);
        white-space: nowrap;
        border: var(--border-width) solid transparent;
        border-radius: var(--radius);
        cursor: pointer;
        transition:
            color var(--transition),
            background-color var(--transition),
            border-color var(--transition);

        &:hover {
            color: var(--color-text);
            background-color: var(--color-bg-alt);
        }

        &:has(:checked) {
            color: var(--color-text);
            border-color: var(--color-border-strong);
        }

        &:has(:focus-visible) {
            outline: 2px solid var(--color-primary);
            outline-offset: 2px;
        }
    }

    /*
     * The theme's background, with its primary, secondary and text colours
     * on it. data-theme-preview gives it that theme's tokens, in the page's
     * light or dark.
     */
    .theme-picker__preview {
        display: inline-flex;
        flex-shrink: 0;
        gap: 2px;
        padding: 4px;
        background-color: var(--color-bg);
        border: var(--border-width) solid var(--color-border);
        border-radius: var(--radius);

        span {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
        }

        span:nth-child(1) {
            background-color: var(--color-primary);
        }

        span:nth-child(2) {
            background-color: var(--color-secondary);
        }

        span:nth-child(3) {
            background-color: var(--color-text);
        }
    }

    @media (forced-colors: active) {
        .theme-picker__preview {
            forced-color-adjust: none;
        }

        .theme-picker__swatch:has(:checked) {
            border-color: Highlight;
        }
    }
}
</style>
