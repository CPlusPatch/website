---
import type { HTMLAttributes } from "astro/types";

/**
 * The navigation itself: <SidebarGroup>s of <SidebarLink>s, with a scroll
 * spy. <Sidebar> wraps it in a collapsible frame; use it bare to put the
 * same links somewhere else, such as in a <Dropdown>.
 *
 * Scrolls on its own once something caps its height, with the edges fading
 * where there is more to see. Links with a `section` light up while that
 * section is being read (the script below); without JS they are plain links.
 */
interface Props extends HTMLAttributes<"nav"> {
    /** Names the navigation for screen readers. */
    label: string;
}

const { label, class: className, ...rest } = Astro.props;
---

<nav class:list={["sidebar-nav", className]} aria-label={label} {...rest}>
    <slot />
</nav>

<script>
/*
 * Scroll spy. A link with data-section gets aria-current="location" while
 * its section is the one being read: the last whose top has passed a line a
 * third of the way down the viewport, or, once scrolled to the bottom, the
 * last one in view (short final sections never reach the line). Links the
 * page marked aria-current="page" are left alone.
 */
const LINE = 1 / 3;

const spies = [...document.querySelectorAll<HTMLElement>(".sidebar-nav")]
    .map((nav) => ({
        entries: [
            ...nav.querySelectorAll<HTMLAnchorElement>("a[data-section]"),
        ].flatMap((link) => {
            const section = document.getElementById(link.dataset.section ?? "");
            return section ? [{ link, section }] : [];
        }),
        active: null as HTMLAnchorElement | null,
    }))
    .filter((spy) => spy.entries.length > 0);

/** The nearest box the link scrolls within, short of the page itself. */
const scrollerOf = (link: HTMLElement) => {
    for (
        let el = link.parentElement;
        el && el !== document.body;
        el = el.parentElement
    ) {
        if (el.scrollHeight > el.clientHeight) {
            const { overflowY } = getComputedStyle(el);
            if (overflowY === "auto" || overflowY === "scroll") return el;
        }
    }
    return null;
};

/** Scrolls the nav (or whatever it sits in), never the page, to show the link. */
const reveal = (link: HTMLElement) => {
    const scroller = scrollerOf(link);
    if (!scroller) return;
    const box = scroller.getBoundingClientRect();
    const row = link.getBoundingClientRect();
    const pad = row.height * 2;
    if (row.top < box.top + pad) scroller.scrollTop -= box.top + pad - row.top;
    else if (row.bottom > box.bottom - pad)
        scroller.scrollTop += row.bottom - (box.bottom - pad);
};

let raf = 0;

function update() {
    raf = 0;
    const line = innerHeight * LINE;
    const atBottom =
        scrollY + innerHeight >= document.documentElement.scrollHeight - 2;

    for (const spy of spies) {
        // Read every position first, then write.
        const tops = spy.entries.map(
            ({ section }) => section.getBoundingClientRect().top,
        );
        let index = -1;
        tops.forEach((top, i) => {
            if (top <= line || (atBottom && top < innerHeight)) index = i;
        });
        const next = index >= 0 ? spy.entries[index].link : null;
        if (next === spy.active) continue;

        if (spy.active?.getAttribute("aria-current") === "location")
            spy.active.removeAttribute("aria-current");
        if (next && !next.hasAttribute("aria-current")) {
            next.setAttribute("aria-current", "location");
            reveal(next);
        }
        spy.active = next;
    }
}

const schedule = () => {
    if (!raf) raf = requestAnimationFrame(update);
};

if (spies.length) {
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule, { passive: true });
    update();
}
</script>
