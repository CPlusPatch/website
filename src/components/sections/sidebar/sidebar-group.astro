---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

/** A titled list of <SidebarLink>s inside a <Sidebar>. */
interface Props extends HTMLAttributes<"div"> {
    title: string;
    /** Shown before the title. */
    icon?: string;
}

const { title, icon, class: className, ...rest } = Astro.props;
---

<div class:list={["sidebar-group", className]} {...rest}>
    {/* The list's own label names it for screen readers, so this is visual only. */}
    <p class="sidebar-group__title text-label" aria-hidden="true">
        {icon && <Icon name={icon} class="sidebar-group__icon" />}
        {title}
    </p>
    <ul class="sidebar-group__list" aria-label={title}>
        <slot />
    </ul>
</div>
