---
import { Icon } from "astro-icon/components";
import Kbd from "../ui/kbd.astro";
import Toggle from "../ui/toggle.astro";

/**
 * A slim strip of switches for the page-wide effects, each with an
 * Alt+Shift shortcut. The switches are the same [data-*-toggle] hooks the
 * effects' CSS looks for, so they work without JS; the shortcuts and their
 * key hints need it, so the hints stay hidden until the script runs.
 */
interface Props {
    effects: {
        label: string;
        /** The effect's toggle hook, such as `data-scanlines-toggle`. */
        attr: string;
        /** A letter, pressed with Alt+Shift to flip the switch. */
        key: string;
        checked?: boolean;
        /** Hide the switch where the effect can't show, like the crosshair on touch. */
        fine?: boolean;
    }[];
}

const { effects } = Astro.props;
---

<div class="effects-bar">
    <fieldset class="effects-bar__inner">
        <legend class="effects-bar__title text-label">
            <Icon name="lucide:sparkles" aria-hidden="true" />
            Effects
        </legend>
        <div class="effects-bar__switches">
            {effects.map(({ label, attr, key, checked, fine }) => (
                <Toggle
                    class:list={[
                        "effects-bar__toggle",
                        fine && "effects-bar__toggle--fine",
                    ]}
                    {label}
                    {checked}
                    data-effect-key={key.toUpperCase()}
                    {...{ [attr]: true }}
                >
                    {label}
                    <Kbd
                        class="effects-bar__key"
                        keys={["Alt", "Shift", key.toUpperCase()]}
                    />
                </Toggle>
            ))}
        </div>
    </fieldset>
</div>

<style>
.effects-bar {
    width: 100%;
    color: var(--color-text-muted);
    background-color: var(--color-bg-alt);
    border-bottom: var(--border-width) solid var(--border-color);

    .effects-bar__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-xs) var(--space-md);
        width: 100%;
        max-width: var(--breakpoint-xl);
        min-height: var(--control-height-lg);
        margin: 0 auto;
        padding: var(--space-xs) var(--space-lg);

        @container (max-width: 48rem) {
            padding-inline: var(--space-md);
        }
    }

    /* Floated, which makes it a flex item in the row like the switches. */
    .effects-bar__title {
        float: left;
        display: inline-flex;
        align-items: center;
        gap: var(--space-xs);

        svg {
            color: var(--color-primary);
        }
    }

    .effects-bar__switches {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    /*
     * A size down from a settings panel's switch, to keep the strip slim.
     * :global() as these sit on Toggle's and Kbd's roots, which carry their
     * own scope.
     */
    :global(.effects-bar__toggle) {
        --toggle-width: 2rem;
        --toggle-height: 1.125rem;
        padding-inline: var(--space-md);

        &:not(:first-child) {
            border-inline-start: var(--border-width) solid var(--border-color);
        }

        &:last-child {
            padding-inline-end: 0;
        }
    }

    @media not ((hover: hover) and (pointer: fine)) {
        :global(.effects-bar__toggle--fine) {
            display: none;
        }
    }

    :global(.effects-bar__key) {
        display: none;
        /* Astro drops the space between the label and this. */
        margin-inline-start: var(--space-xs);
    }

    /*
     * Shortcuts need JS and a keyboard. The hints also need the room: below
     * that the shortcuts still work, unlabelled, so the strip stays one row.
     */
    &[data-shortcuts] :global(.effects-bar__key) {
        @media (hover: hover) and (pointer: fine) {
            @container (min-width: 60rem) {
                display: inline-flex;
            }
        }
    }

    @container (max-width: 30rem) {
        :global(.effects-bar__toggle) {
            padding-inline: var(--space-sm);
        }
    }
}
</style>

<script>
const switches = new Map<string, HTMLInputElement>();

for (const bar of document.querySelectorAll<HTMLElement>(".effects-bar")) {
    for (const toggle of bar.querySelectorAll<HTMLElement>(
        "[data-effect-key]",
    )) {
        const input = toggle.querySelector("input");
        const key = toggle.dataset.effectKey;
        if (!input || !key) continue;
        input.setAttribute("aria-keyshortcuts", `Alt+Shift+${key}`);
        // By physical key: on a Mac, Option+Shift+S types a symbol, not "S"
        switches.set(`Key${key}`, input);
    }
    bar.toggleAttribute("data-shortcuts", true);
}

document.addEventListener("keydown", (e) => {
    if (e.defaultPrevented || e.repeat || e.isComposing) return;
    if (!e.altKey || !e.shiftKey || e.ctrlKey || e.metaKey) return;

    const input = switches.get(e.code);
    // Hidden switches (the crosshair on touch) have nothing to show
    if (!input?.checkVisibility()) return;

    e.preventDefault();
    // A click, so it fires change like flipping it by hand
    input.click();
});
</script>
