---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Button from "../ui/button.astro";

interface Props extends HTMLAttributes<"header"> {
    title: string;
    links: {
        href: string;
        label: string;
        active?: boolean;
        external?: boolean;
    }[];
    finalLink?: {
        href: string;
        label: string;
        external?: boolean;
    };
    /** Stays at the top of the viewport as the page scrolls. */
    sticky?: boolean;
}

/*
 * The `actions` slot is for controls rather than links, like a settings
 * dropdown. They sit after the final link, and stay in the top row beside
 * the menu button on a narrow screen (give a dropdown collapseBelow="48rem"
 * to make it icon-only there).
 */
const hasActions = Astro.slots.has("actions");

const {
    title,
    links,
    finalLink,
    sticky = false,
    class: className,
    ...rest
} = Astro.props;
---

<header
    class:list={["navbar", sticky && "navbar--sticky", className]}
    {...rest}
>
    <div class="container">
        <a class="navbar__brand" href="/">
            <span class="navbar__brand-text text-subheading">{title}</span>
        </a>

        <label class="navbar__toggle">
            <input
                type="checkbox"
                class="navbar__toggle-input"
                data-navbar-toggle
                aria-label="Toggle navigation"
            >
            <Icon
                name="lucide:menu"
                class="navbar__toggle-icon navbar__toggle-icon--open"
                aria-hidden="true"
            />
            <Icon
                name="lucide:x"
                class="navbar__toggle-icon navbar__toggle-icon--close"
                aria-hidden="true"
            />
        </label>

        <div class="navbar__menu" data-navbar-menu>
            <div class="navbar__menu-inner">
                <nav class="navbar__nav">
                    {links.map((link) => (
                        <Button
                            class:list={[
                                "navbar__link",
                                link.active && "navbar__link--active",
                            ]}
                            as="a"
                            variant="link"
                            href={link.href}
                            aria-current={link.active ? "page" : undefined}
                        >
                            {link.label}
                            {link.external && (
                                <Icon
                                    name="lucide:external-link"
                                    aria-hidden="true"
                                />
                            )}
                        </Button>
                    ))}
                </nav>

                {finalLink && (
                    <Button
                        class="navbar__final-link"
                        as="a"
                        variant="outline"
                        size="sm"
                        href={finalLink.href}
                    >
                        {finalLink.label}
                        {finalLink.external && (
                            <Icon
                                name="lucide:external-link"
                                aria-hidden="true"
                            />
                        )}
                    </Button>
                )}
            </div>
        </div>

        {hasActions && (
            <div class="navbar__actions">
                <slot name="actions" />
            </div>
        )}
    </div>
</header>

<script>
// The checkbox keeps the menu working without JS; script only exposes its
// state, since aria-expanded can't follow :checked from CSS.
let nextId = 0;

for (const navbar of document.querySelectorAll<HTMLElement>(".navbar")) {
    const toggle = navbar.querySelector<HTMLInputElement>(
        "[data-navbar-toggle]",
    );
    const menu = navbar.querySelector<HTMLElement>("[data-navbar-menu]");
    if (!toggle || !menu) continue;

    menu.id ||= `navbar-menu-${nextId++}`;
    toggle.setAttribute("aria-controls", menu.id);

    const sync = () =>
        toggle.setAttribute("aria-expanded", String(toggle.checked));
    toggle.addEventListener("change", sync);
    sync();
}
</script>
