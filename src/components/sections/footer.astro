---
import { Icon } from "astro-icon/components";
import Badge88x31 from "../blocks/badge-88x31.astro";
import Button from "../ui/button.astro";

interface Props {
    copyright: {
        license: string;
        holder: string;
    };
    /** Line breaks (`\n`) are kept as written. */
    tagline?: string;
    socials?: {
        name: string;
        href: string;
        icon: string;
    }[];
    /**
     * This site's own badge. It links to its own image as a download, so
     * visitors can grab it to link back.
     */
    badge88x31: {
        image: ImageMetadata;
        alt?: string;
    };
    friends?: {
        image: ImageMetadata;
        href: string;
        alt?: string;
    }[];
}

const { copyright, tagline, socials, badge88x31, friends } = Astro.props;
---

<footer class="footer">
    <div class="footer__content">
        {tagline && <p class="footer__tagline text-body-sm">{tagline}</p>}
        {socials && socials.length > 0 && (
            <ul class="footer__socials">
                {socials.map((social) => (
                    <li>
                        <a
                            href={social.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${social.name} (opens in new tab)`}
                        >
                            <Icon name={social.icon} aria-hidden="true" />
                        </a>
                    </li>
                ))}
            </ul>
        )}
        <div class="footer__branding">
            <Badge88x31
                image={badge88x31.image}
                href={badge88x31.image.src}
                alt={badge88x31.alt}
                download
                class="footer__badge"
            />
            <Button
                size="icon"
                variant="link"
                download
                href="/alt.txt"
                aria-label="Download the alt text"
            >
                <Icon name="lucide:captions" aria-hidden="true" />
            </Button>
        </div>
    </div>
    <hr>
    {/* One string: Astro would drop the line break between "under" and the licence. */}
    <div class="footer__copyright text-body-sm">
        {`© ${copyright.holder} ${new Date().getFullYear()}. Licensed under ${copyright.license}.`}
    </div>
    <div class="footer__friends">
        {friends && friends.length > 0 && (
            <ul class="footer__friends-list">
                {friends.map((friend) => (
                    <li>
                        <Badge88x31
                            image={friend.image}
                            href={friend.href}
                            alt={friend.alt}
                            class="footer__friend"
                        />
                    </li>
                ))}
            </ul>
        )}
    </div>
</footer>
