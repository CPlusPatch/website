---
import { Icon } from "astro-icon/components";

/**
 * The playing track's cover, for <Radio>. A disc sits underneath, so it
 * shows while a cover loads and stands in for a missing one; it spins while
 * the radio plays.
 */
interface Props {
    /** An optimised image URL. */
    src?: string;
}

const { src } = Astro.props;
---

<div class="radio-cover">
    <Icon name="lucide:disc-3" aria-hidden="true" />
    <img
        src={src}
        alt=""
        width="160"
        height="160"
        hidden={!src}
        data-radio-cover
    >
</div>

<style>
.radio-cover {
    display: grid;
    place-items: center;
    flex: none;
    width: 4rem;
    aspect-ratio: 1;
    overflow: hidden;
    color: var(--tone);
    background-color: color-mix(
        in oklab,
        var(--tone) 12%,
        var(--color-surface-raised)
    );
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);

    > * {
        grid-area: 1 / 1;
    }

    svg {
        width: 2rem;
        height: 2rem;
    }

    /* Positioned, to stay over the disc while it spins. */
    img {
        position: relative;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    img[hidden] {
        display: none;
    }
}

/* Set on the <Radio> by its script. */
:global([data-playing]) .radio-cover svg {
    animation: radio-cover-spin 4s linear infinite;

    @media (prefers-reduced-motion: reduce) {
        animation: none;
    }
}

@keyframes radio-cover-spin {
    to {
        rotate: 1turn;
    }
}
</style>
