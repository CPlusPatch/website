---
import type { HTMLAttributes } from "astro/types";

/**
 * A grid of same-sized items, like project cards: one column, then two,
 * then three as the page widens. Whatever the count, a short last row is
 * centred rather than left hanging at the start.
 */
type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div class:list={["card-grid", className]} {...rest}>
    <slot />
</div>
