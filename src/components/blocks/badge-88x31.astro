---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

/**
 * A 88x31 web badge: a small image linking to a site, opened in a
 * new tab.
 */
interface Props extends HTMLAttributes<"a"> {
    href: string;
    image: ImageMetadata;
    alt?: string;
    /** Defaults to "pixelated" */
    rendering?: "pixelated" | "smooth";
}

const {
    href,
    image,
    alt,
    rendering = "pixelated",
    class: className,
    ...rest
} = Astro.props;
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={["badge-88x31 lift", className]}
    {...rest}
>
    <Image
        src={image}
        alt={alt ?? null}
        class="badge-88x31__image"
        style={{ imageRendering: rendering }}
    />
</a>

<style>
.badge-88x31 {
    display: inline-block;
    width: 88px;
    height: 31px;
    text-decoration: none;
    cursor: pointer;

    .badge-88x31__image {
        width: 100%;
        height: 100%;
    }
}
</style>
