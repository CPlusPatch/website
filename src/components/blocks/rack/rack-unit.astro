---
import type { RackUnit } from "./rack.ts";

/**
 * One unit in a <Rack>, which sets the metal, the lights and the sizes it
 * is drawn with. Its front depends on its kind: horizontal 2.5" drives and
 * a grille on a server, 3.5" drives on storage, sockets on a switch,
 * perforations on a blank.
 */
type Props = Required<Pick<RackUnit, "kind" | "height">> &
    Pick<RackUnit, "name" | "about">;

const { name, about, kind, height } = Astro.props;

// How many slots its front has: drives, or a switch's sockets
const slots = { server: 4, storage: height * 6, switch: 48, blank: 0 }[kind];
---

<li
    class:list={["unit", `unit--${kind}`]}
    style={`--height: ${height}`}
    data-unit={kind === "blank" ? undefined : name}
    aria-hidden={kind === "blank" ? "true" : undefined}
>
    <span class="unit__ear"></span>
    <span class="unit__face">
        {kind !== "blank" && (
            <>
                <span class="unit__lights" aria-hidden="true">
                    <span class="unit__button"></span>
                    <span class="unit__light unit__light--power"></span>
                    <span class="unit__light unit__light--activity"></span>
                </span>
                <span class="unit__tag">
                    <span class="unit__name">{name}</span>
                    {about && <span class="unit__about">{about}</span>}
                </span>
                <span class="unit__front" aria-hidden="true">
                    <span class="unit__slots">
                        {Array.from({ length: slots }, () => (
                            <span class="unit__slot">
                                <span class="unit__light"></span>
                            </span>
                        ))}
                    </span>
                    {kind === "server" && <span class="unit__grille"></span>}
                </span>
            </>
        )}
    </span>
    <span class="unit__ear"></span>
</li>

<style>
.unit {
    display: grid;
    grid-template-columns: var(--ear) minmax(0, 1fr) var(--ear);
    height: calc(var(--height) * var(--u));
    border-bottom: 2px solid var(--steel-hole);
}

/* Every chassis catches the light along its top and falls into shadow at its foot. */
.unit__ear,
.unit__face {
    box-shadow:
        inset 0 1px 0 var(--edge),
        inset 0 -0.375rem 0.375rem -0.25rem var(--shade);
}

/* Mounting ears, with a screw into the rail for every unit. */
.unit__ear {
    background:
        radial-gradient(
            circle,
            var(--steel-hole) 0.15rem,
            var(--steel-3) 0.17rem 0.24rem,
            transparent 0.26rem
        )
        center / 100% var(--u) repeat-y,
        linear-gradient(90deg, var(--steel-2), var(--steel-3), var(--steel-2));
}

.unit__face {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
    padding-inline: var(--pad);
    background: var(--metal), var(--steel-1);
    border-inline: 1px solid var(--steel-hole);
}

/* Perforated all over, like a vented blanking panel. */
.unit--blank .unit__face::before {
    content: "";
    flex: 1;
    align-self: stretch;
    margin-block: 0.4rem;
    background: var(--mesh);
}

.unit__lights {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.3rem;
}

.unit__button {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--steel-2);
    border: 1px solid var(--steel-3);
    border-radius: 50%;
}

.unit__light {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: currentColor;
    color: var(--led-power);
    opacity: 0.25;
}

.unit__light--power {
    opacity: 1;
    box-shadow: 0 0 0.3rem currentColor;
}

.unit__light--activity {
    color: var(--led-activity);
}

/* The unit's name, printed on a recessed strip of its front. */
.unit__tag {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 12rem;
    padding: 0.1rem 0.375rem;
    background: var(--steel-hole);
    border: 1px solid var(--steel-2);
    color: var(--print-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1.3;

    > * {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .unit__name {
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--print);
    }
}

/* Clipped at the start, so what's nearest the label goes first. */
.unit__front {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-sm);
    min-width: 0;
    height: 100%;
    overflow: hidden;
}

.unit__slots {
    display: flex;
    flex: none;
    gap: 2px;
}

/* A drive caddy on its side, with its light and latch: 2.5" in a server... */
.unit__slot {
    --latch: 0.5rem;
    display: flex;
    align-items: center;
    width: 1.75rem;
    height: 0.75rem;
    padding: 0 3px;
    background:
        linear-gradient(var(--steel-3), var(--steel-3)) right 3px center /
        var(--latch) 2px no-repeat,
        var(--metal),
        var(--steel-2);
    border: 1px solid var(--steel-hole);

    .unit__light {
        width: 0.2rem;
        height: 0.2rem;
    }
}

/* ...and 3.5" in storage, three to a column. */
.unit--storage .unit__slots {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    grid-auto-columns: 2.5rem;
    grid-auto-flow: column;
    height: calc(100% - 0.75rem);
}

.unit--storage .unit__slot {
    --latch: 0.75rem;
    width: auto;
    height: auto;
}

/* A hexagonal mesh over the fans. */
.unit__grille {
    flex: 1 1 0;
    min-width: 0;
    max-width: 10rem;
    height: calc(var(--u) - 0.75rem);
    background: var(--mesh), var(--steel-2);
    border: 1px solid var(--steel-hole);
}

/* A switch: two rows of sockets, each with its link light. */
.unit--switch .unit__slots {
    display: grid;
    grid-template-rows: repeat(2, 0.55rem);
    grid-auto-columns: 0.6rem;
    grid-auto-flow: column;
    gap: 3px 2px;
}

.unit--switch .unit__slot {
    width: auto;
    height: auto;
    align-items: flex-start;
    padding: 1px;
    background: black;
    border: 1px solid var(--steel-3);
    border-bottom-width: 2px;

    .unit__light {
        width: 0.15rem;
        height: 0.15rem;
        border-radius: 0;
    }
}

/*
 * The slots' lights flicker while traffic plays, each to its own rhythm:
 * steps of different primes, so neighbours rarely line up.
 */
:global(.rack[data-running]) .unit__slot .unit__light {
    animation: unit-flicker var(--flicker, 1.3s) steps(1, end) infinite
        var(--delay, 0s);
}

.unit__slot:nth-child(2n) {
    --flicker: 1.7s;
}

.unit__slot:nth-child(3n) {
    --flicker: 0.9s;
}

.unit__slot:nth-child(5n + 1) {
    --delay: -0.6s;
}

.unit__slot:nth-child(7n + 2) {
    --delay: -1.3s;
}

@keyframes unit-flicker {
    0%,
    55%,
    75% {
        opacity: 0.25;
    }

    60%,
    70%,
    85% {
        opacity: 1;
    }
}
</style>
