---
/**
 * An interactive terminal widget
 */

import { type Entry, promptFor } from "./terminal.ts";

interface Props {
    entries?: Entry[];
    cwd?: string;
    interactive?: boolean;
}
const { entries = [], cwd = "~", interactive = false } = Astro.props;
const prompt = promptFor(cwd);
---

<div
    class="terminal panel"
    role="log"
    aria-label="Terminal"
    data-terminal={interactive ? "" : undefined}
    style={`--prompt: ${JSON.stringify(prompt)}`}
>
    {entries.map(({ command, output }) => (
        <div class="terminal__pair">
            <div class="terminal__command">{command}</div>
            <div class="terminal__output">{output}</div>
        </div>
    ))}
    {interactive ? (
        <>
            {/* Row blueprint: markup inside carries Astro's scope attribute, so scoped CSS applies to clones */}
            <template>
                <div class="terminal__pair">
                    <div class="terminal__command"></div>
                    <div class="terminal__output"></div>
                </div>
            </template>
            <div class="terminal__input">
                <span class="terminal__prompt">{prompt}</span>
                <input
                    type="text"
                    class="terminal__input-field"
                    aria-label="Terminal command"
                    autocomplete="off"
                    spellcheck="false"
                />
            </div>
        </>
    ) : (
        <div class="terminal__input">
            <span class="terminal__prompt">{prompt}</span>
        </div>
    )}
</div>

<script>
import { initTerminals } from "@cpluspatch/ui/behaviours/terminal.ts";
import { run } from "./terminal.ts";

initTerminals(document, { run });
</script>
