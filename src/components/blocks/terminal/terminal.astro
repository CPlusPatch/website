---
/**
 * The site's terminal: the library's, with this site's prompt and commands.
 */

import Terminal from "@cpluspatch/ui/astro/blocks/terminal.astro";
import { type Entry, promptFor } from "./terminal.ts";

interface Props {
    entries?: Entry[];
    cwd?: string;
    interactive?: boolean;
}
const { entries = [], cwd = "~", interactive = false } = Astro.props;
---

<Terminal {entries} prompt={promptFor(cwd)} {interactive} />

<script>
import { initTerminals } from "@cpluspatch/ui/behaviours/terminal.ts";
import { run } from "./terminal.ts";

initTerminals(document, { run });
</script>
