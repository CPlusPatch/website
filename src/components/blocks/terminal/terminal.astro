---
/**
 * An interactive terminal widget
 */

import { type Entry, promptFor } from "./terminal.ts";

interface Props {
    entries?: Entry[];
    cwd?: string;
    interactive?: boolean;
}
const { entries = [], cwd = "~", interactive = false } = Astro.props;
const prompt = promptFor(cwd);
---

<div
    class="terminal panel"
    role="log"
    aria-label="Terminal"
    data-terminal={interactive ? "" : undefined}
    style={`--prompt: ${JSON.stringify(prompt)}`}
>
    {entries.map(({ command, output }) => (
        <div class="terminal__pair">
            <div class="terminal__command">{command}</div>
            <div class="terminal__output">{output}</div>
        </div>
    ))}
    {interactive ? (
        <>
            {/* Row blueprint: markup inside carries Astro's scope attribute, so scoped CSS applies to clones */}
            <template>
                <div class="terminal__pair">
                    <div class="terminal__command"></div>
                    <div class="terminal__output"></div>
                </div>
            </template>
            <div class="terminal__input">
                <span class="terminal__prompt">{prompt}</span>
                <input
                    type="text"
                    class="terminal__input-field"
                    aria-label="Terminal command"
                    autocomplete="off"
                    spellcheck="false"
                />
            </div>
        </>
    ) : (
        <div class="terminal__input">
            <span class="terminal__prompt">{prompt}</span>
        </div>
    )}
</div>

<style>
.terminal {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    max-height: 24rem;
    /* Lines keep their shape, like a real terminal: wide ones scroll sideways. */
    overflow: auto;
    padding: var(--space-md);
    font: var(--type-code);
    /* The characters as typed, as in Code: != shouldn't read as ≠. */
    font-variant-ligatures: none;
    transition: border-color var(--transition);

    /* The input has no outline of its own, so the whole frame shows focus. */
    &:focus-within {
        border-color: var(--color-primary);
    }

    .terminal__pair {
        display: flex;
        flex-direction: column;

        .terminal__command {
            color: var(--color-text);
            white-space: pre;

            &::before {
                content: var(--prompt);
                color: var(--color-primary);
            }
        }

        .terminal__output {
            color: var(--color-text-muted);
            white-space: pre;

            /*
             * A picture, from video.ts: a ▀ a cell, two square pixels
             * tall, both halves painted here rather than by the glyph,
             * whose shape depends on the fallback font that draws it.
             */
            &.terminal__screen {
                line-height: 0;

                .terminal__pixel {
                    display: inline-block;
                    vertical-align: top;
                    width: 1ch;
                    height: 2ch;
                    color: transparent;
                    background: linear-gradient(
                        to bottom,
                        var(--top, #000) 50%,
                        var(--bottom, #000) 50%
                    );
                }
            }
        }
    }

    .terminal__input {
        display: flex;
        align-items: baseline;
        gap: 1ch;

        .terminal__prompt {
            flex: none;
            color: var(--color-primary);
        }

        .terminal__input-field {
            flex: 1;
            min-width: 0;
            padding: 0;
            font: inherit;
            color: var(--color-text);
            caret-color: var(--color-primary);
            background: transparent;
            border: none;

            &:focus-visible {
                outline: none;
            }

            @media (pointer: coarse) {
                min-height: var(--control-height-md);
            }
        }
    }
}
</style>

<script>
import { CLEAR, run } from "./terminal.ts";

interface TerminalState {
    history: string[];
    cursor: number; // Index into history; history.length = live input
    draft: string; // In-progress input saved while browsing history
    stop?: () => void; // Stops the program still running (see Program in terminal.ts)
}

// Keyed by root element so multiple terminals on the page can have independent state
const states = new WeakMap<HTMLElement, TerminalState>();

const stateOf = (root: HTMLElement): TerminalState => {
    let state = states.get(root);
    if (!state) {
        // Seed from SSR'd rows so pre-rendered commands are navigable
        const history = Array.from(
            root.querySelectorAll(".terminal__command"),
            (el) => el.textContent ?? "",
        );
        state = {
            history,
            cursor: history.length,
            draft: "",
        };
        states.set(root, state);
    }
    return state;
};

/** Adds a row for the command, and returns its output, for a program to fill. */
const appendRow = (root: HTMLElement, command: string, output: string) => {
    const row = (
        root.querySelector<HTMLTemplateElement>(
            ":scope > template",
        ) as HTMLTemplateElement
    ).content.cloneNode(true) as DocumentFragment;
    (row.querySelector(".terminal__command") as HTMLElement).textContent =
        command;
    const outputElement = row.querySelector(".terminal__output") as HTMLElement;
    outputElement.textContent = output;
    (root.querySelector(".terminal__input") as HTMLElement).before(row);
    root.scrollTop = root.scrollHeight;
    return outputElement;
};

document.addEventListener("keydown", (e) => {
    if (e.isComposing) return;

    const field = e.target;
    if (!(field instanceof HTMLInputElement)) return;

    const root = field.closest<HTMLElement>("[data-terminal]");
    if (!root) return;

    const state = stateOf(root);

    // Like a shell: Ctrl+C stops what's running, rather than copying.
    if (e.ctrlKey && e.key === "c" && state.stop) {
        state.stop();
        state.stop = undefined;
        e.preventDefault();
        return;
    }

    switch (e.key) {
        case "Enter": {
            const command = field.value.trim();
            if (!command) return;
            field.value = "";

            state.stop?.();
            state.stop = undefined;
            const result = run(command);
            if (result === CLEAR) {
                for (const row of root.querySelectorAll(
                    ":scope > .terminal__pair",
                )) {
                    row.remove();
                }
            } else if (typeof result === "string") {
                appendRow(root, command, result);
            } else {
                const stop = result(appendRow(root, command, ""), () => {
                    // Unless it was stopped already, and another started.
                    if (state.stop === stop) state.stop = undefined;
                });
                state.stop = stop;
            }

            state.history.push(command);
            state.cursor = state.history.length;
            state.draft = "";
            break;
        }
        case "ArrowUp": {
            if (state.cursor === 0) return;
            if (state.cursor === state.history.length)
                state.draft = field.value;
            field.value = state.history[--state.cursor];
            e.preventDefault(); // Keeps the caret at the end
            break;
        }
        case "ArrowDown": {
            if (state.cursor >= state.history.length) return;
            state.cursor++;
            field.value =
                state.cursor === state.history.length
                    ? state.draft
                    : state.history[state.cursor];
            e.preventDefault();
            break;
        }
    }
});
</script>
