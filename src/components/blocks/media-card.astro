---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import { Icon } from "astro-icon/components";
import Button from "../ui/button.astro";
import Card from "../ui/card.astro";

/**
 * A <Card> with a title, an optional full-bleed header image, and a row of
 * labelled icon links -- for projects, posts, or anything else worth showcasing. The
 * description goes in the default slot.
 */
type Props = ComponentProps<typeof Card> & {
    title: string;
    links?: {
        href: string;
        icon: string;
        /** Shown beside the icon, and the link's accessible name. */
        label: string;
    }[];
    header?: {
        src: ImageMetadata;
        alt: string;
        /**
         * How wide the card is shown, as an `<img sizes>` value, so the
         * browser picks the right file. Defaults to a card in a grid.
         */
        sizes?: string;
    };
};

const { title, links = [], header, class: className, ...rest } = Astro.props;
---

<Card class:list={["media-card", className]} {...rest}>
    {header && (
        <Image
            class="media-card__header"
            src={header.src}
            alt={header.alt}
            widths={[400, 800]}
            sizes={header.sizes ?? "(min-width: 48rem) 24rem, 100vw"}
        />
    )}
    <div class="media-card__body">
        <h3>{title}</h3>
        <slot />
    </div>
    {links.length > 0 && (
        <ul class="media-card__links">
            {links.map((link) => (
                <li>
                    <Button
                        href={link.href}
                        size="sm"
                        variant="ghost"
                        tone="neutral"
                        lift={false}
                    >
                        <Icon name={link.icon} aria-hidden="true" />
                        {link.label}
                    </Button>
                </li>
            ))}
        </ul>
    )}
</Card>

<style>
/*
 * Surface, border and tone come from <Card>. This file only lays out the
 * header, body and links. `.card` is repeated to outrank Card's own padding.
 */
.media-card.card {
    align-items: stretch;
    padding: 0;
    /* Clip the header image to the card's corners when --radius is set. */
    overflow: hidden;

    .media-card__header {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-bottom: var(--border-width) solid var(--border-color);
    }

    /* Set like Card's own content: small text, a hair under the title. */
    .media-card__body {
        padding: var(--space-md);

        h3 {
            margin-bottom: var(--space-xs);
        }

        :global(p) {
            font: var(--type-body-sm);
            color: var(--color-text-muted);
        }
    }

    .media-card__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin: auto 0 0;
        padding: var(--space-sm) var(--space-md);
        list-style: none;
        border-top: var(--border-width) solid var(--border-color);

        /* Ghost buttons have no visible edge, so line the first label up with the card text. */
        li:first-child {
            margin-inline-start: calc(-1 * (var(--space-sm) + 1px));
        }

        /* Button nudges its icons up for body-size labels; at this size it reads as misaligned. */
        :global(.button svg) {
            margin-bottom: 0;
        }
    }
}
</style>
