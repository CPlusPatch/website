---
import Status from "@cpluspatch/ui/astro/ui/status.astro";
import {
    beatState,
    beatsOf,
    describe,
    type Probe,
    type StatusFeed,
    stateOf,
    statusTone,
} from "./feed.ts";

/**
 * A cell of a <StatusBoard>: a probe's name and target, its latest
 * response time while up or its state otherwise, and a timeline of its
 * latest results, oldest first.
 * The board draws the beats, and its script keeps the row up to date.
 */
interface Props extends Probe {
    feed?: StatusFeed;
    /** Results on the timeline. */
    beats: number;
}

const { name, target, feed, beats } = Astro.props;
const results = beatsOf(feed, name, beats);
const { latency, label, tone } = stateOf(feed, name);
---

<li class="status-probe" data-probe={name}>
    <span class="status-probe__name">
        <span class="text-label">{name}</span>
        <span class="status-probe__target text-meta">{target}</span>
    </span>
    <span
        class="status-probe__beats"
        role="img"
        aria-label={describe(results)}
        data-beats
    >
        {results.map((result) => (
            <span
                class="status-board__beat"
                data-state={beatState(result)}
            ></span>
        ))}
    </span>
    <span class="status-probe__state text-meta">
        <span class="status-probe__latency" data-latency>{latency}</span>
        <Status tone={statusTone(tone)} data-probe-status>
            <span data-status-text>{label}</span>
        </Status>
    </span>
</li>

<style>
/*
 * The name and target, the state beside them, and the timeline across the
 * bottom. A cell sizes from its own width.
 */
.status-probe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
        "name state"
        "beats beats";
    align-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm);
    /* A hairline, inside the board's frame, however heavy a style's borders. */
    border: min(var(--border-width), 1px) solid var(--border-color);
    container-type: inline-size;

    /* Down: the border says so as well as the words. */
    &:has(.status__light.tone-destructive) {
        border-color: var(--color-destructive);
    }

    /* The latency on the name's baseline. */
    .status-probe__name,
    .status-probe__state {
        align-self: first baseline;
    }

    .status-probe__name {
        grid-area: name;
        display: flex;
        flex-direction: column;
        min-width: 0;

        .status-probe__target {
            overflow: hidden;
            color: var(--color-text-muted);
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }

    /* Oldest on the left, so the newest comes in at the right. */
    .status-probe__beats {
        grid-area: beats;
        display: flex;
        gap: var(--beat-gap);
        height: var(--beat-height);

        .status-board__beat {
            flex: 1;
            min-width: 0;
        }

        /* A narrow cell keeps the latest 20. */
        @container (max-width: 11rem) {
            .status-board__beat:nth-child(-n + 10) {
                display: none;
            }
        }

        /* The newest, coming in. */
        .status-board__beat:last-child {
            animation: status-probe-beat 0.3s ease-out;

            @media (prefers-reduced-motion: reduce) {
                animation: none;
            }
        }
    }

    /* Its response time while up, and its state otherwise. */
    .status-probe__state {
        grid-area: state;
        display: flex;
        align-items: center;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;

        .status:has(.tone-success),
        &:not(:has(.tone-success)) .status-probe__latency {
            display: none;
        }

        .status {
            color: var(--color-text);
        }
    }
}

@keyframes status-probe-beat {
    from {
        opacity: 0;
        scale: 1 0.4;
    }
}
</style>
