---
import PauseButton from "@cpluspatch/ui/astro/ui/pause-button.astro";
import Status from "@cpluspatch/ui/astro/ui/status.astro";
import type { HTMLAttributes } from "astro/types";
import {
    hostState,
    type ProbeHost,
    type StatusFeed,
    statusTone,
    summarise,
} from "./feed.ts";
import StatusProbe from "./status-probe.astro";

/**
 * A status board: a headline beside counts of hosts, endpoints and firing
 * alerts, over a grid of each host's probes (see <StatusProbe>). Only what
 * isn't up says so in words.
 * Anything in the default slot is noted in the footer, like the source.
 *
 * With JS, it loads the status feed at `src`, then again every `interval`
 * milliseconds while in view, with a button beside the key to pause it. If
 * the feed can't be loaded or is out of date, it says so. Without JS, or
 * until the feed loads, it shows `feed`, or the probes with no results.
 *
 * With `fill`, it grows to the height it's given, as on a page of its own,
 * with taller timelines.
 */
interface Props extends HTMLAttributes<"figure"> {
    hosts: ProbeHost[];
    /** Names the board for screen readers. */
    label: string;
    /** The status feed's URL, loaded with JS. */
    src?: string;
    /** Results to show before the feed loads, or without one. */
    feed?: StatusFeed;
    /** Results kept on each timeline. */
    beats?: number;
    /** Milliseconds between loads of the feed. */
    interval?: number;
    fill?: boolean;
}

const {
    hosts,
    label,
    src,
    feed,
    beats = 30,
    interval = 20_000,
    fill = false,
    class: className,
    ...rest
} = Astro.props;

const { tiles, headline, tone } = summarise(
    feed,
    hosts.flatMap(({ probes }) => probes.map(({ name }) => name)),
);

const overview = [
    { key: "hosts", label: "hosts up", ...tiles.hosts },
    { key: "probes", label: "endpoints up", ...tiles.probes },
    { key: "alerts", label: "alerts firing", ...tiles.alerts },
];
---

<figure
    class:list={[
        "status-board",
        "panel",
        `tone-${tone}`,
        fill && "status-board--fill",
        className,
    ]}
    aria-label={label}
    data-status-board
    data-src={src}
    data-interval={interval}
    {...rest}
>
    <div class="status-board__head">
        <p class="status-board__headline" data-headline>
            <Status tone={statusTone(tone)} pulse={Boolean(src)}>
                <span data-status-text>{headline}</span>
            </Status>
        </p>
        <dl class="status-board__overview">
            {overview.map(({ key, label, value, tone }) => (
                <div
                    class:list={["status-board__count", `tone-${tone}`]}
                    data-tile={key}
                >
                    <dt class="text-meta">{label}</dt>
                    <dd class="text-title">{value}</dd>
                </div>
            ))}
        </dl>
    </div>

    <div class="status-board__hosts">
        {hosts.map(({ name, about, probes }) => (
            <section
                class="status-board__host"
                data-host={name}
                data-state={hostState(feed, name)}
            >
                <h3 class="status-board__host-name text-meta">
                    <span class="status-board__host-label">{name}</span>
                    {/* Shown only while the host is down. */}
                    <span class="status-board__host-down">down</span>
                    {about && <span class="status-board__about">{about}</span>}
                </h3>
                <ul class="status-board__probes">
                    {probes.map((probe) => (
                        <StatusProbe {...probe} feed={feed} beats={beats} />
                    ))}
                </ul>
            </section>
        ))}
    </div>

    <figcaption class="status-board__footer text-meta">
        <span><slot /><span data-updated></span></span>
        {/* Shown by the script, once there is something to pause. */}
        {src && (
            <span hidden data-status-live>
                <PauseButton target=".status-board" label="Pause updates" />
            </span>
        )}
    </figcaption>
</figure>

<script>
import { bindStatusBoard } from "./status-board.ts";

for (const root of document.querySelectorAll<HTMLElement>(
    "[data-status-board]",
)) {
    bindStatusBoard(root);
}
</script>

<style>
.status-board {
    /*
     * Up beats muted, so a failure stands out from a wall of them. Down is
     * full height, up shorter and no data shortest, so they read without
     * colour too.
     */
    --beat-up: color-mix(
        in oklab,
        var(--color-success-accent) 65%,
        transparent
    );
    --beat-down: var(--color-destructive);
    --beat-unknown: color-mix(
        in oklab,
        var(--color-text-muted) 25%,
        transparent
    );
    --beat-gap: 1px;
    --beat-height: 0.75rem;

    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    text-align: start;
    /* No tone rule from .panel: the headline carries the state. */
    border-top: var(--border-width) solid var(--border-color);
    /* Laid out from the board's width, not the page's. */
    container-type: inline-size;

    /*
     * A beat, in the cells' timelines. Global, as the cells are their own
     * component and the script moves beats.
     */
    :global(.status-board__beat) {
        align-self: end;
        height: 40%;
        background: var(--beat-unknown);
        border-radius: min(var(--radius), 1px);
        transform-origin: bottom;

        &[data-state="up"] {
            height: 70%;
            background: var(--beat-up);
        }

        &[data-state="down"] {
            height: 100%;
            background: var(--beat-down);
        }

        /* The beats are the content, so keep their colours. */
        @media (forced-colors: active) {
            forced-color-adjust: none;
        }
    }

    /* The headline, centred on the counts beside it, or above them. */
    .status-board__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm) var(--space-md);
        padding: var(--space-md);
        border-bottom: var(--border-width) solid var(--border-color);
    }

    /* The answer, so at least the size of the figures beside it. */
    .status-board__headline {
        font: var(--type-title);
        letter-spacing: var(--tracking-tight);
    }

    .status-board__overview {
        display: flex;
        margin: 0;
    }

    /* A figure over its label, divided from the one before by a rule. */
    .status-board__count {
        display: flex;
        flex-direction: column-reverse;
        padding-inline: var(--space-md);

        /* Closer on a small phone, where three labels don't fit apart */
        @container (max-width: 20rem) {
            padding-inline: var(--space-sm);
        }

        &:first-child {
            padding-inline-start: 0;
        }

        &:last-child {
            padding-inline-end: 0;
        }

        & + .status-board__count {
            border-inline-start: var(--border-width) solid var(--border-color);
        }

        dt {
            white-space: nowrap;
        }

        dd {
            margin: 0;
            font-variant-numeric: tabular-nums;
        }

        /* Only what's wrong in colour. */
        &:is(.tone-destructive, .tone-warning) dd {
            color: var(--tone);
        }
    }

    .status-board__hosts {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        padding: var(--space-md);
    }

    .status-board__host {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    /* The host's name, then its description at the end of the line. */
    .status-board__host-name {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-sm);
        margin: 0;

        .status-board__host-label {
            color: var(--color-text);
        }

        .status-board__about {
            margin-inline-start: auto;
        }

        .status-board__host-down {
            display: none;
            color: var(--color-destructive);
        }
    }

    .status-board__host[data-state="down"] .status-board__host-down {
        display: inline;
    }

    /*
     * The probes as cells, as many to a line as fit, in the same columns for
     * every host.
     */
    .status-board__probes {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
        gap: var(--space-sm);
    }

    .status-board__footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm) var(--space-md);
        min-height: 2.75rem;
        padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md);
        border-top: var(--border-width) solid var(--border-color);
        color: var(--color-text-muted);
    }

    /* Before any results, the headline says so, not every cell. */
    &.tone-neutral
        :global(.status-probe__state .status:not(:has(.status__light--toned))) {
        visibility: hidden;
    }

    /*
     * At the height it's given, as on a page of its own: taller timelines and
     * a larger headline, to be read from further away, and the footer at the
     * end.
     */
    &.status-board--fill {
        --beat-height: 1.5rem;

        .status-board__headline {
            font: var(--type-headline);
        }

        .status-board__hosts {
            flex: 1;
        }
    }
}
</style>
