---
import type { HTMLAttributes } from "astro/types";
import PauseButton from "../../ui/pause-button.astro";
import Status from "../../ui/status.astro";
import {
    type ProbeHost,
    type StatusFeed,
    statusTone,
    summarise,
} from "./feed.ts";
import StatusProbe from "./status-probe.astro";

/**
 * A status board like a monitoring dashboard's: an overview of hosts,
 * endpoints and firing alerts, over each host's probes (see <StatusProbe>).
 * Anything in the default slot is noted in the footer, like the source.
 *
 * With JS, it loads the status feed at `src`, then again every `interval`
 * milliseconds while in view, with a button beside the key to pause it. If
 * the feed can't be loaded or is out of date, it says so. Without JS, or
 * until the feed loads, it shows `feed`, or the probes with no results.
 *
 * With `fill`, it grows to the height it's given, as on a page of its own,
 * sharing the room between its rows.
 */
interface Props extends HTMLAttributes<"figure"> {
    hosts: ProbeHost[];
    /** Names the board for screen readers. */
    label: string;
    /** The status feed's URL, loaded with JS. */
    src?: string;
    /** Results to show before the feed loads, or without one. */
    feed?: StatusFeed;
    /** Results kept on each timeline. */
    beats?: number;
    /** Milliseconds between loads of the feed. */
    interval?: number;
    fill?: boolean;
}

const {
    hosts,
    label,
    src,
    feed,
    beats = 30,
    interval = 20_000,
    fill = false,
    class: className,
    ...rest
} = Astro.props;

const { tiles, headline, tone } = summarise(
    feed,
    hosts.flatMap(({ probes }) => probes.map(({ name }) => name)),
);

const overview = [
    { key: "hosts", label: "Hosts up", ...tiles.hosts },
    { key: "probes", label: "Endpoints up", ...tiles.probes },
    { key: "alerts", label: "Firing alerts", ...tiles.alerts },
];
---

<figure
    class:list={[
        "status-board",
        "panel",
        `tone-${tone}`,
        fill && "status-board--fill",
        className,
    ]}
    aria-label={label}
    data-status-board
    data-src={src}
    data-interval={interval}
    {...rest}
>
    <div class="status-board__head">
        <p class="status-board__headline" data-headline>
            <Status tone={statusTone(tone)} pulse={Boolean(src)}>
                <span data-status-text>{headline}</span>
            </Status>
        </p>
        <dl class="status-board__overview">
            {overview.map(({ key, label, value, tone }) => (
                <div
                    class:list={["status-board__tile", `tone-${tone}`]}
                    data-tile={key}
                >
                    <dt class="text-meta">{label}</dt>
                    <dd class="text-title">{value}</dd>
                </div>
            ))}
        </dl>
    </div>

    <div class="status-board__hosts">
        {hosts.map(({ name, about, probes }) => (
            <section
                class="status-board__host"
                style={`--probes: ${probes.length}`}
            >
                <h3 class="status-board__host-name text-meta">
                    <span>{name}</span>
                    {about && <span class="status-board__about">{about}</span>}
                </h3>
                <ul class="status-board__probes">
                    {probes.map((probe) => (
                        <StatusProbe {...probe} feed={feed} beats={beats} />
                    ))}
                </ul>
            </section>
        ))}
    </div>

    <figcaption class="status-board__footer text-meta">
        <span><slot /><span data-updated></span></span>
        <span class="status-board__key" aria-hidden="true">
            <span
                ><span class="status-board__beat" data-state="up"></span
                >Up</span
            >
            <span
                ><span class="status-board__beat" data-state="down"></span
                >Down</span
            >
            <span><span class="status-board__beat"></span>No data</span>
        </span>
        {/* Shown by the script, once there is something to pause. */}
        {src && (
            <span hidden data-status-live>
                <PauseButton target=".status-board" label="Pause updates" />
            </span>
        )}
    </figcaption>
</figure>

<script>
import { bindStatusBoard } from "./status-board.ts";

for (const root of document.querySelectorAll<HTMLElement>(
    "[data-status-board]",
)) {
    bindStatusBoard(root);
}
</script>

<style>
.status-board {
    /* Muted, so a failure stands out from a wall of them. */
    --beat-up: color-mix(
        in oklab,
        var(--color-success-accent) 65%,
        transparent
    );
    --beat-down: var(--color-destructive);
    --beat-unknown: color-mix(
        in oklab,
        var(--color-text-muted) 25%,
        transparent
    );
    --beat-gap: 2px;
    --beat-height: 1.5rem;

    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    text-align: start;
    /* The rows lay out from the board's width, not the page's. */
    container-type: inline-size;

    /*
     * A beat, in the rows' timelines and the key. Global, as the rows are
     * their own component and the script adds beats. Failed beats are full
     * height, the rest shorter, and unknown ones shortest, so they read
     * without colour.
     */
    :global(.status-board__beat) {
        align-self: end;
        height: 40%;
        background: var(--beat-unknown);
        border-radius: min(var(--radius), 2px);
        transform-origin: bottom;

        &[data-state="up"] {
            height: 70%;
            background: var(--beat-up);
        }

        &[data-state="down"] {
            height: 100%;
            background: var(--beat-down);
        }

        /* The beats are the content, so keep their colours. */
        @media (forced-colors: active) {
            forced-color-adjust: none;
        }
    }

    .status-board__head {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        padding: var(--space-md);
        border-bottom: var(--border-width) solid var(--border-color);
        /* A wash of the board's state, as the stats have one of their tone. */
        background-image: linear-gradient(
            color-mix(in oklab, var(--tone) 8%, transparent),
            transparent
        );
    }

    .status-board__headline {
        font: var(--type-subheading);
    }

    .status-board__overview {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-sm);
        margin: 0;
    }

    /* A small stat: the count in its tone over a dashed rule, then its label. */
    .status-board__tile {
        display: flex;
        flex-direction: column-reverse;
        gap: var(--space-xs);
        padding: var(--space-sm);
        background-image: linear-gradient(
            color-mix(in oklab, var(--tone) 10%, transparent),
            transparent
        );
        border: var(--border-width) solid var(--border-color);
        border-top: 2px solid var(--tone-accent);

        dt {
            padding-top: var(--space-xs);
            border-top: var(--border-width) dashed var(--color-border-strong);
            color: var(--color-text-muted);
        }

        dd {
            margin: 0;
            color: var(--tone);
            font-variant-numeric: tabular-nums;
        }
    }

    .status-board__hosts {
        display: flex;
        flex-direction: column;
    }

    .status-board__host + .status-board__host {
        border-top: var(--border-width) solid var(--border-color);
    }

    .status-board__host-name {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0 var(--space-sm);
        margin: 0;
        padding: var(--space-sm) var(--space-md);
        background: var(--color-surface);
        border-bottom: var(--border-width) dashed var(--color-border-strong);
        letter-spacing: 0.08em;
        text-transform: uppercase;

        .status-board__about {
            color: var(--color-text-muted);
            letter-spacing: normal;
            text-transform: none;
        }
    }

    .status-board__footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm) var(--space-md);
        min-height: 2.75rem;
        padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md);
        border-top: var(--border-width) solid var(--border-color);
        color: var(--color-text-muted);
    }

    .status-board__key {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs) var(--space-md);
        margin-inline-start: auto;

        /* Each beat beside its name, standing on the same line. */
        & > span {
            display: flex;
            align-items: end;
            gap: var(--space-xs);
            height: 0.75rem;
        }

        .status-board__beat {
            width: 0.375rem;
        }
    }

    /*
     * Growing to the height it's given: the hosts take the room left, sharing
     * it by their number of probes so every row gets the same. Taller beats
     * and larger type, to be read from further away.
     */
    &.status-board--fill {
        --beat-height: clamp(1.5rem, 3.5vh, 3rem);

        .status-board__headline {
            font: var(--type-title);
        }

        .status-board__tile {
            padding: var(--space-md);
        }

        .status-board__hosts {
            flex: 1;
        }

        .status-board__host {
            display: flex;
            flex: var(--probes) 0 auto;
            flex-direction: column;
        }

        .status-board__probes {
            display: grid;
            flex: 1;
            grid-auto-rows: 1fr;
        }
    }
}
</style>
