---
import PauseButton from "../ui/pause-button.astro";

/**
 * Seamless marquee. The track holds three copies of the slot (the last two
 * aria-hidden) and slides left by exactly one copy's width + gap per loop,
 * so the jump back to the start is invisible.
 */
interface Props {
    /** Scroll direction: false = left, true = right */
    reverse?: boolean;
    /** Seconds for one full loop */
    duration?: number;
    /** Any CSS length; used between items and between the copies */
    gap?: string;
    /**
     * Render a pause button. Turn off when a parent supplies one control for
     * several marquees: a `data-paused` on any ancestor pauses them all.
     */
    controls?: boolean;
    class?: string;
}

const {
    reverse = false,
    duration = 30,
    gap = "var(--space-sm)",
    controls = true,
    class: className,
} = Astro.props;
---

<div
    class:list={["marquee", className]}
    data-reverse={reverse ? "" : undefined}
    style={`--duration:${duration}s; --gap:${gap}`}
>
    {controls && <PauseButton class="marquee__pause" target=".marquee" />}
    {/*
     * astro-icon emits an icon's <symbol> only on its first render; every
     * later use is a bare <use href="#id">. This hidden copy takes that first
     * render, so the symbols live outside the animated track.
     */}
    <div class="marquee__definitions" aria-hidden="true" inert><slot /></div>
    <div class="marquee__track">
        <div class="marquee__group"><slot /></div>
        {/* Two more copies, so the track never runs out while scrolling */}
        <div class="marquee__group" aria-hidden="true" tabindex="-1">
            <slot />
        </div>
        <div class="marquee__group" aria-hidden="true" tabindex="-1">
            <slot />
        </div>
    </div>
</div>

<script>
// The duplicate groups are aria-hidden but deliberately not inert (inert
// would stop them reacting to hover), so take any focusable content inside
// them out of the tab order instead.
for (const el of document.querySelectorAll<HTMLElement>(
    '.marquee__group[aria-hidden="true"] :is(a[href], button, input, select, textarea, summary, [tabindex])',
)) {
    el.tabIndex = -1;
}
</script>

<style>
.marquee {
    position: relative;

    /*
     * Hidden until the marquee is hovered or focused, but always reachable:
     * focus-within reveals it for keyboard users, and touch screens (no hover)
     * keep it visible.
     */
    :global(.marquee__pause) {
        position: absolute;
        top: var(--space-xs);
        right: var(--space-xs);
        z-index: 1;
        background-color: var(--color-surface);
        opacity: 0;
        transition: opacity var(--transition);
    }

    &:hover :global(.marquee__pause),
    &:focus-within :global(.marquee__pause),
    :global(.marquee__pause[aria-pressed="true"]) {
        opacity: 1;
    }

    @media (hover: none) {
        :global(.marquee__pause) {
            opacity: 1;
        }
    }

    .marquee__definitions {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
        visibility: hidden;
    }

    .marquee__track {
        display: flex;
        gap: var(--gap);
        width: max-content;
        animation: marquee-scroll var(--duration) linear infinite;

        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }

        .marquee__group {
            display: flex;
            flex: none;
            align-items: center;
            justify-content: space-around;
            gap: var(--gap);
            margin: 0;
            padding: 0;
            list-style: none;
        }
    }

    &[data-reverse] .marquee__track {
        animation: marquee-scroll-reverse var(--duration) linear infinite;

        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }
    }
}

/*
 * Paused by a PauseButton on the marquee itself, or on an ancestor (Logos
 * pauses every lane at once). Kept after the [data-reverse] rule, which has
 * equal specificity and would otherwise reset the play state.
 */
.marquee[data-paused] .marquee__track,
:global([data-paused]) .marquee .marquee__track {
    animation-play-state: paused;
}

@keyframes marquee-scroll {
    from {
        transform: translate3d(0, 0, 0);
    }

    to {
        transform: translate3d(calc(-33.333333% - var(--gap) / 3), 0, 0);
    }
}

@keyframes marquee-scroll-reverse {
    from {
        transform: translate3d(calc(-33.333333% - var(--gap) / 3), 0, 0);
    }

    to {
        transform: translate3d(0, 0, 0);
    }
}
</style>
