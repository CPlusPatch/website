---
import Button from "@cpluspatch/ui/astro/ui/button.astro";
import Card from "@cpluspatch/ui/astro/ui/card.astro";
import type { ComponentProps } from "astro/types";
import { Icon } from "astro-icon/components";

/**
 * A way to reach someone: the whole card is a link, with the icon, the name
 * and the handle under it. `copy` adds a button that copies that value, shown
 * once the script runs as copying needs it.
 */
interface Props extends ComponentProps<typeof Card> {
    name: string;
    href: string;
    icon: string;
    handle?: string;
    /** What the copy button puts on the clipboard. */
    copy?: string;
}

const {
    name,
    href,
    icon,
    handle,
    copy,
    class: className,
    ...rest
} = Astro.props;

const external = /^https?:/.test(href);
---

<Card class:list={["contact-method", className]} {...rest}>
    <a
        class="contact-method__link"
        {href}
        {...external && {
            target: "_blank",
            rel: "noopener noreferrer",
            referrerpolicy: "no-referrer",
        }}
    >
        <span class="contact-method__tile">
            <Icon name={icon} class="contact-method__icon" aria-hidden="true" />
        </span>
        <span class="contact-method__text">
            <h3 class="contact-method__name">{name}</h3>
            {handle && (
                <span class="contact-method__handle">
                    {/* May break after a . : or /, or before an @, rather than anywhere. */}
                    {handle.split(/(?<=[.:/])|(?<=.)(?=@)/).map((part) => (
                        <Fragment>
                            {part}
                            <wbr>
                        </Fragment>
                    ))}
                </span>
            )}
        </span>
        {external && <span class="visually-hidden">(opens in new tab)</span>}
    </a>
    {copy && (
        <Button
            class="contact-method__copy"
            size="icon-sm"
            variant="ghost"
            tone="neutral"
            aria-label={`Copy ${name} address`}
            aria-pressed="false"
            data-copy={copy}
            hidden
        >
            <Icon name="lucide:copy" aria-hidden="true" />
            <Icon name="lucide:check" aria-hidden="true" />
        </Button>
    )}
</Card>

<script>
for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy]",
)) {
    button.hidden = false;
    let reset: number | undefined;

    button.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
        } catch {
            return;
        }
        button.setAttribute("aria-pressed", "true");
        clearTimeout(reset);
        reset = window.setTimeout(
            () => button.setAttribute("aria-pressed", "false"),
            2000,
        );
    });
}
</script>

<style>
/*
 * Surface, border, tone and lift come from <Card>. This file lays out the
 * icon tile, name and handle, and stretches the link over the whole card.
 * Compact on purpose: --space-md padding rather than Card's roomier default.
 * The card is its own container: stacked when narrow (four across), a row
 * once there is room (phone, two across).
 */
.contact-method.card {
    position: relative;
    padding: 0;
    container: contact-method / inline-size;

    .contact-method__link {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        row-gap: var(--space-sm);
        align-items: center;
        justify-items: start;
        inline-size: 100%;
        padding: var(--space-md);
        color: inherit;
        text-decoration: none;

        /* Links fill with the primary on hover; the card shows it by its
           border and title instead, so keep the link itself clear. */
        &:hover {
            color: inherit;
            background-color: transparent;
        }

        /* The link covers the card; the copy button sits above it. */
        &::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: var(--radius);
        }

        &:focus-visible {
            outline: none;

            &::after {
                outline: 2px solid var(--color-primary);
                outline-offset: 2px;
            }
        }
    }

    /* The icon sits in a tile tinted with the tone. */
    .contact-method__tile {
        display: grid;
        place-items: center;
        inline-size: 2.75rem;
        block-size: 2.75rem;
        color: var(--tone);
        background-color: color-mix(in oklab, var(--tone) 14%, transparent);
        border: var(--border-width) solid
            color-mix(in oklab, var(--tone) 35%, transparent);
        border-radius: var(--radius);
    }

    .contact-method__icon {
        inline-size: 1.5rem;
        block-size: 1.5rem;
    }

    .contact-method__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-inline-size: 0;
    }

    .contact-method__name {
        margin: 0;
    }

    .contact-method__handle {
        font: var(--type-body-sm);
        font-family: var(--font-mono);
        /* Muted, but nearer the text colour: on the card's raised surface the
           plain muted colour falls under 4.5:1 in several dark themes. */
        color: color-mix(
            in oklab,
            var(--color-text) 60%,
            var(--color-text-muted)
        );
        overflow-wrap: anywhere;
    }

    /* Top-right when stacked, centred on the tile and in line with the
       content's end edge. An invisible hit area reaches the touch minimum
       without crowding the card. */
    :global(.contact-method__copy) {
        position: absolute;
        inset-block-start: calc(
            var(--space-md) +
            var(--border-width) +
            (2.75rem - var(--control-height-sm)) /
            2
        );
        inset-inline-end: var(--space-md);
        z-index: 1;

        &::before {
            content: "";
            position: absolute;
            inset: calc(var(--space-sm) * -1);
        }
    }

    /* Room for it beside the text once the card is a row. */
    @container contact-method (min-width: 18rem) {
        .contact-method__link {
            grid-template-columns: auto minmax(0, 1fr);
            column-gap: var(--space-md);
            align-items: start;
        }

        /* Keeps a one- or two-line text block centred on the tile. */
        .contact-method__text {
            justify-content: center;
            min-block-size: 2.75rem;
        }

        &:has(.contact-method__copy:not([hidden])) .contact-method__link {
            padding-inline-end: calc(
                var(--space-md) *
                2 +
                var(--control-height-sm)
            );
        }

        :global(.contact-method__copy) {
            inset-inline-end: var(--space-sm);
        }
    }
}
</style>
