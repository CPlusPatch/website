---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import type { Tone } from "../../lib/tone.ts";
import Button from "../ui/button.astro";
import Slider from "../ui/slider.astro";

/**
 * An <audio> player in the site's style. Without JS it is the browser's own
 * player; the script swaps in a play toggle, a seek bar and the time.
 */
interface Props extends HTMLAttributes<"figure"> {
    src: string;
    /** Shown under the player, and its accessible name. */
    title?: string;
    tone?: Tone;
}

const { src, title, tone = "primary", class: className, ...rest } = Astro.props;
---

<figure
    class:list={["audio-player", "panel", `tone-${tone}`, className]}
    {...rest}
>
    {/* biome-ignore lint/a11y/useMediaCaption: captions are for video; audio needs a transcript, which is page content */}
    <audio src={src} preload="metadata" controls aria-label={title}></audio>
    <div class="audio-player__controls" hidden>
        <Button
            class="audio-player__toggle"
            size="icon"
            variant="outline"
            tone="neutral"
            lift={false}
            aria-pressed="false"
            aria-label={title ? `Play ${title}` : "Play"}
        >
            <Icon
                name="lucide:play"
                class="audio-player__play"
                aria-hidden="true"
            />
            <Icon
                name="lucide:pause"
                class="audio-player__pause"
                aria-hidden="true"
            />
        </Button>
        <Slider
            class="audio-player__seek"
            min="0"
            max="0"
            step="any"
            value="0"
            aria-label="Seek"
        />
        <span class="audio-player__time">0:00 / 0:00</span>
    </div>
    {title && <figcaption>{title}</figcaption>}
</figure>

<style>
.audio-player {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    padding: var(--space-md);

    audio {
        width: 100%;
    }

    figcaption {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
    }

    .audio-player__controls {
        display: flex;
        align-items: center;
        gap: var(--space-md);
    }

    /* Pressed while playing, like the pause button */
    .audio-player__pause {
        display: none;
    }

    .audio-player__toggle[aria-pressed="true"] {
        .audio-player__play {
            display: none;
        }

        .audio-player__pause {
            display: block;
        }
    }

    .audio-player__seek {
        flex: 1;
    }

    .audio-player__time {
        color: var(--color-text-muted);
        font: var(--font-size-xs) / 1 var(--font-mono);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
}
</style>

<script>
import { bindTransport } from "../../lib/media.ts";

for (const root of document.querySelectorAll<HTMLElement>(".audio-player")) {
    bindTransport(root.querySelector("audio") as HTMLAudioElement, {
        controls: root.querySelector(".audio-player__controls") as HTMLElement,
        toggle: root.querySelector(".audio-player__toggle") as HTMLElement,
        seek: root.querySelector(".audio-player__seek") as HTMLInputElement,
        time: root.querySelector(".audio-player__time") as HTMLElement,
    });
}
</script>
