---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import type { Tone } from "../../lib/tone.ts";
import Button from "../ui/button.astro";
import Slider from "../ui/slider.astro";

/**
 * An <audio> player in the site's style. Without JS it is the browser's own
 * player; the script swaps in a play toggle, a seek bar and the time.
 */
interface Props extends HTMLAttributes<"figure"> {
    src: string;
    /** Shown under the player, and its accessible name. */
    title?: string;
    tone?: Tone;
    /**
     * Its own bordered panel. Turn off inside something that already frames
     * it, like a CornerWindow.
     */
    framed?: boolean;
}

const {
    src,
    title,
    tone = "primary",
    framed = true,
    class: className,
    ...rest
} = Astro.props;
---

<figure
    class:list={["audio-player", framed && "panel", `tone-${tone}`, className]}
    {...rest}
>
    {/* biome-ignore lint/a11y/useMediaCaption: captions are for video; audio needs a transcript, which is page content */}
    <audio src={src} preload="metadata" controls aria-label={title}></audio>
    <div class="audio-player__controls" hidden>
        <Button
            class="audio-player__toggle"
            size="icon"
            variant="outline"
            tone="neutral"
            lift={false}
            aria-pressed="false"
            aria-label={title ? `Play ${title}` : "Play"}
        >
            <Icon name="lucide:play" aria-hidden="true" />
            <Icon name="lucide:pause" aria-hidden="true" />
        </Button>
        <Slider
            class="audio-player__seek"
            min="0"
            max="0"
            step="any"
            value="0"
            aria-label="Seek"
        />
        <span class="audio-player__time">0:00 / 0:00</span>
    </div>
    {title && <figcaption class="text-body-sm">{title}</figcaption>}
</figure>

<style>
.audio-player {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;

    &.panel {
        padding: var(--space-md);
    }

    audio {
        width: 100%;
    }

    figcaption {
        color: var(--color-text-muted);
    }

    .audio-player__controls {
        display: flex;
        align-items: center;
        gap: var(--space-md);
    }

    .audio-player__seek {
        flex: 1;
    }

    .audio-player__time {
        color: var(--color-text-muted);
        font: var(--type-meta);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
}
</style>

<script>
import { bindTransport } from "../../lib/media.ts";

for (const root of document.querySelectorAll<HTMLElement>(".audio-player")) {
    bindTransport(root.querySelector("audio") as HTMLAudioElement, {
        controls: root.querySelector(".audio-player__controls") as HTMLElement,
        toggle: root.querySelector(".audio-player__toggle") as HTMLElement,
        seek: root.querySelector(".audio-player__seek") as HTMLInputElement,
        time: root.querySelector(".audio-player__time") as HTMLElement,
    });
}
</script>
