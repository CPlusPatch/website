---
/** Three pulsing dots, in place of a message that is still being written. */
interface Props {
    /** Announced instead of the dots, such as "Greg is typing". */
    label: string;
}

const { label } = Astro.props;
---

<span class="message-typing" role="status">
    <span class="message-typing__dot" aria-hidden="true"></span>
    <span class="message-typing__dot" aria-hidden="true"></span>
    <span class="message-typing__dot" aria-hidden="true"></span>
    <span class="visually-hidden">{label}</span>
</span>

<style>
.message-typing {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    /* A line of text tall, so the bubble doesn't shrink while it waits. */
    block-size: 1lh;

    .message-typing__dot {
        inline-size: 0.4em;
        block-size: 0.4em;
        background-color: currentColor;
        border-radius: 50%;
        animation: message-typing 1.2s ease-in-out infinite;

        &:nth-child(2) {
            animation-delay: 0.15s;
        }

        &:nth-child(3) {
            animation-delay: 0.3s;
        }

        @media (prefers-reduced-motion: reduce) {
            animation: none;
            opacity: 0.6;
        }

        /* Forced colours repaint backgrounds as Canvas, hiding the dots. */
        @media (forced-colors: active) {
            background-color: CanvasText;
        }
    }
}

@keyframes message-typing {
    0%,
    60%,
    100% {
        opacity: 0.3;
        translate: 0 0;
    }

    30% {
        opacity: 1;
        translate: 0 -0.2em;
    }
}
</style>
