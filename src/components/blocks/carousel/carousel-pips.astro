---
import Progress from "../../ui/progress.astro";

/**
 * The carousel's row of slide markers, one bar per slide, filled by pips.ts
 * from the template. Also autoplay's timer: while rotating, the current
 * pip's bar fills over the interval (see autoplay.ts).
 *
 * Pips keep a usable size rather than shrinking to fit; past what fits, the
 * row scrolls to follow the current one, and the counter beside it says
 * where that is in the whole.
 */
---

<div class="carousel-pips" data-carousel-pips>
    {/* The button is the touch target; the bar is drawn in it. */}
    <template data-carousel-pip>
        <button type="button" class="carousel-pips__pip">
            <Progress class="carousel-pips__bar" value={0} decorative />
        </button>
    </template>
</div>

<style>
.carousel-pips {
    display: flex;
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    mask-image: linear-gradient(
        calc(var(--fade-flip, 1) * 90deg),
        transparent,
        #000 var(--fade-start, 0),
        #000 calc(100% - var(--fade-end, 0)),
        transparent
    );

    /* The gradient runs left to right; -90deg turns it round for RTL. */
    &:dir(rtl) {
        --fade-flip: -1;
    }

    &[data-fade-start] {
        --fade-start: var(--space-lg);
    }

    &[data-fade-end] {
        --fade-end: var(--space-lg);
    }

    /* The carousel's autoplay state, as hooks for the pips below. */
    :global(.carousel[data-held]) & {
        --pip-progress-state: paused;
    }

    :global(.carousel[data-autoplay]:not([data-paused])) & {
        --pip-current: var(--tone-accent);
        --pip-progress: carousel-progress var(--carousel-interval) linear
            forwards;

        @media (forced-colors: active) {
            --pip-current: GrayText;
        }
    }
}

@keyframes carousel-progress {
    to {
        --progress-value: 1;
    }
}

.carousel-pips__pip {
    display: flex;
    align-items: center;
    flex: 0 1 2rem;
    min-inline-size: 0.75rem;
    height: var(--control-height-md);
    padding: 0 2px;
    background: none;
    border: 0;
    cursor: pointer;

    .carousel-pips__bar {
        --progress-track: var(--color-border-strong);

        flex: 1;
        block-size: 3px;
        transition:
            background-color var(--transition),
            block-size var(--transition);
    }

    &:hover .carousel-pips__bar {
        --progress-track: var(--color-text-muted);
    }

    &[aria-current="true"] .carousel-pips__bar {
        --progress-track: var(--pip-current, var(--tone));

        block-size: 5px;
        animation: var(--pip-progress, none);
        animation-play-state: var(--pip-progress-state, running);
    }

    @media (forced-colors: active) {
        .carousel-pips__bar {
            --progress-track: CanvasText;
        }

        &[aria-current="true"] .carousel-pips__bar {
            --progress-track: var(--pip-current, Highlight);
        }
    }
}
</style>
