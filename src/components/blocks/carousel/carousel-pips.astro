---
/**
 * The carousel's row of slide markers, one bar per slide, filled by pips.ts.
 * Also autoplay's timer: while rotating, the current pip is a track that a
 * progress bar fills over the interval (see autoplay.ts).
 *
 * Pips keep a usable size rather than shrinking to fit; past what fits, the
 * row scrolls to follow the current one, and the counter beside it says
 * where that is in the whole.
 */
---

<div class="carousel-pips" data-carousel-pips />

<style>
.carousel-pips {
    display: flex;
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    mask-image: linear-gradient(
        calc(var(--fade-flip, 1) * 90deg),
        transparent,
        #000 var(--fade-start, 0),
        #000 calc(100% - var(--fade-end, 0)),
        transparent
    );

    /* The gradient runs left to right; -90deg turns it round for RTL. */
    &:dir(rtl) {
        --fade-flip: -1;
    }

    &[data-fade-start] {
        --fade-start: var(--space-lg);
    }

    &[data-fade-end] {
        --fade-end: var(--space-lg);
    }

    /* The carousel's autoplay state, as hooks for the pips below. */
    :global(.carousel[data-held]) & {
        --pip-progress-state: paused;
    }

    :global(.carousel[data-autoplay]:not([data-paused])) & {
        --pip-current: var(--tone-accent);
        --pip-progress: carousel-progress var(--carousel-interval) linear
            forwards;

        @media (forced-colors: active) {
            --pip-current: GrayText;
        }
    }
}

@keyframes carousel-progress {
    to {
        scale: 1 1;
    }
}

/*
 * Built by the script, so outside the scope Astro adds to this file's markup.
 * The button is the touch target; ::before is the bar drawn in it, and
 * ::after autoplay's progress over it.
 */
.carousel-pips :global(.carousel-pips__pip) {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 1 2rem;
    min-inline-size: 0.75rem;
    height: var(--control-height-md);
    padding: 0 2px;
    background: none;
    border: 0;
    cursor: pointer;

    &::before {
        content: "";
        flex: 1;
        height: 3px;
        background-color: var(--color-border-strong);
        transition:
            background-color var(--transition),
            height var(--transition);
    }

    &:hover::before {
        background-color: var(--color-text-muted);
    }

    &[aria-current="true"]::before {
        height: 5px;
        background-color: var(--pip-current, var(--tone));
    }

    &::after {
        content: "";
        position: absolute;
        inset-inline: 2px;
        top: 50%;
        height: 5px;
        translate: 0 -50%;
        background-color: var(--tone);
        scale: 0 1;
        transform-origin: left;
    }

    &:dir(rtl)::after {
        transform-origin: right;
    }

    &[aria-current="true"]::after {
        animation: var(--pip-progress, none);
        animation-play-state: var(--pip-progress-state, running);
    }

    @media (forced-colors: active) {
        &::before {
            background-color: CanvasText;
        }

        &[aria-current="true"]::before {
            background-color: var(--pip-current, Highlight);
        }

        &::after {
            background-color: Highlight;
        }
    }
}
</style>
