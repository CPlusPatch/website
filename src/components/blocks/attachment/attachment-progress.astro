---
/** A hairline progress bar along the bottom edge of an <Attachment>, in its tone. */
interface Props {
    /** 0 to 100. Out-of-range values are clamped. */
    value: number;
    label: string;
}

const { label } = Astro.props;
const value = Math.min(100, Math.max(0, Astro.props.value));
---

<div
    class="attachment-progress"
    role="progressbar"
    aria-label={label}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={value}
    style={`--progress: ${value}%`}
></div>

<style>
.attachment-progress {
    position: absolute;
    inset: auto 0 0;
    block-size: 2px;
    background-color: color-mix(in oklab, var(--tone) 20%, transparent);

    /* Scaled rather than sized, so updates skip layout (as carousel pips). */
    &::before {
        content: "";
        display: block;
        block-size: 100%;
        background-color: var(--tone);
        scale: var(--progress) 1;
        transform-origin: left;
        transition: scale var(--transition);
    }

    &:dir(rtl)::before {
        transform-origin: right;
    }

    @media (forced-colors: active) {
        background-color: GrayText;

        &::before {
            background-color: Highlight;
        }
    }
}
</style>
