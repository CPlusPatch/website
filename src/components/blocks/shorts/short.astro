---
import { getImage } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Avatar from "../../ui/avatar.astro";
import Button from "../../ui/button.astro";
import Slider from "../../ui/slider.astro";
import { formatLikes, likesLabel } from "./actions.ts";
import ShortButton from "./short-button.astro";

/**
 * Short shape:
 *
 *   ┌─────────────────┐
 *   │ ▶ 🔊            │   controls: play, mute
 *   │                 │
 *   │      video      │
 *   │              ♥  │   rail: like, dislike, share and
 *   │              👎 │         the channel's avatar again
 *   │ ◉ @channel [+] ◉│   info: avatar, channel, subscribe
 *   │ Title           │         and title, over a scrim
 *   ├━━━━━━━━─────────┤   seek
 *   └─────────────────┘
 *
 * One video in a <Shorts> feed, filling it edge to edge. The overlay is
 * drawn over the picture in every theme, so it takes the dark scheme.
 *
 * Without JS it is the browser's own player, with the title over the top
 * where it clears the native controls; the rest needs the script and stays
 * hidden until it runs.
 */
interface Props extends HTMLAttributes<"article"> {
    src: string;
    /** Shown until the first frame loads. */
    poster?: ImageMetadata;
    title: string;
    /** Without the @, which is added. */
    channel: string;
    avatar?: ImageMetadata;
    likes?: number;
}

const {
    src,
    poster,
    title,
    channel,
    avatar,
    likes = 0,
    class: className,
    ...rest
} = Astro.props;

const posterImage = poster && (await getImage({ src: poster, width: 540 }));
---

<article
    class:list={["short", className]}
    aria-label={`${title}, by @${channel}`}
    data-short
    {...rest}
>
    {/* biome-ignore lint/a11y/useMediaCaption: these clips have no speech */}
    <video
        src={src}
        poster={posterImage?.src}
        preload="metadata"
        controls
        playsinline
        loop
        aria-label={title}
    ></video>

    {/* Played and paused flash up in the middle on a press, as on YouTube. */}
    <div class="short__flash" aria-hidden="true">
        <Icon name="lucide:play" />
        <Icon name="lucide:pause" />
    </div>

    <div class="short__controls" hidden data-short-script>
        <ShortButton
            icon="lucide:play"
            pressedIcon="lucide:pause"
            aria-pressed="false"
            aria-label="Play"
            data-short-toggle
        />
        <ShortButton
            icon="lucide:volume-2"
            pressedIcon="lucide:volume-x"
            aria-pressed="true"
            aria-label="Mute"
            data-short-mute
        />
    </div>

    <div class="short__rail" hidden data-short-script>
        <ShortButton
            icon="lucide:thumbs-up"
            label={formatLikes(likes)}
            aria-pressed="false"
            aria-label={likesLabel(likes)}
            data-short-like
            data-count={likes}
        />
        <ShortButton
            icon="lucide:thumbs-down"
            label="Dislike"
            aria-pressed="false"
            aria-label="Dislike"
            data-short-dislike
        />
        <ShortButton
            icon="lucide:share-2"
            pressedIcon="lucide:check"
            label="Share"
            aria-label="Share"
            data-short-share
        />
        {/* The sound's tile, which is the channel's own: a repeat, so hidden. */}
        <Avatar
            class="short__sound"
            src={avatar}
            alt={channel}
            size="sm"
            aria-hidden="true"
        />
    </div>

    <div class="short__info">
        <div class="short__channel">
            <Avatar src={avatar} alt={channel} size="sm" />
            <span class="short__name text-label">@{channel}</span>
            <Button
                class="short__subscribe"
                size="sm"
                tone="neutral"
                lift={false}
                aria-pressed="false"
                hidden
                data-short-script
                data-short-subscribe={channel}
            >
                <span>Subscribe</span>
                <span>Subscribed</span>
            </Button>
        </div>
        <p class="short__title text-body-sm">{title}</p>
    </div>

    <Slider
        class="short__seek"
        min="0"
        max="0"
        step="any"
        value="0"
        aria-label="Seek"
        hidden
        data-short-script
        data-short-seek
    />
</article>

<style>
.short {
    display: grid;
    /*
     * One cell, the frame's size: auto tracks would grow to a wide channel
     * row, and the video would keep its shape, past the frame both ways.
     */
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    flex: none;
    block-size: 100%;
    overflow: hidden;
    /* Over the picture, whatever the page's scheme */
    color-scheme: dark;
    color: #fff;
    /* Letterboxing is black in every theme, as on any screen */
    background: #000;
    scroll-snap-align: start;
    /* One swipe moves one short, however hard it is flung. */
    scroll-snap-stop: always;

    /*
     * All on one layer, so the overlay paints over the picture by coming
     * after it: a video with native controls paints over siblings without
     * a layer of their own.
     */
    > * {
        grid-area: 1 / 1;
        z-index: 1;
    }

    video {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
    }

    /* Without JS, the native controls own the bottom edge. */
    &:not([data-ready]) video {
        object-fit: contain;
    }

    /*
     * Fades out to nothing on its own once data-flash is set, and the
     * script restarts it by re-setting it. Under reduced motion it never
     * shows; the toggle's own icon still says which state it is in.
     */
    .short__flash {
        place-self: center;
        display: grid;
        padding: var(--space-md);
        background: rgb(0 0 0 / 0.5);
        border-radius: 50%;
        opacity: 0;
        pointer-events: none;

        svg {
            grid-area: 1 / 1;
            width: 2.5rem;
            height: 2.5rem;
        }
    }

    &[data-flash="play"] .short__flash svg:last-child,
    &[data-flash="pause"] .short__flash svg:first-child {
        visibility: hidden;
    }

    &[data-flash] .short__flash {
        animation: short-flash 600ms ease-out;
    }

    @media (prefers-reduced-motion: reduce) {
        &[data-flash] .short__flash {
            animation: none;
        }
    }

    .short__controls {
        align-self: start;
        display: flex;
        gap: var(--space-xs);
        padding: var(--space-sm);
        background: linear-gradient(rgb(0 0 0 / 0.4), transparent);
    }

    .short__rail {
        --short-button-size: 2.75rem;
        align-self: end;
        justify-self: end;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        padding: var(--space-sm);
        /* The avatar at its foot lines up with the title's last line */
        margin-block-end: var(--space-sm);
        /* Over the info's scrim, which comes later */
        z-index: 2;
    }

    .short__sound {
        --avatar-size: 2.25rem;
        align-self: center;
        margin-block-start: var(--space-xs);
        border: 2px solid #fff;
    }

    .short__info {
        align-self: end;
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        /* The rail's width, so a long title wraps before it */
        padding: var(--space-xl) calc(2.75rem + var(--space-md) * 1.5)
            var(--space-md) var(--space-md);
        background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
        text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
        pointer-events: none;

        > * {
            pointer-events: auto;
        }
    }

    &:not([data-ready]) .short__info {
        align-self: start;
        padding: var(--space-md) var(--space-md) var(--space-xl);
        background: linear-gradient(rgb(0 0 0 / 0.65), transparent);
    }

    .short__channel {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        min-inline-size: 0;

        .avatar {
            --avatar-size: 2rem;
        }
    }

    .short__name {
        min-inline-size: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .short__subscribe {
        margin-inline-start: var(--space-xs);
        color: #000;
        background: #fff;
        border-color: #fff;
        text-shadow: none;

        &[aria-pressed="false"] > span:last-child,
        &[aria-pressed="true"] > span:first-child {
            display: none;
        }

        &[aria-pressed="true"] {
            color: #fff;
            background: rgb(0 0 0 / 0.5);
            border-color: rgb(255 255 255 / 0.5);
        }
    }

    .short__title {
        margin: 0;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    /*
     * Along the bottom edge, thin until hovered or focused, when it thickens
     * and the thumb shows, so it is easier to grab. The track is the
     * Slider's own, with a light rest for the picture under it.
     */
    .short__seek {
        --thumb: 0.75rem;
        --track: 0.1875rem;
        --fill: linear-gradient(
            to right,
            var(--tone) var(--progress, 0%),
            rgb(255 255 255 / 0.3) var(--progress, 0%)
        );
        align-self: end;
        inline-size: 100%;
        block-size: var(--thumb);

        &:not(:hover, :focus-visible) {
            &::-webkit-slider-thumb {
                opacity: 0;
            }

            &::-moz-range-thumb {
                opacity: 0;
            }
        }

        &:hover,
        &:focus-visible {
            --track: 0.3125rem;
        }

        &:focus-visible {
            outline-offset: -2px;
        }
    }
}

@keyframes short-flash {
    from {
        opacity: 1;
        scale: 0.8;
    }
    to {
        opacity: 0;
        scale: 1.3;
    }
}
</style>
