---
import { getImage } from "astro:assets";
import type { Tone } from "@cpluspatch/ui/lib/tone.ts";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Button from "../ui/button.astro";
import Slider from "../ui/slider.astro";

/**
 * A <video> player in the style of <AudioPlayer>. Without JS it is the
 * browser's own player; the script swaps in a play toggle, seek bar, time,
 * volume, captions and fullscreen, plus keyboard shortcuts while focus is
 * inside it: K play, J/L back/forward 10s, M mute, C captions, F fullscreen.
 */
interface Props extends HTMLAttributes<"figure"> {
    /** One URL, or several formats in order of preference. */
    src: string | { src: string; type: string }[];
    /** Also sets the aspect ratio, unless `ratio` is given. */
    poster?: ImageMetadata;
    /** As a CSS `aspect-ratio`. Defaults to the poster's, or 16 / 9. */
    ratio?: string;
    /** Shown under the player, and its accessible name. */
    title?: string;
    /** The `default` one (or else the first) is what the CC button toggles. */
    tracks?: {
        src: string;
        srclang: string;
        label: string;
        kind?: "captions" | "subtitles";
        default?: boolean;
    }[];
    loop?: boolean;
    tone?: Tone;
}

const {
    src,
    poster,
    ratio = poster ? `${poster.width} / ${poster.height}` : "16 / 9",
    title,
    tracks = [],
    loop,
    tone = "primary",
    class: className,
    ...rest
} = Astro.props;

const sources = typeof src === "string" ? [{ src, type: undefined }] : src;
const posterImage = poster && (await getImage({ src: poster }));
---

<figure
    class:list={["media-player", "panel", `tone-${tone}`, className]}
    {...rest}
>
    {/* biome-ignore lint/a11y/useMediaCaption: tracks are optional, as not every video has speech */}
    <video
        preload="metadata"
        controls
        playsinline
        loop={loop}
        poster={posterImage?.src}
        aria-label={title}
        style={`--ratio: ${ratio}`}
    >
        {sources.map((source) => <source src={source.src} type={source.type}>)}
        {tracks.map((track) => (
            <track
                kind={track.kind ?? "captions"}
                src={track.src}
                srclang={track.srclang}
                label={track.label}
                default={track.default}
            >
        ))}
    </video>
    {/*
     * Each toggle holds two icons: the first while not pressed, the
     * second while pressed.
     */}
    <div class="media-player__controls" hidden>
        <Button
            class="media-player__toggle"
            size="icon"
            variant="outline"
            tone="neutral"
            lift={false}
            aria-pressed="false"
            aria-label={title ? `Play ${title}` : "Play"}
        >
            <Icon name="lucide:play" aria-hidden="true" />
            <Icon name="lucide:pause" aria-hidden="true" />
        </Button>
        <Slider
            class="media-player__seek"
            min="0"
            max="0"
            step="any"
            value="0"
            aria-label="Seek"
        />
        <span class="media-player__time">0:00 / 0:00</span>
        <Button
            class="media-player__mute"
            size="icon"
            variant="ghost"
            tone="neutral"
            lift={false}
            aria-pressed="false"
            aria-label="Mute"
        >
            <Icon name="lucide:volume-2" aria-hidden="true" />
            <Icon name="lucide:volume-x" aria-hidden="true" />
        </Button>
        <Slider
            class="media-player__volume"
            min="0"
            max="1"
            step="any"
            value="1"
            aria-label="Volume"
        />
        {tracks.length > 0 && (
            <Button
                class="media-player__captions"
                size="icon"
                variant="ghost"
                tone="neutral"
                lift={false}
                aria-pressed="false"
                aria-label="Captions"
            >
                <Icon name="lucide:captions-off" aria-hidden="true" />
                <Icon name="lucide:captions" aria-hidden="true" />
            </Button>
        )}
        <Button
            class="media-player__fullscreen"
            size="icon"
            variant="ghost"
            tone="neutral"
            lift={false}
            aria-pressed="false"
            aria-label="Fullscreen"
        >
            <Icon name="lucide:maximize" aria-hidden="true" />
            <Icon name="lucide:minimize" aria-hidden="true" />
        </Button>
    </div>
    {title && <figcaption class="text-body-sm">{title}</figcaption>}
</figure>

<script>
import { initMediaPlayers } from "@cpluspatch/ui/behaviours/media-player.ts";

initMediaPlayers();
</script>
