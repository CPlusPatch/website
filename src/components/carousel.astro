---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import Button from "./button.astro";

/**
 * Carousel shape:
 *
 *     [       ]
 *   < [       ] >
 *     [       ]
 *     [ ][ ][ ]
 *
 * A scroll-snapping track of arbitrary content, with optional arrows and an
 * optional preview row below it.
 *
 * Slots:
 *   default    -- one <CarouselItem> per slide
 *   previews   -- one <CarouselPreview> per slide, in the same order
 *
 * Slide/preview pairing is positional and wired up at runtime, so the two
 * slots must contain the same number of children.
 */
interface Props extends HTMLAttributes<"div"> {
    /** Names the region for screen readers. */
    label: string;
    buttons?: boolean;
}

const { label, buttons = true, class: className, ...rest } = Astro.props;
---

<section
    class:list={["carousel", buttons && "carousel--buttons", className]}
    aria-roledescription="carousel"
    aria-label={label}
    {...rest}
>
    {buttons && (
        <>
            <Button
                class="carousel__button carousel__button--left"
                size="icon"
                variant="outline"
                lift={false}
                data-carousel-prev
                aria-label="Previous slide"
            >
                <Icon name="lucide:chevron-left" aria-hidden="true" />
            </Button>
            <Button
                class="carousel__button carousel__button--right"
                size="icon"
                variant="outline"
                lift={false}
                data-carousel-next
                aria-label="Next slide"
            >
                <Icon name="lucide:chevron-right" aria-hidden="true" />
            </Button>
        </>
    )}
    {/*
     * A named group gives the track a role, so a screen reader can announce it
     * without it becoming a second region nested in the carousel.
     */}
    {/* biome-ignore lint/a11y/useSemanticElements: a second <section> would announce as a second region inside the carousel */}
    <div
        class="carousel__items"
        role="group"
        data-carousel-track
        aria-label={`${label} slides`}
    >
        <slot />
    </div>
    <div class="carousel__preview-grid" data-carousel-previews>
        <slot name="previews" />
    </div>
</section>

<script>
const carousels = document.querySelectorAll<HTMLElement>(
    "[aria-roledescription='carousel']",
);

for (const root of carousels) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    if (!track) continue;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length === 0) continue;

    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const previews = Array.from(
        root.querySelector("[data-carousel-previews]")?.children ?? [],
    ) as HTMLElement[];

    slides.forEach((slide, i) => {
        slide.setAttribute("role", "group");
        slide.setAttribute("aria-roledescription", "slide");
        slide.setAttribute("aria-label", `${i + 1} of ${slides.length}`);
    });

    // Makes the track keyboard-scrollable (WCAG 2.1.1). Set here rather than
    // in the markup: modern browsers already focus overflow containers, and
    // without this script there are no arrows or previews for it to drive.
    track.tabIndex = 0;

    let current = 0;

    const goTo = (index: number) => {
        const target = slides[Math.max(0, Math.min(index, slides.length - 1))];
        track.scrollTo({
            left: target.offsetLeft - track.offsetLeft,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
                .matches
                ? "auto"
                : "smooth",
        });
    };

    const sync = () => {
        // aria-disabled, not disabled: a disabled button drops focus to <body>
        // the moment the user reaches either end.
        prev?.setAttribute("aria-disabled", String(current === 0));
        next?.setAttribute(
            "aria-disabled",
            String(current === slides.length - 1),
        );
        // Slides that are off-screen must not be reachable by keyboard.
        slides.forEach((slide, i) => {
            slide.inert = i !== current;
        });
        previews.forEach((p, i) => {
            p.setAttribute("aria-current", String(i === current));
            p.classList.toggle("is-current", i === current);
        });
    };

    prev?.addEventListener("click", () => goTo(current - 1));
    next?.addEventListener("click", () => goTo(current + 1));

    previews.forEach((preview, i) => {
        preview.setAttribute("aria-label", `Go to slide ${i + 1}`);
        preview.addEventListener("click", () => goTo(i));
    });

    // Derive the active slide from scroll position rather than tracking it
    // on click, so native swipe and keyboard scrolling stay in sync too.
    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const index = slides.indexOf(entry.target as HTMLElement);
                if (index !== -1) current = index;
            }
            sync();
        },
        { root: track, threshold: 0.6 },
    );

    for (const slide of slides) observer.observe(slide);
    sync();
}
</script>

<style>
.carousel {
    --carousel-height: 38rem;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    justify-content: center;
    width: 100%;

    .carousel__items {
        display: flex;
        width: 100%;
        height: var(--carousel-height);
        overflow: auto hidden;
        gap: var(--space-sm);
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .carousel__items::-webkit-scrollbar {
        display: none;
    }

    /*
     * Inset the track when arrows are present so they do not sit on top of
     * slide content.
     */
    &.carousel--buttons .carousel__items {
        scroll-padding-inline: var(--space-lg);
    }

    .carousel__button {
        position: absolute;
        top: calc(var(--carousel-height) / 2);
        z-index: 1;
        translate: 0 -50%;
        background-color: var(--color-surface);
    }

    .carousel__button--left {
        left: -0.5rem;
    }

    .carousel__button--right {
        right: -0.5rem;
    }

    .carousel__preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: var(--space-sm);
        height: 8rem;
    }

    @container (max-width: 40rem) {
        --carousel-height: 24rem;

        .carousel__preview-grid {
            display: none;
        }
    }
}
</style>
