---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    /** Which side the image sits on. */
    side?: "left" | "right";
    image: {
        url: ImageMetadata;
        /**
         * Omit only for purely decorative imagery -- it renders alt="", which
         * tells a screen reader to skip the image rather than read its
         * filename.
         */
        alt?: string;
    };
}

const { side = "right", image, class: className, ...rest } = Astro.props;
---

<div class:list={["side-hero", `side-hero--${side}`, className]} {...rest}>
    <div class="side-hero__content">
        <slot />
    </div>
    <div class="side-hero__media">
        <Image src={image.url} alt={image.alt ?? ""} />
    </div>
</div>

<style>
.side-hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    gap: var(--space-lg);
    align-items: center;
    width: 100%;

    .side-hero__content {
        padding: var(--space-lg);
        max-width: 30rem;
        justify-self: center;

        p {
            color: var(--color-text);
            font-size: 1.125rem;
            line-height: 1.75rem;
        }
    }

    .side-hero__media {
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Also puts the image first when the columns stack. */
    &.side-hero--left .side-hero__media {
        order: -1;
    }
}
</style>
