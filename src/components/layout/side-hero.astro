---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    /** Which side the image sits on. */
    side?: "left" | "right";
    image: {
        url: ImageMetadata;
        /**
         * Omit only for purely decorative imagery -- it renders alt="", which
         * tells a screen reader to skip the image rather than read its
         * filename.
         */
        alt?: string;
    };
}

const { side = "right", image, ...rest } = Astro.props;
---

<div class:list={["side-hero", rest.class]} {...rest}>
    {side === "right" && (
        <div class="side-hero__content">
            <slot />
        </div>
    )}
    <div class="side-hero__media">
        <Image src={image.url} alt={image.alt ?? ""} />
    </div>
    {side === "left" && (
        <div class="side-hero__content">
            <slot />
        </div>
    )}
</div>

<style>
.side-hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: var(--space-lg);
    align-items: center;
    width: 100%;

    .side-hero__content {
        padding: var(--space-lg);
        max-width: 30rem;
        justify-self: center;

        p {
            color: var(--color-text);
            font-size: 1.125rem;
            line-height: 1.75rem;
        }
    }

    .side-hero__media {
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
}
</style>
