---
import { Icon } from "astro-icon/components";
import Button from "./button.astro";
import Card from "./card.astro";
import Marquee from "./marquee.astro";

/**
 * Logo marquee. Items are distributed round-robin across rows,
 * odd rows scroll in the opposite direction.
 */

interface Item {
    logo: string;
    name: string;
    showName?: boolean;
}

interface Props {
    items: Item[];
    rows?: number;
    duration?: number;
}

const { items, rows = 2, duration = 15 } = Astro.props;

const rowCount = Math.max(1, Math.min(rows, items.length));
const lanes = Array.from({ length: rowCount }, (_, r) =>
    items.filter((_, i) => i % rowCount === r),
);
---

<div class="logos">
    <div class="logos__controls">
        <Button
            size="icon"
            variant="outline"
            tone="neutral"
            lift={false}
            data-logos-pause
            aria-pressed="false"
            aria-label="Pause scrolling"
        >
            <Icon
                name="lucide:pause"
                class="logos__pause-icon"
                aria-hidden="true"
            />
            <Icon
                name="lucide:play"
                class="logos__play-icon"
                aria-hidden="true"
            />
        </Button>
    </div>
    <div class="logo-marquee">
        {lanes.map((lane, r) => (
            <Marquee
                class="logo-marquee__lane"
                controls={false}
                reverse={r % 2 === 1}
                duration={duration}
            >
                {lane.map((item) => (
                    <div>
                        <Card class="logo-marquee__logo">
                            <Icon name={item.logo} aria-hidden="true" />
                            <h3>{item.name}</h3>
                        </Card>
                    </div>
                ))}
            </Marquee>
        ))}
    </div>
</div>

<script>
// One pause control for every lane (WCAG 2.2.2). Marquee honours data-paused.
for (const pause of document.querySelectorAll<HTMLElement>(
    "[data-logos-pause]",
)) {
    const root = pause.closest(".logos");
    pause.addEventListener("click", () => {
        const paused = pause.getAttribute("aria-pressed") !== "true";
        pause.setAttribute("aria-pressed", String(paused));
        for (const lane of root?.querySelectorAll(".marquee") ?? [])
            lane.toggleAttribute("data-paused", paused);
    });
}
</script>

<style>
.logos {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    min-width: 0;

    .logos__controls {
        display: flex;
        justify-content: flex-end;

        :global(.logos__play-icon),
        :global([aria-pressed="true"] .logos__pause-icon) {
            display: none;
        }

        :global([aria-pressed="true"] .logos__play-icon) {
            display: block;
        }
    }

    .logo-marquee {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--space-sm);
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        /* Padding to prevent cutting off card lift */
        padding-block: var(--space-xs);
        contain: inline-size;
        /* Fade out the edges */
        mask-image: linear-gradient(
            to right,
            transparent,
            #000 30%,
            #000 70%,
            transparent
        );

        .logo-marquee__logo {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            justify-content: center;
            gap: var(--space-md);
            width: max-content;
            min-width: 0;
            white-space: nowrap;

            svg {
                height: 2rem;
                width: 2rem;
            }

            h3 {
                font-size: var(--font-size-xl);
                margin: 0;
            }
        }
    }
}
</style>
