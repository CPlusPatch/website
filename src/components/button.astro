---
import type { HTMLAttributes } from "astro/types";

export type ButtonVariant = "solid" | "outline" | "ghost" | "link";

export type ButtonTone =
    | "primary"
    | "secondary"
    | "destructive"
    | "warning"
    | "success"
    | "neutral";

export type ButtonSize = "sm" | "default" | "lg" | "icon";

/**
 * Renders an <a> when `as="a"` or an `href` is given, otherwise a <button>.
 * Choose the element by what the control does (navigate vs. act); `variant`
 * only changes how it looks, so a `link`-variant button is still a <button>.
 */
type Props = Omit<HTMLAttributes<"button">, "type"> &
    Omit<HTMLAttributes<"a">, "type"> & {
        as?: "button" | "a";
        type?: "button" | "submit" | "reset";
        variant?: ButtonVariant;
        tone?: ButtonTone;
        size?: ButtonSize;
        lift?: boolean;
    };

const {
    as,
    type,
    variant = "solid",
    tone = "primary",
    size = "default",
    lift = true,
    ...rest
} = Astro.props;

const isAnchor = as === "a" || (as === undefined && Boolean(rest.href));

const classes = [
    "button",
    lift && variant !== "link" && "lift",
    `button--${variant}`,
    `tone-${tone}`,
    `button--size-${size}`,
    rest.class,
];
---

{isAnchor ? (
    <a class:list={classes} {...rest}>
        <slot />
    </a>
) : (
    <button type={type ?? "button"} class:list={classes} {...rest}>
        <slot />
    </button>
)}

<style>
.button {
    --button-color: var(--tone);
    --button-color-hover: var(--tone-hover);
    --shadow-color: var(--button-color);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--control-height-md);
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
    text-decoration: none;
    color: var(--color-on-accent);
    background-color: var(--button-color);
    border: 1px solid var(--button-color);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
        background-color var(--transition),
        border-color var(--transition),
        color var(--transition),
        box-shadow var(--transition),
        translate var(--transition);

    svg {
        width: 1.2em;
        height: 1.2em;
        margin-bottom: 0.1em;
        flex: none;
    }

    &.button--outline,
    &.button--ghost,
    &.button--link {
        color: var(--button-color);
        background-color: transparent;
    }

    &.button--ghost,
    &.button--link {
        border-color: transparent;
    }

    &.button--size-sm {
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-xs);
        height: var(--control-height-sm);
    }

    &.button--size-lg {
        padding: var(--space-sm) var(--space-md-lg);
        font-size: var(--font-size-base);
        height: var(--control-height-lg);
    }

    &.button--size-icon {
        width: var(--control-height-md);
        height: var(--control-height-md);
        padding: 0;

        svg {
            margin-bottom: 0;
        }
    }

    &:hover {
        background-color: var(--button-color-hover);
        border-color: var(--button-color-hover);
        color: var(--color-on-accent);

        &.button--outline,
        &.button--ghost,
        &.button--link {
            color: var(--color-on-accent);
            border-color: var(--button-color-hover);
        }

        &.button--link {
            color: var(--button-color-hover);
            background-color: transparent;
            border-color: transparent;
            text-decoration: underline;
        }
    }

    &:active:where(:not(:disabled, [aria-disabled="true"])) {
        translate: 0 1px;
    }

    &:disabled,
    &[aria-disabled="true"] {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }
}
</style>
