---
import type { HTMLAttributes } from "astro/types";

export type ButtonVariant = "solid" | "outline" | "ghost" | "link";

export type ButtonTone =
    | "primary"
    | "secondary"
    | "destructive"
    | "warning"
    | "success";

export type ButtonSize = "sm" | "default" | "lg" | "icon";

/**
 * Renders a <button> by default and an <a> when given an href, so the `link`
 * variant can be an actual link instead of a button that looks like one.
 */
type Props = Omit<HTMLAttributes<"button">, "type"> &
    Omit<HTMLAttributes<"a">, "type"> & {
        as?: "button" | "a";
        type?: "button" | "submit" | "reset";
        variant?: ButtonVariant;
        tone?: ButtonTone;
        size?: ButtonSize;
        lift?: boolean;
    };

const {
    as,
    type,
    variant = "solid",
    tone = "primary",
    size = "default",
    lift = true,
    ...rest
} = Astro.props;

const isAnchor = as === "a" || (as === undefined && Boolean(rest.href));

// Astro merges a spread `class` into `class:list` on its own, so `rest.class`
// must not be repeated here or it lands in the output twice.
const classes = [
    "button",
    (lift && variant !== "link") && "lift",
    `button--${variant}`,
    `button--tone-${tone}`,
    `button--size-${size}`,
];
---

{
    isAnchor ? (
        <a class:list={classes} {...rest}>
            <slot />
        </a>
    ) : (
        <button type={type ?? "button"} class:list={classes} {...rest}>
            <slot />
        </button>
    )
}

<style>
.button {
    --button-color: var(--color-primary);
    --button-color-hover: var(--color-primary-hover);
    --shadow-color: var(--button-color);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    color: var(--color-on-accent);
    background-color: var(--button-color);
    border: 1px solid var(--button-color);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
        background-color var(--transition),
        border-color var(--transition),
        color var(--transition),
        box-shadow var(--transition),
        translate var(--transition);

    svg {
        width: 1.2em;
        height: 1.2em;
        margin-bottom: 0.1em;
        flex: none;
    }

    &.button--tone-secondary {
        --button-color: var(--color-secondary);
        --button-color-hover: var(--color-secondary-hover);
    }

    &.button--tone-destructive {
        --button-color: var(--color-destructive);
        --button-color-hover: var(--color-destructive-hover);
    }

    &.button--tone-warning {
        --button-color: var(--color-warning);
        --button-color-hover: var(--color-warning-hover);
    }

    &.button--tone-success {
        --button-color: var(--color-success);
        --button-color-hover: var(--color-success-hover);
    }

    &.button--outline,
    &.button--ghost,
    &.button--link {
        color: var(--button-color);
        background-color: transparent;
    }

    &.button--ghost,
    &.button--link {
        border-color: transparent;
    }

    &.button--size-sm {
        padding: var(--space-xs) var(--space-sm);
        font-size: 0.75rem;
        height: 1.75rem;
    }

    &.button--size-lg {
        padding: var(--space-sm) calc(var(--space-md) + var(--space-sm));
        font-size: var(--font-size-base);
        height: 2.25rem;
    }

    &.button--size-icon {
        width: 2rem;
        height: 2rem;
        padding: 0;

        svg {
            margin-bottom: 0;
        }
    }

    &:hover {
        background-color: var(--button-color-hover);
        border-color: var(--button-color-hover);
        color: var(--color-on-accent);

        &.button--outline,
        &.button--ghost,
        &.button--link {
            color: var(--color-on-accent);
            border-color: var(--button-color-hover);
        }

        &.button--link {
            color: var(--button-color-hover);
            background-color: transparent;
            border-color: transparent;
            text-decoration: underline;
        }
    }

    &:disabled,
    &[aria-disabled="true"] {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }
}
</style>
