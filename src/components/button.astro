---
import type { HTMLAttributes } from "astro/types";

type ButtonVariant =
	| "default"
	| "destructive"
	| "outline"
	| "secondary"
	| "ghost"
	| "link";

type ButtonSize = "default" | "sm" | "lg" | "icon";

interface Props extends HTMLAttributes<"button"> {
	variant?: ButtonVariant;
	size?: ButtonSize;
	shadow?: boolean;
}

const {
	variant = "default",
	size = "default",
	shadow = true,
	...rest
} = Astro.props;
---

<button
	type="button"
	class:list={["button", `button--${variant}`, `button--size-${size}`, shadow && `button--shadow`, rest.class]}
	{...rest}
>
	<slot />
</button>

<style>
.button {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 2rem;
	gap: var(--space-sm);
	padding: var(--space-sm) var(--space-md);
	font-size: 0.8125rem;
	font-weight: 600;
	line-height: 1.25;
	text-decoration: none;
	color: var(--button-color-contrast);
	background-color: var(--button-color);
	border: 1px solid var(--button-color);
	border-radius: var(--radius);
	cursor: pointer;
	transition:
		background-color var(--transition),
		border-color var(--transition),
		color var(--transition),
		box-shadow var(--transition),
		translate var(--transition);

	--button-color: var(--color-primary);
	--button-color-hover: var(--color-primary-hover);
	--button-color-contrast: var(--color-primary-contrast);

	svg {
		width: 1em;
		height: 1em;
	}

	&:has(svg) {
		padding: var(--space-sm) var(--space-sm);
	}

	&.button--size-sm {
		padding: var(--space-xs) var(--space-sm);
		font-size: 0.75rem;
		height: 1.75rem;
	}

	&.button--size-lg {
		padding: var(--space-sm) calc(var(--space-md) + var(--space-sm));
		font-size: 0.9375rem;
		height: 2.25rem;
	}

	&.button--size-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
	}

	&:hover {
		color: var(--button-color-contrast);
		background-color: var(--button-color-hover);
		border-color: var(--button-color-hover);
		
		&.button--shadow {
			box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--button-color);
			translate: calc(var(--shadow-offset) * -1)
				calc(var(--shadow-offset) * -1);
		}
	}

	&.button--destructive {
		--button-color: var(--color-destructive);
		--button-color-hover: var(--color-destructive-hover);
		--button-color-contrast: var(--color-destructive-contrast);
	}

	&.button--outline {
		color: var(--color-primary);
		background-color: transparent;
	}

	&.button--secondary {
		--button-color: var(--color-secondary);
		--button-color-hover: var(--color-secondary-hover);
		--button-color-contrast: var(--color-secondary-contrast);
	}

	&.button--ghost {
		color: var(--color-primary);
		background-color: transparent;
		border-color: transparent;

		&:hover {
			border-color: var(--color-primary);
		}
	}

	&.button--link {
		color: var(--color-primary);
		background-color: transparent;
		border-color: transparent;

		&:hover {
			border-color: var(--color-primary);
			text-decoration: underline;
		}
	}
}
</style>
