---
import type { HTMLAttributes } from "astro/types";

export type CardTone =
    | "primary"
    | "secondary"
    | "destructive"
    | "warning"
    | "success";

interface Props extends HTMLAttributes<"div"> {
    tone?: CardTone;
    /** Lift effect on hover. */
    shadow?: boolean;
}

const { tone = "primary", shadow = true, ...rest } = Astro.props;
---

<div
    class:list={["card", "panel", shadow && "lift", `tone-${tone}`, rest.class]}
    data-snap
    {...rest}
>
    <slot />
</div>

<style>
/*
 * Surface, border, top rule and hover lift all come from .panel / .lift in
 * utilities.css. Tone colours come from .tone-* there too. This file only owns content layout.
 */
.card {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: var(--space-md);
    width: 100%;

    & p {
        color: var(--color-text-muted);
    }

    & a {
        align-self: flex-start;
        font-size: var(--font-size-sm);
    }
}
</style>
