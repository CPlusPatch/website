---
import type { HTMLAttributes } from "astro/types";

export type CardTone =
    | "primary"
    | "secondary"
    | "destructive"
    | "warning"
    | "success";

interface Props extends HTMLAttributes<"div"> {
    tone?: CardTone;
    /** Lift effect on hover. */
    shadow?: boolean;
}

const { tone = "primary", shadow = true, ...rest } = Astro.props;
---

<div
    class:list={["card", "panel", shadow && "lift", `card--tone-${tone}`]}
    {...rest}
>
    <slot />
</div>

<style>
/*
 * Surface, border, top rule and hover lift all come from .panel / .lift in
 * utilities.css. This file only owns content layout and the tone mapping.
 */
.card {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: var(--space-md);

    & p {
        color: var(--color-text-muted);
    }

    & a {
        align-self: flex-start;
        font-size: 0.875rem;
    }

    &.card--tone-secondary {
        --panel-accent: var(--color-secondary-accent);
        --shadow-color: var(--color-secondary-accent);
    }

    &.card--tone-destructive {
        --panel-accent: var(--color-destructive-accent);
        --shadow-color: var(--color-destructive-accent);
    }

    &.card--tone-warning {
        --panel-accent: var(--color-warning-accent);
        --shadow-color: var(--color-warning-accent);
    }

    &.card--tone-success {
        --panel-accent: var(--color-success-accent);
        --shadow-color: var(--color-success-accent);
    }
}
</style>
