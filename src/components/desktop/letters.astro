---
/**
 * The Letters app: what people say about me, then the ways to write back,
 * including the anonymous inbox.
 */

import Masonry from "@cpluspatch/ui/astro/blocks/masonry.astro";
import Quote from "@cpluspatch/ui/astro/blocks/quote.astro";
import { contactNote, inboxNote, reviews, socials } from "../../data/home.ts";
import ContactMethod from "../blocks/contact-method.astro";
import Inbox from "../page/inbox/inbox.astro";
import App from "./app.astro";

// The first is featured across the full width, as on the front page.
const [featured, ...rest] = reviews;
---

<App id="letters" title="Letters" path="~/mail" icon="lucide:mail">
    <h3 class="letters__heading text-subheading">Nice things people said</h3>
    <div class="letters__reviews">
        {featured && (
            <Quote author={featured.author} featured>
                <p>{featured.body}</p>
            </Quote>
        )}
        <Masonry>
            {rest.map((review) => (
                <Quote author={review.author}>
                    <p>{review.body}</p>
                </Quote>
            ))}
        </Masonry>
    </div>

    <h3 class="letters__heading text-subheading">Write to me</h3>
    <p class="letters__blurb">{contactNote}</p>
    <div class="letters__methods">
        {socials.map((social) => <ContactMethod {...social} />)}
    </div>
    <p class="letters__blurb">{inboxNote}</p>
    <Inbox />
</App>

<style>
.letters__heading {
    margin-block: var(--space-lg) var(--space-md);

    &:first-child {
        margin-top: 0;
    }
}

/* A gap, not a margin, which Quote's own margin reset would outrank. */
.letters__reviews {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
}

.letters__blurb {
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
}

.letters__methods {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);

    @container (min-width: 32rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
</style>
