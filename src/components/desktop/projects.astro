---
/**
 * The Projects folder, and a viewer for each project. The folder's tiles
 * link to the viewers, which follow it on the page. Versia leads and has one
 * viewer for itself and its parts, as on the front page.
 *
 * Styles hang off wrappers inside each <App>, not a class passed to it: a
 * class given to a component doesn't carry this file's style scope.
 */

import Icon from "@cpluspatch/ui/astro/icon.astro";
import Button from "@cpluspatch/ui/astro/ui/button.astro";
import { projectId } from "../../data/desktop.ts";
import {
    otherProjects,
    ownLinks,
    versia,
    versiaParts,
} from "../../data/home.ts";
import Shot from "../blocks/shot.astro";
import FlaviArt from "../page/flavi-art.astro";
import App from "./app.astro";

// Drawn rather than captured: Flavi is gone
const art: Record<string, typeof FlaviArt> = { Flavi: FlaviArt };

const tiles = [
    { title: versia.title, src: versia.shots.dark, light: versia.shots.light },
    ...otherProjects.map(({ title, header }) => ({
        title,
        src: header?.src,
        light: header?.light,
    })),
];
---

<App id="projects" title="Projects" path="~/projects" icon="lucide:folder">
    <ul class="folder">
        {tiles.map(({ title, src, light }) => (
            <li>
                <a class="folder__tile" href={`#w-${projectId(title)}`}>
                    {art[title] ? (
                        <Shot>
                            <FlaviArt />
                        </Shot>
                    ) : (
                        <Shot {src} {light} widths={[240, 480]} sizes="12rem" />
                    )}
                    <span class="folder__name">{title}</span>
                </a>
            </li>
        ))}
    </ul>
</App>

<App
    id={projectId(versia.title)}
    title={versia.title}
    path={`~/projects/${projectId(versia.title).slice(2)}`}
    icon="lucide:app-window"
>
    <div class="viewer">
        <Shot
            src={versia.shots.dark}
            light={versia.shots.light}
            alt={versia.shots.alt}
            widths={[320, 640, 960]}
            sizes="(min-width: 48rem) 18rem, 100vw"
        />
        <div class="viewer__text">
            <p class="lead">{versia.body}</p>
            <div class="viewer__links">
                {versia.links.map(({ href, icon, label }) => (
                    <Button {href} variant="outline" size="sm">
                        <Icon name={icon} aria-hidden="true" />
                        {label}
                    </Button>
                ))}
            </div>
        </div>
    </div>
    <ul class="parts">
        {versiaParts.map(({ title, body, links }) => (
            <li class="part">
                <h3 class="part__title">{title}</h3>
                <p class="part__body">{body}</p>
                <div class="part__links">
                    {ownLinks(links).map(({ href, icon, label }) => (
                        <Button {href} size="sm" variant="ghost" tone="neutral">
                            <Icon name={icon} aria-hidden="true" />
                            {label}
                            <span class="visually-hidden">, {title}</span>
                        </Button>
                    ))}
                </div>
            </li>
        ))}
    </ul>
</App>

{otherProjects.map(({ title, body, header, links = [] }) => (
    <App
        id={projectId(title)}
        {title}
        path={`~/projects/${projectId(title).slice(2)}`}
        icon="lucide:app-window"
    >
        <div class="viewer">
            {art[title] ? (
                <Shot>
                    <FlaviArt />
                </Shot>
            ) : (
                header && (
                    <Shot
                        src={header.src}
                        light={header.light}
                        alt={header.alt}
                        widths={[320, 640, 960]}
                        sizes="(min-width: 48rem) 18rem, 100vw"
                    />
                )
            )}
            <div class="viewer__text">
                <p>{body}</p>
                {links.length > 0 && (
                    <div class="viewer__links">
                        {links.map(({ href, icon, label }) => (
                            <Button {href} variant="outline" size="sm">
                                <Icon name={icon} aria-hidden="true" />
                                {label}
                            </Button>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </App>
))}

<style>
/* A file manager's icon view: framed thumbnails, names under them. */
.folder {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    padding: 0;
    list-style: none;

    @container (min-width: 30rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    @container (min-width: 40rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .folder__name {
        font: var(--type-ui);
        text-align: center;
        overflow-wrap: anywhere;
    }

    .folder__tile {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        color: var(--color-text);
        text-decoration: none;
        outline-offset: var(--space-xs);

        :global(.shot) {
            transition:
                border-color var(--transition),
                translate var(--transition);
        }

        /* Not the site's link hover, which fills the link with the accent. */
        &:hover {
            color: var(--color-text);
            background-color: transparent;
        }

        &:hover :global(.shot) {
            border-color: var(--color-primary);
            translate: 0 -2px;
        }

        &:hover .folder__name {
            color: var(--color-primary);
        }

        @media (prefers-reduced-motion: reduce) {
            &:hover :global(.shot) {
                translate: none;
            }
        }
    }
}

/* A shot beside the blurb and links, or over them in a narrow column. */
.viewer {
    display: grid;
    gap: var(--space-md) var(--space-lg);
    align-items: start;

    @container (min-width: 36rem) {
        grid-template-columns: 18rem minmax(0, 1fr);
    }

    .viewer__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        margin-top: var(--space-md);
    }
}

/* Versia's parts, ruled like the front page's: a line above, no box. */
.parts {
    display: grid;
    gap: var(--space-md) var(--space-lg);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;

    @container (min-width: 36rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .part {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        padding-top: var(--space-md);
        border-top: var(--border-width) solid var(--border-color);
    }

    .part__title {
        margin: 0;
        font: var(--type-body-strong);
    }

    .part__body {
        margin: 0;
        color: var(--color-text-muted);
    }

    /* Ghost buttons have no edge: line the first label up with the text */
    .part__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-top: auto;
        padding-top: var(--space-sm);

        > :first-child {
            margin-inline-start: calc(-1 * (var(--space-sm) + 1px));
        }
    }
}
</style>
