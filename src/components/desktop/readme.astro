---
/** The README app: who I am, the rough figures, and a year of commits. */

import Heatmap from "@cpluspatch/ui/astro/blocks/heatmap/heatmap.astro";
import Stat from "@cpluspatch/ui/astro/blocks/stat.astro";
import IconList from "@cpluspatch/ui/astro/ui/icon-list.astro";
import { commits, details, figures, intro } from "../../data/home.ts";
import App from "./app.astro";
---

<App id="readme" title="README" path="~/README.md" icon="lucide:file-text">
    <h1 class="text-poster readme__title">
        Hi,{" "}
        <span class="readme__line">
            I'm <span class="accent">CPlusPatch</span>.
        </span>{" "}
        <span class="readme__line">{intro.headline}</span>
    </h1>
    <p class="lead">
        {intro.lead}{" "}
        The <a href="#w-terminal">Terminal</a> takes commands: try{" "}
        <code>help</code>.
    </p>
    <IconList items={details} />

    {/* Spaced explicitly: the build drops whitespace beside components */}
    <h2 class="page-section__title readme__stats">
        I've been writing software for <Stat inline {...figures.years} />{" "}
        years: <Stat inline {...figures.commits} />{" "}commits so far.
    </h2>

    <div class="readme__commits panel">
        <h2 class="readme__commits-title text-subheading">{commits.title}</h2>
        <Heatmap {...commits.heatmap}>
            <span>Conway's Game of Life, seeded from the graph.</span>
        </Heatmap>
    </div>
</App>

<style>
.readme__title {
    margin-bottom: var(--space-sm);

    /* A line each, so the breaks fall between the greeting and sentences. */
    .readme__line {
        display: block;
    }

    /* On the smallest phones, a little smaller, so each line still fits. */
    @container (max-width: 20rem) {
        font-size: min(
            calc(var(--font-size-6xl) * var(--display-scale)),
            14cqi
        );
    }
}

.readme__stats {
    margin-top: var(--space-lg);

    :global(.stat) {
        font-variant-numeric: tabular-nums;
        color: var(--tone);
    }
}

.readme__commits {
    margin-top: var(--space-md);
    padding: var(--space-lg) var(--space-md) var(--space-md);

    .readme__commits-title {
        margin-bottom: var(--space-md);
    }
}
</style>
